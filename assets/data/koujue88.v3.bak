window.KJ88 = {"updatedAt": "2026-09-18", "chapters": [{"name": "第一章 经济知识", "entries": [{"num": "1.01", "title": "货币政策", "chapter": "第一章 经济知识", "koujue": ["口诀（1）货币政策法宝来，一贴二存三公开"], "defs": ["货币政策指中央银行通过控制货币供给量以及通过调节利率来影响投资和整个经济以达到一定经", "概念济目标的行为再贴现率指商业银行将已从客户处贴现的未到期合格商业票据（如银行承兑汇票）转让给中央银行以获取资金时，中央银行收取的利息率法定存款准备金率指中央银行以法律形式规定的商业银行及其他金融机构必须缴纳的存款准备金", "三大法宝占其存款总额的最低比例公开市场业务指中央银行在金融市场公开买卖有价证券（如国债、政府债券、央行票据等）以调节货币供应量和市场利率的行为扩张性货币政策：经济萧条时采用/通货紧缩时采用；具体措施：降低法定存款准备金率、降低再贴现率，买入有价债券、降低利率", "种类紧缩性货币政策：经济过热期采用/通货膨胀时采用；具体措施：提高法定存款准备金率、提高再贴现率，卖出有价债券、提高利率"], "shizhan": [{"q": "2025年5月7日，中国人民银行宣布，降准0.5个百分点，并降低政策利率0.1个百分点。下列不属于货币政策的“三大法宝”的是：", "options": ["再贴现率", "基准利率", "存款准备金率", "公开市场业务"], "a": 1, "e": "本题考查口诀（1）货币政策法宝来，一贴二存三公开。因此，选择B选项。"}]}, {"num": "1.02", "title": "财政政策", "chapter": "第一章 经济知识", "koujue": ["口诀（2）经济衰退宜扩张，增加需求钱多放；经济过热宜紧缩，市场不宜货币多"], "defs": ["财政政策指政府通过改变财政收入（主要包括税收和公债）和财政支出（主要包括政府购买和转概念移支付）的结构来影响总需求，进而影响国民收入的政策。财政政策被称为社会活动的“内在稳定器”扩张性财政政策：经济衰退期实行/通货紧缩时采用；具体措施：减少税收、增发国债、增加转移支付", "种类紧缩性财政政策：经济过热期采用/通货膨胀时采用；具体措施：增加税收、减发国债、减少转移支付【单选】下列关于财政政策的表述，不正确的是：A.扩张性财政政策适用于经济过热时期B.紧缩性财政政策的具体措施包括增加税收和减发国债C.政府购买和转移支付属于财政支出的范畴D.货币政策通过调整货币供应量影响总需求【解析】扩张性财政政策适用于经济衰退期，而非经济过热时期。本题考查口诀（2）经济过热宜紧缩，市场不宜货币多。因此，选择A选项。"], "shizhan": []}, {"num": "1.03", "title": "三次分配", "chapter": "第一章 经济知识", "koujue": ["口诀（3）初次分配企业定，薪酬利润稳经营；再分转税保民生，三次慈善递温情"], "defs": ["初次分配属于微观分配行为，主要由生产部门自主进行。如企业职工薪酬、最低工资保障、企业利润等属于宏观分配行为，主要由政府对初次分配的结果进行调节。如公务员的工资、个人所得税、", "再分配社会保障、转移支付等第三次分配建立在自愿性的基础上，以慈善公益方式进行"], "shizhan": [{"q": "以下哪项属于第三次分配的具体形式？", "options": ["某企业根据经营状况发放员工年终奖", "政府向低收入家庭发放困难补助金", "个人通过慈善基金会向灾区捐款", "税务部门征收个人所得税"], "a": 2, "e": "本题考查口诀（3）初次分配企业定，薪酬利润稳经营；再分转税保民生，三次慈善递温情。因此，选择C选项。"}, {"q": "【单选】下列关于收入分配的表述，正确的是：", "options": ["初次分配由政府主导，包括职工薪酬和企业利润", "再分配属于微观行为，通过个人所得税调节收入", "第三次分配以慈善公益方式进行，具有自愿性", "公务员的工资属于初次分配范畴"], "a": 2, "e": "A项错误，初次分配由生产部门自主进行，而非政府主导。B项错误，再分配属于宏观分配行为，由政府通过税收、社保等调节，并非“微观行为”。C项正确，第三次分配以自愿性为基础，通过慈善公益方式实施。D项错误，公务员的工资由政府财政支出承担，属于再分配范畴。本题考查口诀（3）初次分配企业定，薪酬利润稳经营；再分转税保民生，三次慈善递温情。因此，选择C选项。"}]}, {"num": "1.04", "title": "汇率", "chapter": "第一章 经济知识", "koujue": ["口诀（4）汇率下降：增加出口，减少进口；汇率上升：增加进口，减少出口"], "defs": ["汇率汇率指两种货币之间兑换的比率，或者说是用一国货币来表示另一国货币的价格本币汇率下降（本币贬值）一→增加出口，减少进口", "汇率变动本币汇率上升（本币升值）一→增加进口，减少出口"], "shizhan": [{"q": "假设某国本币汇率下降（本币贬值），在其他条件不变的情况下，以下哪一项表述正确？", "options": ["该国出口减少，进口增加", "该国出口增加，进口减少", "该国出口和进口均增加", "该国出口和进口均减少"], "a": 1, "e": "汇率下降（本币贬值）意味着用外币兑换本币的成本降低，即本国商品在国际市场上的价格相对下降，从而增强出口竞争力，导致出口增加。同时，本币值使购买外国商品需要支付更多本币，即进口商品价格相对上升，导致国内对进口商品的需求减少，进口减少。本题考查口诀（4）汇率下降：增加出口，减少进口。因此，选择B选项。"}]}, {"num": "1.05", "title": "三驾马车", "chapter": "第一章 经济知识", "koujue": ["口诀（5）拉动经济三马车，投资消费和出口", "口诀（6）国际经济三支柱，银行世贸基金组", "口诀（7）三驾马车金融业，证券银行和保险"], "defs": ["投资：政府通过一系列的财政预算包括发行国债，对教育、科技、国防、卫生等事业的支出，是辅助性的扩大内需拉动国民经济增长消费：即本国居民的消费需求，它是经济的主要动力", "三驾马车出口：指外部需求，即通过本国企业的产品打人国际市场，参与国际竞争，扩大自已的产品销路世界贸易组织（WTO）：1995年成立，总部设在瑞士日内瓦，独立于联合国的永久性国际组织。被誉为“经济联合国”，职责是解决成员间贸易争端国际货币基金组织（IMF）：1945年成立，总部设在美国华盛顿，联合国的专门机构。全球经济治理在金融危机中扮演“救火队”角色，防止全球经济系统性风险扩散三驾马车世界银行（WB）：1945年成立，总部设在美国华盛顿，属于联合国的专门机构。职责是向发展中国家提供长期贷款和技术援助，支持基础设施、教育、医疗等发展项目。世界银行的宗旨是向成员国提供贷款和投资推进国际贸易均衡发展WTO、IMF和WB也被称为世界经济发展的三大支柱银行：在金融体系中具有基础性地位，是资金流动的主要渠道", "金融业证券：证券行业主要包括证券发行、证券交易和证券服务等", "三驾马车保险：提供风险管理和长期资金支持，发挥社会稳定器和资本蓄水池的作用"], "shizhan": [{"q": "【多选】经济学上，把拉动经济（GDP）增长的三大主要因素比喻为“三驾马车”，这“三驾马车”包括：", "options": ["出口", "投资", "信贷", "消费"], "a": "ABD", "e": "本题考查口诀（5）拉动经济三马车，投资消费和出口。因此，选择ABD选项。"}, {"q": "【单选】金融业的“三驾马车”不包括：", "options": ["银行业", "证券业", "保险业", "期货业"], "a": 3, "e": "本题考查口诀（7）三驾马车金融业，证券银行和保险。因此，选择D选项。"}, {"q": "【多选】下列属于全球经济治理三驾马车的是：", "options": ["世界银行", "国际货币基金组织", "世贸组织", "金砖国家开发银行"], "a": "ABC", "e": "本题考查口诀（6）国际经济三支柱，银行世贸基金组。因此，选择ABC选项。"}]}, {"num": "1.06", "title": "恩格尔系数", "chapter": "第一章 经济知识", "koujue": ["口诀（8）食品支出除以总，系数越大就越穷"], "defs": ["恩格尔系数（%）=食品支出总额/家庭或个人消费支出总额×100%，即食品支出总额占个人消费", "概念支出总额的比重恩格尔系数是根据恩格尔定律而得出的比例数，介于0和1之间。比例恩格尔系数与其所反映的家庭或国家的富裕程度成反比，对一个国家而言，一个国家越穷，每个国民的平均支出中用来购买食物的费用所占比例就越大，恩格尔系数也就越高（1）恩格尔系数是一种长期趋势，时间越长趋势越明显，某一年份恩格尔系数波动是正常的；（2）在进行国际比较时应注意可比口径，在中国城市，由于住房、医疗、交通等方面存在大量补", "特征贴，因此进行国际比较时应调整到相同口径；（3）地区间消费习惯不同，恩格尔系数略有不同"], "shizhan": [{"q": "恩格尔系数是食品支出总额占个人消费支出总额的比重。下列关于恩格尔系数的说法正确的是：", "options": ["恩格尔系数介于0和10之间", "恩格尔系数越大，表示该地区越富裕", "下调企业最低工资标准可直接促进恩格尔系数的下降", "恩格尔系数是一种长期趋势，时间越长趋势越明显"], "a": 3, "e": "A项错误，恩格尔系数是根据恩格尔定律而得出的比例数，介于0和1之间。B项错误，恩格尔系数与其所反映的家庭或国家的富裕程度成反比，对一个国家而言，一个国家越穷，每个国民的平均支出中用来购买食物的费用所占比例就越大，恩格尔系数就越大。本题也可以直接用口诀（8）食品支出除以总，系数越大就越穷。排除B项。C项错误，下调企业最低工资标准意味着企业内员工的收入普遍下降，将直接导致恩格尔系数的上升。D项正确，恩格尔系数是一种长期趋势，时间越长趋势越明显，某一年份恩格尔系数波动是正常的。因此，选择D选项。"}]}, {"num": "1.07", "title": "基尼系数", "chapter": "第一章 经济知识", "koujue": ["口诀（9）收人分配看基尼，近0平等失衡1；0.4是警戒线，0.6时风险起"], "defs": ["概念基尼系数是国际上用来综合考查居民内部收入分配差异状况的一个重要分析指标其值在0和1之间。越接近0就表明收人分配越是趋向平等。", "比例按照国际一般标准，0.4以上的基尼系数表示收人差距较大，当基尼系数达到0.6时，则表示收人悬殊"], "shizhan": [{"q": "在经济学中，用来衡量收人分配的不平等程度的是（），其值在0和1之间，值越小，表示收入分配越平等。", "options": ["基尼系数", "恩格尔系数", "消费者信心指数", "生产者物价指标"], "a": 0, "e": "本题考查口诀（9）收入分配看基尼，近0平等失衡1。因此，选择A选项。"}, {"q": "【单选】基尼系数表示在全部居民收人中，用于进行不平均分配的那部分收人占总收入的百分比。社会中每个人的收入都一样、收人分配绝对平均时，基尼系数是：", "options": ["0", "1", "2", "3"], "a": 0, "e": "本题考查口诀（9）收入分配看基尼，近0平等失衡1。因此，选择A选项。"}]}, {"num": "1.08", "title": "国内生产总值", "chapter": "第一章 经济知识", "koujue": ["口诀（10）国内生产GDP，最终产品当年计，二手股转全抛弃"], "defs": ["国内生产总值（GDP）是指在一定时期内（一个季度或一年），一个国家或地区的经济中所生产出的全部最终产品和劳务的价值，常被公认为衡量国家经济状况的最佳指标。GDP不仅可以反映一个国家的经济表现，还可以反映一国的国力与财富。", "举例：GDP①二手车：二手车已计人其生产年度国内生产总值，不是新生产的，因此不能计人当年国内生产总值。②股票：购买股票并不产生新的价值，不计人国内生产总值。③扶贫资金：扶贫资金属于政府转移支付，只是简单地通过税收把收入从一个人或一个组织手中转移到另一个人或另一个组织手中，并没有发生相应的货物或劳务的交换，不计入国内生产总值"], "shizhan": [{"q": "下列选项中应该计人当年国内生产总值的是：", "options": ["某服装公司当年实现年产值5000万元", "李四在二手车市场花费3000元购买一辆二手摩托车", "张三购买价值10万元的某公司股票1000股", "中央财政拨付专项扶贫资金1000亿元"], "a": 0, "e": "服装公司当年的年产值为该公司一年生产的产品的最终价值，应当计入当年国内生产总值。A项当选。本题考查口（10）国内生产GDP，最终产品当年计，二手股转全抛弃。因此，选择A选项。"}]}, {"num": "1.09", "title": "国民生产总值", "chapter": "第一章 经济知识", "koujue": ["口诀（11）国民生产GNP，本国国民来定义，最终产品市场值，产品服务都统计"], "defs": ["国民生产总值（GNP）是一个国民概念，是指某国国民所拥有的全部生产要素在一定时期内所生", "概念产的最终产品的市场价值CNP是指一个国家（或地区）所有国民在一定时期内新生产的产品和服务价值的总和。国民生计算方式产总值不仅计人了物质生产部门的增加值，而且也计入了所有服务部门的增加值，因而反映了现代产业结构的变化，反映了教育、科学技术、金融等第三产业在社会经济中的作用"], "shizhan": [{"q": "【解析】国民生产总值是属人的概念，主体是本国国民而不是外国国民，所以不包括外国居民", "options": ["前者简称为“GNP”", "后者是按照国土原则计算的", "后者更能准确反映一国经济的总体规模", "前者包括外国居民在本国的收人"], "a": 3, "e": "在本国的收入。本题考查口诀（11）国民生产CNP，本国国民来定义。因此，选择D选项。"}]}, {"num": "1.10", "title": "采购经理指数（PMI)", "chapter": "第一章 经济知识", "koujue": ["口诀（12）采购经理PMI，50荣枯分水岭，高于50经济盛，跌破50景气停"], "defs": ["采购经理指数（PMI）是衡量经济景气程度的关键指标，通过调查采购经理的月度数据综PMI的本质合计算得出。通常采购经理人指数与金属需求指标密切相关高于50%：表示经济扩张（如制造业生产、订单等指标向好）", "荣枯分水线低于50%：表示经济收缩（如需求下降、生产放缓）"], "shizhan": [{"q": "PMI指数的中文含义为采购经理指数，其荣枯分水线为（)%。当计算出的指标高于该值时，表示：", "options": ["80经济发展", "50经济发展", "80经济衰退", "50经济衰退"], "a": 1, "e": "本题考查口诀（12）采购经理PMI，50荣枯分水岭，高于50经济盛，跌破50景气停。因此，选择B选项。"}]}, {"num": "1.11", "title": "消费者价格指数（CPI）", "chapter": "第一章 经济知识", "koujue": ["口诀（13）消费指数CPI，通货膨胀衡量计，不列全国全产品，八大类别抽样齐"], "defs": ["消费者物价指数（CPI）是一项反映居民家庭一般所购买的消费品和服务项目价格水平变动情况的宏观经济指标，通常作为观察通货膨胀水平的重要指标。国家统计局公布的CPI数据被人们称概念为反映社会经济生活状况的“晴雨表”。CPI是一个滞后性的数据，它反映的是过去一段时间内消费品及服务价格水平的变动情况，而不是对未来经济活动的预测（1）衡量通货膨胀（通货紧缩）；（2）国民经济核算；基本（3）契约指数化调整；功能（4）反映货币购买力变动；（5）反映对职工实际工资的影响；（6）反映对股市的影响消费者物价指数的计算不要求列出一张涵盖全国全部产品的清单。国家统计局根据全国城乡居民家庭消费支出的抽样调查资料统一确定商品和服务项目的类别，设置包括：食品烟酒、衣着、居计算住、生活用品及服务、交通通信、教育文化娱乐、医疗保健、其他用品及服务八大类268个基本方法分类，基本涵盖了城乡居民的全部消费内容。它的计算方法是取一篮子商品中每一项商品的价格变化，并将其加权平均。CPI上涨说明物价上涨，货币的购买力下降；CPI下跌则说明物价下跌，货币的购买力增强"], "shizhan": [{"q": "【单选】消费者价格指数是市场经济活动与政府货币政策的一个重要参考指标。关于消费者价格指数的计算，下列说法错误的是：", "options": ["要列出一张涵盖全国全部产品的清单", "要形成产品清单中各个项目的权重", "要根据市场调查的价格来计算", "要与一个基期时间的数据做比较"], "a": 0, "e": "本题考查口诀（13）消费指数CPI，通货膨胀衡量计，不列全国全产品，八大类别抽样齐。因此，选择A选项。"}]}, {"num": "1.12", "title": "生产者物价指数（PPI)", "chapter": "第一章 经济知识", "koujue": ["口诀（14）PPI指数要记牢，生产领域价格标。通胀压力全知晓，预测CPI有信号"], "defs": ["生产者物价指数（PPI）是反映某一时期生产领域价格变动情况的重要经济指标，是制定有关经济政策和国民费品价格，是预测CPI的先行指标，反映生产环节的通胀压力"], "shizhan": [{"q": "【单选】衡量通货膨胀率的指标不包括：", "options": ["消费物价指数", "货币GDP", "零售物价指数", "生产者物价指数"], "a": 1, "e": "A项：消费物价指数（CPI）是衡量居民日常消费的商品和服务价格变动的指标，覆盖食品、交通、住房等领域。是最常用的通胀衡量指标之一，直接反映居民生活成本的变化。本题考查口诀（14）PPI指数要记牢，生产领域价格标。通胀压力全知晓，预测CPI有信号。排除A项。B项：货币GDP指的是以当前市场价格计算的GDP，包含实际产量和价格水平的双重变动。无法单独分离出通胀因素。C项：零售物价指数（RPI）反映零售商品价格变动的指数，主要用于衡量消费者购买商品的价格变化，为通胀衡量指标，排除C项。D项：生产者物价指数（PPI）是衡量工业企业产品出厂价格变动的指标，反映生产环节的通胀压力。PPI上涨可能传导至下游消费品价格，是预测CPI的先行指标。本题考查口诀（14）PPI指数要记牢，生产领域价格标。通胀压力全知晓，预测CPI有信号。排除D项。因此，选择B选项。"}]}, {"num": "1.13", "title": "赤字率", "chapter": "第一章 经济知识", "koujue": ["口诀（15）财政风险赤字率，赤字额比GDP。百分之三红线记，60负债率警惕。提高赤字属", "积极，扩支减税刺经济"], "defs": ["赤字率，指财政赤字占GDP的比重，即一定时期内财政赤字额与同期GDP之间的比例关系，是衡量财政风险的一个重要指标。", "赤字率提高财政赤字率属于积极财政政策，意味着政府财政支出大于财政收人，政府通过扩大支出或减少税收等方式来刺激经济增长国际上评价一国财政赤字风险有两个指标：比例（1）赤字率（赤字占CDP比重）不超过3%；（2）负债率（国债余额占GDP比重）不超过60%"], "shizhan": [{"q": "下列术语中，衡量财政风险的一个重要指标是：", "options": ["基尼系数", "GNP", "赤字率", "生产者物价指数"], "a": 2, "e": "本题考查口诀（15）财政风险赤字率，赤字额比GDP。可直接锁定C选项。因此，选择C选项。"}, {"q": "【单选】国际上评价一国财政赤字风险有两个指标，即赤字率和负债率。其中负债率不超过：", "options": ["3%", "30%", "40%", "60%"], "a": 3, "e": "本题考查口诀（15）财政风险赤字率，赤字额比GDP。百分之三红线记，60负债率警惕。可直接锁定D选项。因此，选择D选项。"}, {"q": "【单选】赤字率是衡量财政风险的一个重要指标，是指财政赤字占（)的比重。", "options": ["GNP", "GDP", "PPI", "CPI"], "a": 1, "e": "本题考查口诀（15）财政风险赤字率，赤字额比CDP。可直接锁定B选项。因此，选择B选项。"}]}, {"num": "1.14", "title": "货币职能", "chapter": "第一章 经济知识", "koujue": ["口诀（16）货币职能记清楚，谐音甲流是只猪；价值尺度标价目，流通一手交钱物；世界货币", "跨疆土，支付延后不同步；贮藏保值金银库，五大职能全兼顾"], "defs": ["货币职能是指货币在经济活动中所起的作用，它是货币本质的具体体现。概念货币职能包括价值尺度、支付手段、流通手段、贮藏手段、世界货币口决：价流世支贮（谐音记忆：甲流是只猪）价值尺度：价值标签。价值尺度是货币用来衡量和表现商品价值大小的职能，货币通过自身价值作为尺度来量化商品的价值量，比如一件商品标价多少支付手段：支付手段是货币在清偿债务、支付工资、租金、赋税等过程中发挥的职能。其特点是货币的支付与商品交换在时间上相分离，即交钱与交货时间不同五大流通手段：流通手段强调货币在商品交换过程中充当媒介，其核心在于“一手交钱，一手交货”式的职能商品买卖场景。在商品流通中，货币不断地从买者手中转移到卖者手中，实现商品的交换贮藏手段：贮藏手段要求货币退出流通领域，被人们当作财富储存起来，通常是为了保存财富以备未来之需，并且一般要求货币是足值的，如金银等世界货币：在世界上能通用的货币货币基本职能是价值尺度和流通手段"], "shizhan": [{"q": "小李用刚刚发的工资支付了下月的房租，这体现了货币的（)职能。", "options": ["流通手段", "价值尺度", "贮藏手段", "支付手段"], "a": 3, "e": "小李用工资支付下月房租，工资是其劳动所得，房租是其需要支付的费用，货币在这个过程中充当了支付手段，完成了价值的转移。本题考查口诀（16）世界货币跨疆土，支付延后不同步。因此，选择D选项。"}, {"q": "【单选】超市里某袋高档大米的价格标签上写着198元，此处“198元”执行的是货币的哪一职能？", "options": ["流通手段", "贮藏手段", "支付手段", "价值尺度"], "a": 3, "e": "高档大米价格标签上的198元，就是用货币单位将大米的价值直观地表现出来，体现了货币的价值尺度职能。本题考查口（16）价值尺度标价目，流通一手交钱物。因此，选择D选项。"}, {"q": "【单选】小明在书店用100元买了一本图书，这体现了货币的哪一基本职能？", "options": ["价值尺度", "贮藏手段", "支付手段", "流通手段"], "a": 3, "e": "流通手段是货币充当商品交换媒介的职能。小明在书店用100元买了一本图书，此时货币作为交换媒介，实现了商品的流通，体现了货币的流通手段职能。本题考查口诀（16）价值尺度标价目，流通一手交钱物。因此，选择D选项。"}]}, {"num": "1.15", "title": "市场经济", "chapter": "第一章 经济知识", "koujue": ["口诀（17）自发性损人利已，盲目性跟风扎堆，滞后性亡羊补牢", "口诀（18）风险供求竞争在，价格核心最厉害"], "defs": ["市场配置是指通过市场机制进行资源配置的方式。市场配置是一种事后调节，是用“看不见的手”来调节的市场市场配置的缺陷：配置（1）自发性：逐利、使用不正当竞争手段。例如：假冒伪劣、欺诈、环境污染、以次充好，假奶粉、排污偷排。（2）盲目性：掌握信息不全、盲目跟风生产。例如：果农盲目扩种致烂市。（3）滞后性：事后调节、商品生产调整滞后。例如：手机滞销后才减产风险机制", "市场供求机制", "机制竞争机制价格机制（核心）"], "shizhan": []}, {"num": "1.16", "title": "两只手", "chapter": "第一章 经济知识", "koujue": ["口诀（19）斯密巨著国富论，看不见的市场稳；凯恩看得见通论，宏观调控干预神"], "defs": ["市场经济体制看不见亚当·斯密在《国富论》提出“看不见的手”理论，认为每个人在追求自身利益时，都会“被一只的手看不见的手引导着去达到并非出于其本意的目的”的论断，他反对重商主义，支持自由经济政策。亚当·斯密被认为是现代经济学之父政府宏观调控", "看得见的手《就业、利息和货币通论》是英国经济学家凯恩斯创作的经济学著作，该书是现代政府干预经济政策的理论基础，是现代西方经济崛起的原动力，标志着现代西方宏观经济学的产生"], "shizhan": [{"q": "“看不见的手”出自英国经济学家亚当·斯密的《国富论》，指的是（的作用。", "options": ["舆论监督", "市场机制", "政府调控", "消费者心理变化"], "a": 1, "e": "本题考查口诀（19）斯密巨著国富论，看不见的市场稳。因此，选择B选项。"}]}, {"num": "1.17", "title": "宏观调控", "chapter": "第一章 经济知识", "koujue": ["口诀（20）增长就业物价定，国际收支保平衡；三个手段来调控，经济法律和行政"], "defs": ["（1）促进经济增长（最重要的目标）；我国宏观调控的（2）增加就业；目标（3）稳定物价；（4）保持国际收支平衡（1）经济手段国家在尊重市场规律的基础上借助经济杠杆的调节作用，对国民经济进行宏观调控。财政政策和货币政策是宏观调控中最常用的经济手段。我国宏观经济调控以经济手段和法律手段为主，其中经济手段是我国宏观调控的基石和最主要手段。我国宏观调控的（2）行政手段手段国家依靠行政机构，采取强制性的命令、指示、规定等行政方式来调节经济活动，以达到宏观调控目标的一种手段。行政手段具有权威性、纵向性、无偿性和速效性等特点。（3）法律手段国家依靠法制力量，通过经济立法、经济司法和经济仲裁，运用经济法规来调节经济关系和经济活动，以达到宏观调控目标的一种手段"], "shizhan": [{"q": "【解析】我国宏观调控的目标包括：①促进经济增长（最重要的目标）；②增加就业；③稳定物", "options": ["促进经济增长", "实现贸易顺差", "增加就业", "保持国际收支平衡"], "a": 1, "e": "价；④保持国际收支平衡。B项正确。本题考查口诀（20）增长就业物价定，国际收支保平衡。因此，选择B选项。"}]}, {"num": "1.18", "title": "按劳分配", "chapter": "第一章 经济知识", "koujue": ["口诀（21）国有企业按劳分，私企外企要素分"], "defs": ["项目存在方式特点按劳分配是初级阶段的分配主体，但不是社会唯一的分配原则等量劳动领取等量消费品原则，还不可能在全社会的公有制经济范围内按统一只存在于标准实现", "按劳分配公有制企业按劳分配还不能以每个劳动者的劳动时间为尺度，只能以商品交换实现的价值量所间接反映的劳动量为尺度按劳分配必须借助于商品货币形式来实现按生产存在于私营企业劳动、资本、技术、管理要素分配或外资企业"], "shizhan": [{"q": "【多选】老刘承包村里的土地种果树，年收人3万，他在家炒股也有些收入。老刘的妻子开了一个美容店，月收人4000元。老刘的儿子在一家私营企业上班，月收人4000元。下列对老刘一家收入的认识正确的是：", "options": ["私营企业上班的收人属于按劳动要素分配所得", "承包土地的收入属于按生产要素分配所得", "炒股的收人属于按知识要素分配所得", "开美容店的收入属于按个体劳动者劳动成果分配所得"], "a": "AD", "e": "A项正确，私营企业属于非公有制经济，其职工的工资收入是劳动者通过出卖劳动力（劳动要素）获得的报酬，属于按生产要素分配中的劳动要素分配。B项错误，老刘承包村里的土地属于农村集体经济（公有制范畴），种果树的收入是基于土地承包经营权的劳动所得，属于按劳分配，而非按生产要素分配。C项错误，炒股收入（如股息、红利）是凭借资本投入获得的收益，属于按生产要素分配中的资本要素分配，而非“知识要素”。知识要素分配通常指技术、管理、专利等智力成果参与分配的形式。D项正确，老刘妻子的美容店属于个体经济，其收入来自个人劳动和经营，扣除成本后归个体劳动者所有，属于按个体劳动者劳动成果分配。本题考查口诀（21）国有企业按劳分，私企外企要素分。因此，选择AD选项。"}]}, {"num": "1.19", "title": "通货膨胀", "chapter": "第一章 经济知识", "koujue": ["口诀（22）通胀物价涨，贬值利出口；紧缩物价跌，升值利进口"], "defs": ["通货膨胀通货紧缩实质社会总需求大于社会总供给，供不应求社会总需求小于社会总供给，供大于求原因纸币的发行量超过流通中实际需要的货币量纸币的发行量少于流通中实际需要的货币量危害物价上涨、货币贬值物价下跌、货币升值对策控制货币供应量与信贷规模扩大内需、刺激消费【判断】通货膨胀是指物价普遍持续下跌的经济现象。（【解析】题干提到的“物价普遍持续下跌”是通货紧缩的特征，通货紧缩时货币购买力上升，但企业利润缩水，可能引发经济衰退。本题考查口诀（22）通胀物价涨，贬值利出口。紧缩物价跌，升值利进口。因此，本题错误。"], "shizhan": []}, {"num": "1.20", "title": "欧盟", "chapter": "第一章 经济知识", "koujue": ["口诀（23）欧盟源自欧共体，创始6国要牢记，比荷卢森法德意，总部布鲁在比利，官方语言", "二十四，三会两院来助力"], "defs": ["欧洲联盟，简称欧盟（EU），总部设在比利时首都布鲁塞尔，是由欧洲共同体发展而来的，欧洲联盟是欧洲地区规模较大的区域性经济合作的国际组织，创始成员国有6个，分别为法国、德国、意大", "简介利、荷兰、比利时和卢森堡。正式官方语言有24种。2020年1月30日，欧盟正式批准了英国脱欧。英国结束了其47年的欧盟成员国身份（1）理事会：包括欧盟理事会和欧洲理事会。欧盟理事会又称部长理事会，欧盟立法与政策制定、协调机构。欧洲理事会，又称欧盟首脑会议或欧盟峰会，是欧盟最高决策机构。组织（2）欧盟委员会：简称欧委会，欧盟立法建议与执行机构。架构（3）欧洲议会：欧盟监督、咨询和立法机构。（4）欧洲法院：欧盟的仲裁机构。负责审理和裁决在执行欧共体条约和有关规定中发生的各种争执。（5）审计院：负责审计欧盟及其各机构的账目，审查欧盟收支状况，并确保对欧盟财政进行正常管理"], "shizhan": [{"q": "【多选】下列关于欧洲联盟的表述中，正确的是：", "options": ["由欧洲共同体发展而来", "它是一个经济合作组织", "最初由五个国家组成", "它是一个政治军事组织"], "a": "AB", "e": "本题考查口（23）欧盟源自欧共体，创始6国要牢记。因此，选择AB选项。"}]}, {"num": "1.21", "title": "世界贸易组织", "chapter": "第一章 经济知识", "koujue": ["口诀（24）世贸经济联合国，总部瑞士日内瓦，官方语言西英法，部长会议掌天下"], "defs": ["世界贸易组织，简称世贸组织（WTO），是一个独立于联合国的永久性国际组织。WTO是20世纪90年代，在关贸总协定的基础上成立了法律地位更加明确的国际组织。总部设在瑞士日内瓦莱蒙湖畔，WTO成员之间的贸易额占世界的绝大多数，有“经济联合国”之称。简介官方语言为英文、法文和西班牙文，这三种语言的文本为正式文本，具有法律效力，中文译本仅供参考，不具有法律效力。WTO是全球贸易机制中影响最大最广泛最具权威性的国际经济组织。WTO的目标是建立一个完整的、更具有活力的和永久性的多边贸易体制1995年1月1日，世界贸易组织正式成立，与关贸总协定共存一年至1995年12月31日。", "发展2001年12月11日，中华人民共和国经过15年的谈判正式加入，这是关贸总协定/世贸历史上谈判时历程间最长的一次（1）互惠原则。（2）透明度原则。基本（3）市场准人原则。原则(4）促进公平竞争原则。（5）经济发展原则。(6)非歧视性原则（1）部长级会议：世贸组织的最高决策权力机构。组织（2）总理事会：由世界贸易组织所有成员方的代表组成，定期召开会议。总理事会还必须履行其解决贸易争端和审议各成员贸易政策的职责。架构（3）专门委员会：部长会议下设立专门委员会，以处理特定的贸易及其他有关事宜。（4）秘书处与总干事（1）管理职能。（2）组织职能。职能（3）协调职能。（4）调节职能。（5）提供职能"], "shizhan": [{"q": "（)的职能是调解纷争，它是当代最重要的国际经济组织之一，被称为“经济联合国”。", "options": ["国际货币基金组织", "世界贸易组织", "亚太经合组织", "世界银行"], "a": 1, "e": "本题考查口诀（24）世贸经济联合国，总部瑞士日内瓦，官方语言西英法，部长会议掌天下。因此，选择B选项。机构是："}]}, {"num": "1.22", "title": "国际货币基金组织", "chapter": "第一章 经济知识", "koujue": ["口诀（25）特别提款基金创，称纸黄金来记账。5种货币篮中放，人美欧日和英镑"], "defs": ["国际货币基金组织（IMF）是根据1944年7月在布雷顿森林会议签订的《国际货币基金协定》，于1945年12月27日成立，总部在美国华盛顿。", "简介IMF是联合国的专门机构。IMF与世界银行同时成立，并列为世界两大金融机构。监察货币汇率和各国贸易情况，提供技术和资金协助，确保全球金融制度运作正常（1）制定成员国间的汇率政策和经常项目的支付以及货币兑换性方面的规则，并进行监督；（2）对发生国际收支困难的成员国在必要时提供紧急资金融通，避免其他国家受其影响；（3）为成员国提供有关国际货币合作与协商等会议场所；职能（4）促进国际间的金融与货币领域的合作；（5）促进国际经济一体化的步伐；（6）维护国际间的汇率秩序；（7）协助成员国之间建立经常性多边支付体系等特别提款权（SDR）是国际货币基金组织创设的一种储备资产和记账单位，用于会员国和基金组织国，以及会员国之间的支付，称“纸黄金”。它是基金组织分配给会员国的一种使用资金的权利。会员国在发生国际收支逆差时，可用它向基金特别组织指定的其他会员国换取外汇，以偿付国际收支逆差或偿还基金组织的贷款，还可与黄金、自由提款权兑换货币一样充当国际储备。但由于其只是一种记账单位，不是真正货币，所以使用时必须先换成其他货币，不能直接用于贸易或非贸易的支付。因为它是国际货币基金组织原有的普通提款权以外的一种补充，所以称为特别提款权（SDR）。特别提款权不是一种有形的货币，它看不见摸不着，只是一种账面资产。人民币纳人国际货币基金组织特别提款权货币篮子，成为继美元、欧元、英镑、日元之后的第五个成员"], "shizhan": [{"q": "特别提款权被称为“纸黄金”，是（）建立的一种储备资产和记账单位，作为补充会员国原油普通提款权以外的一种使用资金的特别权利。", "options": ["亚投行", "世界银行", "世界贸易组织", "国际货市基金组织"], "a": 3, "e": "本题考查口诀（25）特别提款基金创，称纸黄金来记账。5种货币篮中放，人美欧日和英镑。因此，选择D选项。"}, {"q": "【单选】2015年11月30日，人民币“入篮”加人国际货币基金组织（IMF）特别提款权（SDR）货币篮子，成为SDR篮子中的第五种货币，对中国经济融人全球金融体系具有重大而深远的意义。SDR篮子的另外四种货币是：", "options": ["美元、欧元、英镑、日元", "美元、欧元、英镑、马克", "美元、欧元、英镑、法郎", "美元、英镑、法郎、日元"], "a": 0, "e": "本题考查口诀（25）特别提款基金创，称纸黄金来记账。5种货币篮中放，人美欧日和英。因此，选择A选项。"}, {"q": "【单选】以下没有纳入SDR（特别提款权）货币篮子的货币是：", "options": ["美元", "加币", "人民币", "日元"], "a": 1, "e": "本题考查口诀（25）特别提款基金创，称纸黄金来记账。5种货币篮中放，人美欧日和英。因此，选择B选项。"}]}, {"num": "1.23", "title": "亚洲基础设施投资银行", "chapter": "第一章 经济知识", "koujue": ["口诀（26）基础设施亚投行，英国第一个加人，中国首都是总部"], "defs": ["亚投行（AIIB）是一个政府间性质的亚洲区域多边开发机构，其成立宗旨是促进亚洲区域的建设互联互通化和经济一体化的过程，并且加强中国及其他亚洲国家和地区的合作。亚投行重点亚投行支持基础设施建设。亚投行是首个由中国倡议设立的多边金融机构，总部设在北京。2015年3月12日英国是第一个申请加人亚投行的西方国家"], "shizhan": [{"q": "亚投行（AIIB）是一个政府间性质的亚洲区域多边开发机构，其成立宗旨是促进亚洲区域的建设互联互通化和经济一体化的过程，并且加强中国及其他亚洲国家和地区的合作。亚投行重点支持（)建设。", "options": ["自由贸易区", "基础设施", "工业化", "军事设施"], "a": 1, "e": "本题考查口诀（26）基础设施亚投行，英国第一个加入，中国首都是总部。因此，选择B选项。"}, {"q": "【多选】下列关于亚投行的说法，正确的是：", "options": ["英国是加人亚投行的第一个主要西方国家", "亚投行是一个政府间性质的亚洲区域多边开发机构", "亚投行致力为亚洲基础设施建设提供融资支持", "亚投行是由我国提出倡议筹建的，总部设在上海"], "a": "ABC", "e": "本题可以直接用口诀（26）基础设施亚投行，英国第一个加入，中国首都是总部。秒选ABC选项。因此，选择ABC选项。"}]}, {"num": "1.24", "title": "上海合作组织", "chapter": "第一章 经济知识", "koujue": ["口诀（27）上合组织SCO，二OO一六月筹。政府组织且永久，中国城市名首留。组织前身有", "五国，中俄哈吉塔牵头"], "defs": ["上海合作组织（SCO），简称上合组织。成立于2001年6月15日。是一个永久性政府间国际组织，概述是第一个以中国城市命名的国际组织。上合组织的前身是中国、俄罗斯、哈萨克斯坦、吉尔吉斯斯坦和塔吉克斯坦的“上海五国”机制2025年5月19日至20日，2025年上海合作组织减贫和可持续发展论坛在陕西举行。本次论坛当日在陕西西安开幕，主题为“持续减贫，合作发展一一推动上合组织国家减贫和可持续发展”。2025年5月20日，国家主席习近平向2025年上海合作组织减贫和可持续发展论坛致贺信。习近平指出，消除贫困是全球性难题，也是世界各国共同目标。中国经过艰苦务力，成功打赢脱贫攻坚战，提前10年实现", "论坛联合国2030年可持续发展议程减贫目标，走出一条中国特色减贫道路，谱写了人类反贫困历史新篇章。习近平强调，减贫问题说到底是发展问题。中方作为上海合作组织轮值主席国，愿同各方持续加强政策沟通，分享减贫经验，深化务实合作，帮助更多国家探索符合自身国情的减贫和可持续发展道路，携手建设远离贫困、共同繁荣的美好世界"], "shizhan": []}]}, {"name": "第二章 地理知识", "entries": [{"num": "2.01", "title": "陆上邻国", "chapter": "第二章 地理知识", "koujue": ["口诀（28）月娥姑娘真腩購，蒙着布单披三毯，度过尼泊去朝鲜，巴基巴基一身汗"], "defs": ["陆上邻国越南、俄罗斯、缅甸、蒙古、不丹、哈萨克斯坦、吉尔吉斯斯坦、塔吉克斯坦、印度、老挝、(14个)尼泊尔、朝鲜、巴基斯坦、阿富汗"], "shizhan": [{"q": "我国幅员辽阔、邻国众多。下列东南亚的国家中，都与我国陆上相邻的一组是：", "options": ["缅甸、泰国、越南", "越南、老挝、東埔寨", "越南、老挝、缅甸", "马来西亚、新加坡、泰国"], "a": 2, "e": "本题可以用口诀（28）月娥姑娘真陋，蒙着布单披三毯，度过尼泊去朝鲜，巴基巴基一身汗来解答。因此，选择C选项。"}]}, {"num": "2.02", "title": "海上邻国", "chapter": "第二章 地理知识", "koujue": ["口诀（29）韩日文马菲印尼，隔海相望不分离"], "defs": ["海上邻国韩国、日本、文莱、马来西亚、菲律宾、印度尼西亚(6个)"], "shizhan": [{"q": "下列国家中，不属于我国的海上邻国的是：", "options": ["文莱", "韩国", "老挝", "菲律宾"], "a": 2, "e": "本题可以用口诀（29）韩日文马菲印尼，隔海相望不分离来解答。因此，选择C选项。"}]}, {"num": "2.03", "title": "著名地貌", "chapter": "第二章 地理知识", "koujue": ["口诀（30）西北风蚀西南喀，风蚀土墩喀岩溶，冰川冰雪丹霞红"], "defs": ["喀斯特地貌，又叫岩溶地貌，是具有溶蚀力的水对可溶性岩石（大多为石灰岩）进行溶蚀作用等所形成的地表和地下形态的总称。喀斯特地貌我国喀斯特地貌分布区域较广，在我国主要分布在西南地区（广西、云南、贵州、西藏东南部等地区）。贵州荔波、重庆武隆、四川九寨沟、贵州黄果树瀑布、桂林山水、云南石林、湖南黄龙洞等都是著名的喀斯特景观1939年，构造地质学家把红色岩层上发育的地貌称为丹霞地形。一般认为，有陡崖的陆相红层地貌为丹霞地貌。丹霞地貌2010年，“中国丹霞”人选世界自然遗产。典型的丹霞地貌分布在福建武夷山、浙江江郎山、江西龙虎山、广东丹霞山、云南老君山、湖南山、甘肃张校、贵州赤水、美国科罗拉多大峡谷等地雅丹地貌，是一种典型的风蚀性地貌（回旋形土墩），有些地貌外观如同古城堡，俗称雅丹地貌“魔鬼城”。典型的风蚀地貌（回旋形土墩）：新疆罗布泊地区、青海柴达木盆地的魔鬼城冰川地貌由冰川作用塑造的地貌，属于气候地貌范畴"], "shizhan": []}, {"num": "2.04", "title": "河流湖泊", "chapter": "第二章 地理知识", "koujue": ["口诀（31）巴颜喀拉山的黄河穿越九省进渤海湾，重要水电站小浪底还有青铜和龙羊。", "长江它来自唐古拉中国第一大第一长，流经十一省三峡葛洲坝人东海太平洋"], "defs": ["黄河发源于青藏高原巴颜喀拉山，流经9个省（自治区），青海、四川、甘肃、宁夏、内蒙古、山西、陕西、河南及山东。渭河是黄河最长、最大的支流。黄河呈“几”字形，是世界河流黄河上含沙量最多的河流。在冬春季节，可能有凌汛现象出现，被称为“母亲河”“中华民族的摇篮”，于山东东营流人渤海。小浪底水利枢纽是治理开发黄河的关键性工程；龙羊峡、青铜峡是黄河上比较重要的水电站长江发源于青藏高原唐古拉山脉（唐古拉山脉被誉为“青藏分水岭”），长江是中国第一大河、第一长河，是世界第三大河，仅次于非洲的尼罗河与南美洲的亚马孙河，水量也是世界第三。汉江是长江最长的支流，嘉陵江是长江流域面积最大的支流，岷江是长江径流量最大河流长江的支流。长江是我国水量最大的河流，地跨三级阶梯，水能资源丰富，有“黄金水道”之称。葛洲坝水电站是长江上第一座大型水电站。长江流经11个省（市、自治区），青海（青）一四川（川）一西藏（藏）一云南（滇）一（）一（）一（）一（）一（）一（）重（沪），于上海崇明岛注人东海淡水湖江西的鄱阳湖（最大）、湖南洞庭湖、江苏太湖和洪泽湖、安徽巢湖", "湖泊咸水湖青海湖（最大）、西藏纳木错（最高）、新疆艾丁湖（最低）"], "shizhan": [{"q": "黄河，中国古代称大河，发源于中国青海省巴颜喀拉山脉，流经（）", "options": ["7", "9", "8", "10"], "a": 1, "e": "本题可以用口诀（31）巴颜喀拉山的黄河穿越九省进渤海湾来解答。因此，选择B选项。"}]}, {"num": "2.05", "title": "地势地形", "chapter": "第二章 地理知识", "koujue": ["口诀（32）上昆仑祁连和横断看看，一二级的阶梯就全学完。有大太巫雪二三分开，还有秦岭", "淮河南稻北麦"], "defs": ["第一阶梯盆地：柴达木盆地", "高原：青藏高原高原：内蒙古高原、黄土高原、云贵高原第二阶梯盆地：准噶尔盆地、四川盆地、塔里木盆地地势第三阶梯平原：东北平原、华北平原、长江中下游平原丘陵：辽东丘陵、山东丘陵、东南丘陵我国地势第一、二级阶梯分界线：昆仑山一祁连山一横断山我国地势第二、三级阶梯分界线：大兴安岭一太行山一巫山一雪峰山秦岭一淮河一线以南主要为水稻种植区，以北为小麦种植区青藏高原：世界上海拔最高的高原，被称为“世界屋脊”“世界第三极”。地热资源、太阳能、水能资源非常丰富。大约5000万年前，印度板块与欧亚板块相碰撞，形成了青藏高原四大高原内蒙古高原：称为“瀚海”，我国第二大高原，是我国最平坦的高原，有典型的风蚀地貌黄土高原：世界黄土分布最广的“黄土地”，流水侵蚀，地表千沟万塾云贵高原：喀斯特地貌发育典型，地势崎岖不平，有许多“坝子”塔里木盆地：我国最大的内陆盆地，内有中国最大沙漠塔克拉玛干沙漠和中国最大的内流河塔里木河准噶尔盆地：我国位置最北的盆地，有典型的风蚀雅丹地貌。位于天山以北，降水较多，农四大盆地牧业发达，被誉为“塞北江南”地形柴达木盆地：我国地势最高的盆地，存储丰富的盐、石油、煤以及多种金属矿藏，被称为“聚宝盆”，有风蚀雅丹地貌四川盆地：我国四大盆地中地势最低的盆地，有“紫色盆地”之称东北平原：我国面积最大的平原，地跨黑吉辽和内蒙古四个省级行政区。东北平原是全球仅有的三大黑土区域之一（另外两个分别是乌克兰大平原和美国密西西比河流域）。东北平原是由北部的松嫩平原、南部的辽河平原和东北部的三江平原三部分组成，平原中部有一条稍隆起的分水岭高地三大平原华北平原：位于燕山以南，淮河以北，太行山以东，濒临渤海和黄海。跨越京、津、冀、鲁、豫、皖、苏7省市，又称黄淮海平原，由黄河、淮河、海河等河流合力冲积而成长江中下游平原：位于四川盆地以东，海拔在50米以下，地跨鄂、湘、赣、皖、苏、浙、沪等7省市，湖泊密布，素有“鱼米之乡”“水乡泽国”的美誉东南丘陵：位于我国东南部，包括江南丘陵、浙闽丘陵、两广丘陵等，是我国面积最大的丘陵。黄山、庐山、武夷山、桂林山水皆位于东南丘陵地区", "地形三大丘陵山东丘陵：位于山东半岛上，著名旅游景点有泰山辽东丘陵：位于辽东半岛上，著名旅游景点有千山"], "shizhan": [{"q": "中国地势西高东低，呈三级阶梯状分布，其中第二级阶梯与第三级阶梯的分界线是：", "options": ["大兴安岭一太行山一巫山一雪峰山", "昆仑山脉一祁连山脉一横断山脉", "天山山脉一阴山山脉一贺兰山", "秦岭一淮河一线"], "a": 0, "e": "本题可以用口诀（32）有大太巫雪二三分开，还有秦岭淮河南稻北麦来解答。因此，选择A选项。"}]}, {"num": "2.06", "title": "宗教名山", "chapter": "第二章 地理知识", "koujue": ["口诀（33）四大道教名山：武当和青城道教山，龙虎山齐云山", "四大佛教名山：四大佛教的第一山，去山西来五台，浙江的普陀峨眉四川，安徽九华别搞乱", "梵净山：黔金丝猴梵净山待，一级保护肩有点白"], "defs": ["湖北武当山：道教第一名山。武当山是道教名山和武当武术的发源地，被称为“互古无双胜境，天下第一仙山”四川青城山：青城山分为前山和后山，群峰环绕起伏、林木葱茏幽翠，享有“青城天下幽”的美誉", "四大道教名山安徽齐云山：齐云山位于安徽省黄山市休宁县齐云山镇。齐云山古称白岳，因遥观山顶与云平齐得名，是道教名山之一，属安徽道教主要活动场所及著名风景游览区。江西龙虎山：龙虎山是中国典型的丹霞地貌风景，是中国道教发祥地，2007年加人世界地质公园网络山西五台山：文殊菩萨的道场，世界文化遗产，位于黄河流域四川峨眉山：普贤菩萨的道场，世界文化与自然双遗产", "四大佛教名山安徽九华山：地藏菩萨的道场，九华山位于安徽省池州市浙江普陀山：观世音菩萨的道场，普陀山位于东海梵净山是中国佛教重要名山，但不属于传统四大佛教名山，而常被视为“佛教第五大名山”梵净山或“弥勒菩萨道场”的代表。第42届世界遗产大会上，中国贵州铜仁梵净山成功列人世界自然遗产名录。一级保护动物黔金丝猴分布在梵净山，其特点是肩部长有一小块白色的毛"], "shizhan": [{"q": "我国四大佛教名山是指：", "options": ["五台山、峨眉山、九华山、普陀山", "五台山、峨眉山、武夷山、普陀山", "五台山、峨眉山、武当山、普陀山", "五台山、峨眉山、武当山、九华山"], "a": 0, "e": "本题可以用口诀（33）四大佛教的第一山，去山西来五台，浙江的普陀峨眉四川，安徽九华别搞乱来解答。因此，选择A选项。"}]}, {"num": "2.07", "title": "三山五岳", "chapter": "第二章 地理知识", "koujue": ["口诀（34）三山：黄山的美名唐朝改，双遗产安徽来，奇松怪石和温泉云海，冬雪美充满爱。", "江西庐山多教派，白鹿洞朱熹在。雁荡山浙江南北分开，在东南第一展风采", "五岳：看泰山衡山华山嵩山，加上恒山五岳都不简单。这东岳领头那南岳独秀，西高北悬中岳", "书院踢球"], "defs": ["黄山位于安徽省，在唐朝时更名为“黄山”，是世界文化与自然双重遗产，代表景观有安徽黄山“四绝三瀑”，“四绝”指奇松、怪石、云海、温泉；“三瀑”指人字瀑、百丈泉、九龙瀑庐山，又名匡山、匡庐，位于江西省九江市境内，以雄、奇、险、秀闻名于世，素有“匡", "三山江西庐山庐奇秀甲天下”之誉。白鹿洞书院位于庐山五老峰上，是朱熹重建并讲学的书院浙江雁荡山名山”之誉，史称“东南第一山”东岳泰山位于山东泰安，又名岱山、岱宗、岱岳、东岳、泰岳，有“五岳之首”、“五岳之长”、五岳之尊、“天下第一山”之称。泰山有“五绝”和“六美”：东岳泰山五岳“五绝”指的是泰山五道风景线：南麓的岱宗坊、红门宫，山顶的玉皇顶、日观峰、仙（山东）人崖。“六美”指是指泰山的六个景点：旭日东升、云海玉盘、晚霞夕照、黄河金带、天门云梯和雾淞奇观西岳华山西岳华山海拔为五岳最高，华山有“奇险天下第一山”的美誉(陕西）北岳恒山北岳恒山有著名的悬空寺(山西）南岳衡山南岳衡山享有“五岳独秀”的美名五岳（湖南）嵩山位于河南省的中部地区，是中国最重要的道教圣地之一。地处河南省登封市西北面，是五岳中的中岳。中岳嵩山嵩山南麓有“嵩山汉三”，分别是太室阙、少室阙、启母阙。其中启母阙和少室阙上都（河南）有“鞠图”。鞠指古人以脚踢皮球的活动，类似今日的足球。嵩阳书院位于嵩山南麓，是“宋初四大书院”（岳麓书院、白鹿洞书院、嵩阳书院、应天书院）之一"], "shizhan": [{"q": "李白的《梦游天姥吟留别》写道：“天姥连天向天横，势拔五岳掩赤城。”此处的“五岳”指的是：", "options": ["泰山、华山、嵩山、恒山、衡山", "庐山、黄山、恒山、衡山、嵩山", "华山、泰山、嵩山、青城山、武当山", "嵩山、衡山、泰山、峨眉山、九华山"], "a": 0, "e": "本题可以用口诀（34）五岳：看泰山衡山华山嵩山，加上恒山五岳都不简单来解答。因此，选择A选项。"}, {"q": "【单选】以下奇观中，黄山可以看到几个？①奇松②怪石③云海④温泉", "options": ["4", "3", "2", "1"], "a": 0, "e": "本题可以用口诀（34）三山：黄山的美名唐朝改，双遗产安徽来，奇松怪石和温泉云海，冬雪美充满爱来解答。因此，选择A选项。"}]}, {"num": "2.08", "title": "四大石窟", "chapter": "第二章 地理知识", "koujue": ["口诀（35）敦煌莫高麦积山，甘肃石窟美名传，云冈大同龙门洛，山西河南石窟多"], "defs": ["莫高俗称“千佛洞”，保存了长达1000多年的古代珍贵壁画和彩塑艺术品，位于甘肃敦煌鸣沙山东麓。它始建于十六国的前秦时期，历经十六国、北朝、隋、唐、五代、西夏、", "甘肃敦煌元等历代的兴建，是中国石窟中内容最丰富的佛教艺术宝库，是世界现存佛教艺术的瑰", "莫高窟宝。莫高窟有众多泥塑造像和大量精美壁画，是建筑、雕塑、壁画三者结合的立体艺术，是一座世界艺术宝库。1987年莫高窟被列人《世界遗产名录》云冈石窟位于山西省大同市，开凿从北魏文成帝和平初（460年）起，是中国第一个规模山西大同云冈巨大的石窟群，是东方石雕艺术的精魂，也是中西文化融合的典范，代表着公元5一6世石窟纪佛教艺术的最高成就。云冈石窟与印度阿游陀石窟、阿富汗巴米扬石窟并称为世界三大石雕艺术宝库麦积山石窟位于甘肃省天水市麦积区，始建于后秦（384一417年），因山形酷似麦垛而甘肃天水得名。麦积山石窟麦积山石窟以泥塑为其特色，塑像的大小于真人相若，被誉为“东方塑像馆”“东方雕塑艺术陈列馆”龙门石窟始凿于北魏孝文帝迁都洛阳之际，繁荣于唐代，断续营造400余年。2345个窟、近11万尊造像、2800多块碑刻题记、近80座佛塔.·历经1500多个春秋的龙门石窟，是世界上造像最多、规模最大的石刻宝库，联合国教科文组织称之为“中国石刻艺术的最高峰”。2000年11月，龙门石窟被列入《世界遗产名录》，位居中国各大石窟之首。龙门石窟被誉为中国最大的露天石刻艺术博物馆。河南洛阳龙门石窟是北魏、唐代皇家贵族发愿造像最集中的地方，是皇家意志和行为的体现，具有龙门石窟浓厚的国家宗教色彩。龙门石窟最大的佛造像是奉先寺卢舍那大佛。卢舍那大佛是唐高宗时期所造，相传是按照武则天的形象雕刻打造成为支柱产业、民生产业、幸福产业。”要把这些中华文化瑰宝保护好、传承好、传播好"], "shizhan": [{"q": "下列关于中国四大石窟的搭配不正确的是：", "options": ["龙门石窟一河南洛阳", "云冈石窟一山西大同", "麦积山石窟一陕西西安", "莫高窟一甘肃敦煌"], "a": 2, "e": "本题可以用口诀（35）敦煌莫高麦积山，甘肃石窟美名传，云冈大同龙门洛，山西河南石窟多来解答。因此，选择C选项。"}]}, {"num": "2.09", "title": "四大名楼", "chapter": "第二章 地理知识", "koujue": ["口诀（36）江西滕王王勃显，湖北黄鹤崔颢撰，湖南岳阳范仲淹，山西鹤雀王之"], "defs": ["江西滕王阁，因王勃的《滕王阁序》而闻名。落霞与孤鹭齐飞，秋水共长天一色。渔舟唱晚，响穷彭之滨，雁阵惊寒，声断衡阳之浦湖北黄鹤楼，因崔的《黄鹤楼》而闻名。昔人已乘黄鹤去，此地空余黄鹤楼。黄鹤一去不复返，白云千载空悠悠。晴川历历汉阳树，四大名楼芳草姜姜鹦鹉洲。日暮乡关何处是？烟波江上使人愁湖南岳阳楼，因范仲淹的《岳阳楼记》而闻名。岳阳楼是中国十大历史文化名楼，古代四大名楼之一，世称“天下第一楼”山西鹳雀楼，因王之《登鹤雀楼》而闻名。鹳雀楼位于山西省永济市蒲州古城西面的黄河东岸。欲穷千里目，更上一层楼江南三大名楼藤王阁、黄鹤楼、岳阳楼，均位于长江沿岸"], "shizhan": [{"q": "我国古代四大名楼中，位于山西的是：", "options": ["滕王阁", "黄鹤楼", "岳阳楼", "鹤雀楼"], "a": 3, "e": "本题可以用口诀（36）江西滕王王勃显，湖北黄鹤崔撰，湖南岳阳范仲淹，山西鹳雀王之来解答。因此，选择D选项。"}]}, {"num": "2.10", "title": "二十四节气", "chapter": "第二章 地理知识", "koujue": ["口诀（37）二十四节气歌：春雨惊春清谷天，夏满芒夏暑相连，秋处露秋寒霜降，冬雪雪冬小", "大寒"], "defs": ["春天的节气：立春、雨水、惊蛰、春分、清明、谷雨夏天的节气：立夏、小满、芒种、夏至、小暑、大暑", "名称秋天的节气：立秋、处暑、白露、秋分、寒露、霜降冬天的节气：立冬、小雪、大雪、冬至、小寒、大寒反映季节：立春、立夏、立秋、立冬反映太阳高度：春分、秋分、夏至、冬至反映寒热程度：小暑、大暑、处暑、小寒、大寒", "反映反映降水现象：雨水、名谷雨、小雪、大雪", "特征反映气温变化：白露、寒露、霜降反映自然物候：惊蛰、清明反映作物的成熟、收成情况：小满、芒种"], "shizhan": [{"q": "中国“二十四节气”中，（)表示夏季的开始。", "options": ["夏至", "谷雨", "惊蛰", "立夏"], "a": 3, "e": "立夏表示夏季的开始。本题可以用口诀（37）夏满芒夏暑相连来解答。因此，选择D选项。"}, {"q": "【单选】以下关于二十四节气与季节的对应关系，正确的是：", "options": ["谷雨一春季", "雨水一夏季", "小寒一秋季", "白露一冬季"], "a": 0, "e": "本题可以用口诀（37）春雨惊春清谷天，夏满芒夏暑相连，秋处露秋寒霜降，冬雪雪冬小大寒来解答。因此，选择A选项。"}]}, {"num": "2.11", "title": "旅游景点", "chapter": "第二章 地理知识", "koujue": ["口诀（38）京杭大运河，里程是最大。长江钱塘江，黄淮海横跨。一四年人遗产影响大", "淡水蓄水量贝加尔最大，印尼索马里和斯里兰卡，做生意丝绸路都到达，法国巴黎塞纳河边呀"], "defs": ["京杭大运河是世界上里程最长、工程最大的古代运河，也是最古老的运河之一，与长城、坎儿井并称为中国古代的三项伟大工程，并且使用至今，是中国古代劳动人民创造的一项伟大工程，是中国文化地位的象征之一。京杭大运河京杭大运河北起北京（涿郡）、南到杭州（余杭），途经北京、天津两市及河北、山东、江苏、浙江四省，贯通海河、黄河、淮河、长江、钱塘江五大水系，全长约1797千米。2014年6月22日，在卡塔尔多哈召开的第38届世界遗产委员会会议上，中国提交的“大运河”项目成功人选《世界遗产名录》，成为中国第46个世界遗产项目贝加尔湖位于俄罗斯东西伯利亚南部，是世界第一深湖、也是世界上蓄水量最大的淡水贝加尔湖湖，淡水储量达到了全世界总量的五分之一。长636千米，平均宽48千米，面积为"], "shizhan": []}]}, {"name": "第三章 文学知识", "entries": [{"num": "3.01", "title": "四书五经", "chapter": "第三章 文学知识", "koujue": ["口诀（39）四书：中学论子", "五经：诗书礼易春秋", "六经：诗书礼易乐春秋"], "defs": ["《中庸》是中国古代论述人生修养境界的一部道德哲学专著，是儒家经典之一，核心思想围绕“中庸之道”展开，强调不偏不倚、折中调和的处世态度和道德准则。四书原属《礼记》第三十一篇，相传作者是战国子思（孔）。孔，字子思，是孔子的嫡孙，继承孔子思想，代表作《中庸》，被尊为“述圣”《大学》阐述了儒家的基本教义和教育原则，强调个人修养和社会责任《论语》是孔子及其弟子的语录集，体现了儒家思想的核心，成书于战国初期。“温故而知新，可以为师矣”出自《论语·为政》。“士不可以不弘毅，任重而道远”出自《论语·泰伯章》", "四书《孟子》阐述了人性论，强调仁政和教育的作用。孟子，鲁国邹（今山东邹城）人，战国时期儒家思想代表人物之一，中国古代思想家、哲学家、政治家、教育家，与孔子并称“孔孟”，被后人称为“亚圣”。提出“人性本善”“民为贵，社稷次之，君为轻”《诗经》又称诗三百，是我国最早的诗歌总集。其收集诗歌的时间范围是西周初年至春秋中叶（前11世纪至前6世纪）。反映了古代社会生活和风土人情。内容：风、雅、颂；表现手法：赋、比、兴五经《尚书》记载了上古历史文献《礼记》记录了古代的礼仪制度和行为规范《周易》包含了六十四卦象，探讨了宇宙万物的变化规律《春秋》是鲁国的编年体史书，据传由孔子修订，约成书于春秋时期六经《诗经》《尚书》《礼记》《周易》《乐经》《春秋》"], "shizhan": [{"q": "我们常说的“四书五经”是中国传统文化的重要组成部分，其中“四书”不包括：", "options": ["《春秋》", "《大学》", "《中庸》", "《论语》"], "a": 0, "e": "本题可以用口诀（39）四书：中学论子来解答。因此，选择A选项。"}]}, {"num": "3.02", "title": "诸子百家", "chapter": "第三章 文学知识", "koujue": ["口诀（40）儒家代表有三贤，孔孟荀子排在前。道家老庄两圣贤，老子庄子列前篇。墨家兼爱", "与尚贤，尚同非攻天下传。法家代表韩非鞅，韩非子里寓言藏。杂家代表韦俊安，吕氏春秋不韦编"], "defs": ["儒家的代表人物是孔子、孟子、荀子。孔子将“仁”视为最高道德准则，主张统治者应“为政以德”（《论语·为政》），即通过自身的儒家道德修养和仁爱的态度治理国家，而非依靠刑罚暴力。他认为“其身正，不令而行；其身不正，虽令不从”，强调统治者的榜样作用道家的代表人物是老子、庄子。道家代表作：《道德经》，又名《老子》，分为《德经》与《道经》，内容以“道德”为纲宗。句式整齐，以韵文为主，韵散结合，富有音韵之美。道家《庄子》，又名《南华经》，大量运用寓言，名篇有《逍遥游》《齐物论》等。老子的观点：“无为而治”“上善若水”“柔弱胜刚强”“祸兮福之所倚，福兮祸之所伏”“道生一，一生二，二生三，三生万物”。，，，，“一，墨家的代表人物是墨子（墨翟），墨家学派创始人，墨家思想的奠基者，被后世弟子尊为“巨子”（墨家最高领袖），是战国时期平民思想的代表。墨家，回“十“非，“，“由，“回，“，“非，“，志”和“明鬼”。墨子在科技领域成就突出，被称为“古代科学家”，《墨子》中记载了小孔成像、杠杆原理等光学和力学知识法家代表人物有管仲、李埋、吴起、商鞅、韩非。法家代表作：《韩非子》是战国时期思想家韩非的著作总集，善于运用浅近的寓言来说明抽象的道法家理，具有较强的论辩性。成语“守株待兔”“滥等充数”均出自《韩非子》。法家的观点：以法治国。经济上，主张废井田，重农抑商、奖励耕战；政治上，主张废分封，设郡县，实行君主专制。不法古、不循今杂家的代表人物有吕不韦、户、刘安。杂家是战国末期至汉初兴起的思想流派，其特点是“兼儒墨，合名法”，融合各家学说之长，注重实用性和综合性，旨在为统治者提供治国安邦的理论体系。", "杂家杂家代表作：《吕氏春秋》，汇集了先秦诸子百家的思想，包括儒家、道家、法家、墨家、农家等，是一部典型的“杂家”著作。成书时间是战国末期（约公元前3世纪），由秦国丞相吕不韦组织门客编撰而成兵家的代表人物是孙武和孙。孙武，春秋时期著名的军事家、政治家，被尊称“兵圣”或“孙子”，又称“兵家至圣”，被誉为兵家“百世兵家之师”“东方兵学的鼻祖”，著作《孙子兵法》。孙眸，战国时期军事家，著作《孙眸兵法》中提出了前所未见的新型战术理念，是中国古代军事理论的瑰宝"], "shizhan": [{"q": "下列关于诸子百家代表人物与学派对应错误的一项是：", "options": ["孔子一儒家", "庄子一道家", "墨子一法家", "吕不韦一杂家"], "a": 2, "e": "本题可以用口诀（40）儒家代表有三贤，孔孟苟子排在前。道家老庄两圣贤，老子庄子列前篇。墨家兼爱与尚贤，尚同非攻天下传。法家代表韩非鞅，韩非子里寓言藏。杂家代表韦安，吕氏春秋不韦编来解答。因此，选择C选项。"}]}, {"num": "3.03", "title": "唐宋八大家", "chapter": "第三章 文学知识", "koujue": ["口诀（41）唐宋八大家，韩柳唐风骚，欧苏三父子，安石曾巩高。"], "defs": ["韩愈，字退之，世称韩昌黎、昌黎先生。苏轼称赞韩愈“文起八代之衰”，韩愈与柳宗元并称为“韩柳”。韩愈是唐代古文运动的倡导者，被称为“唐宋八大家之首”。著作：①“闻道有先后，术业有专攻”“传道授业解惑”出自《师说》。唐宋②“如此孩提者，又可冀其成立邪？”出自《祭十二郎文》，孩提指2一3岁的儿童，幼儿时期。八大家③“世有伯乐，然后有千里马。千里马常有，而伯乐不常有”出自《马说》。④“业精于勤，荒于嬉；行成于思，毁于随”“焚膏油以继暑，恒元元以穷年”出自《进学解》。③“天街小雨润如酥，草色遥看近却无。最是一年春好处，绝胜烟柳满皇都”出自《早春呈水部张十八员外·其一》，描写和赞美的是早春的美景。皇都即帝都，指长安柳宗元，字子厚，山西河东人。柳宗元被称为柳河东，是以籍贯命名的。", "著作：①《捕蛇者说》《黔之驴》《永州八记》。②“孤舟蓑笠翁，独钓寒江雪”出自五言绝句《江雪》欧阳修，字永叔，号醉翁，晚号六一居士，谥号文忠，故世称欧阳文忠公。欧阳修是北宋文坛的领袖、宋代散文的奠基人，标志着北宋诗文革新运动最高成就。代表作：《新唐书》《新五代史》《醉翁亭记》。唐宋《醉翁亭记》考点：①“环滁皆山也。其西南诸峰，林尤美，望之蔚然而深秀者，琅琊也”。②因《醉翁亭记》而驰誉古今的山是琅琊山，醉翁亭位于安徽省滁州市西南琅琊山旁", "八大家王安石，字介甫，号半山，谥文，封荆国公，世人又称王荆公，因籍贯临川，故亦称王临川。依靠宋神宗实行变法，被列宁誉为“中国十一世纪的改革家”。“宰相肚里能撑船”说的是王安石。", "著作：①“不畏浮云遮望眼，自缘身在最高层”出自《登飞来峰》。②“爆竹声中一岁除，春风送暖入屠苏。千门万户瞳瞳日，总把新桃换旧符”出自《元日》。③“千古凭高对此，设嵯荣辱。六朝旧事随流水，但寒烟衰草凝绿”，金陵咏古词句，出自《桂枝香》。《伤仲永》《游褒禅山记》苏，字子瞻，号东坡居士，宋词豪放派代表。苏轼打破了诗与词的界限，使词走向广阔的社会生唐宋著作：《赤壁赋》《江城子》《念奴娇·赤壁怀古》《水调歌头》八大家苏洵，字明允，擅长散文，尤擅政论苏辙，字子由，自号颖滨遗老。著作：《黄州快哉亭记》《上枢密韩太尉书》曾巩：字子固，世称南丰先生，著作：《墨池记》一门父子三词客：北宋文学家苏洵、苏轼、苏辙千古文章四大家：韩愈、柳宗元、欧阳修、苏轼"], "shizhan": [{"q": "【多选】唐宋八大家中属于唐代的有：", "options": ["欧阳修", "王安石", "韩愈", "柳宗元"], "a": "CD", "e": "本题可以用口诀（41）唐宋八大家，韩柳唐风骚，欧苏三父子，安石曾巩高来解答。因此，选择CD选项。"}]}, {"num": "3.04", "title": "初唐四杰", "chapter": "第三章 文学知识", "koujue": ["口诀（42）初唐的孤鹭起，滕王阁作序，王杨卢骆并立。"], "defs": ["王勃位列“初唐四杰”之首，王勃的代表作有《滕王阁序》《送杜少府之任蜀州》《乾元殿颂》《王子安集》等。“落霞与孤鹭齐飞，秋水共长天一色”出自《滕王阁序》。王勃“海内存知已，天涯若比邻”出自《送杜少府之任蜀州》。“九月九日望乡台，他席他乡送客杯”出自《九日登高》。“江送巴南水，山横塞北云”出自《江亭夜月送别二首》初唐杨炯，唐代文学家，692年任盈川县令，吏治以严酷著称。后人称他为“杨盈川”。四杰杨炯“宁为百夫长，胜作一书生”出自《从军行》卢照邻代表作《长安古意》是初唐七言歌行的代表作之一。卢照邻“雪似胡沙暗，冰如汉月明”出自《雨雪曲》骆宾王活跃于唐高宗至武则天时期。公元683年，随徐敬业在扬州起兵反对武则天，撰写《为骆宾王徐敬业讨武墨》，兵败后下落不明。生平充满谜团。相传七岁作《咏鹅》诗，“鹅，鹅，鹅，曲项向天歌。白毛浮绿水，红掌拨清波”流传千古，成为中国文学史上“神童”的经典案例"], "shizhan": [{"q": "【多选】关于我国古代文人的合称，下列表述正确的有：", "options": ["“济南二安”分别是宋词婉约派和豪放派的代表人物", "“史学三班”是指班彪、班固、班超父子三人", "“初唐四杰”是指王勃、杨炯、卢照邻、骆宾王", "“建安七子”包括“三曹”、孔融、陈琳等七位文学家"], "a": "AC", "e": "A项：“济南二安”指李清照（号易安居士）和辛弃疾（字幼安），是宋代词坛婉约派与豪放派代表人物，同为济南（李清照章丘人，辛弃疾历城人）人。A项正确。B项：“史学三班”指汉朝的三位历史学家：父亲班彪，儿子班固和幼女班昭。班超是出使匈奴的军事将领，不是历史学家。B项错误。C项：“初唐四杰”指的是王勃、杨炯、卢照邻、骆宾王四人。他们都是初唐中后期很有才华的诗文作家，四人才名早享，在青少年时代就获得“四杰”的美誉。C项正确。D项：“建安七子”是汉建安年间（196年一220年）七位文学家的合称，包括孔融、陈琳、王桑、徐干、阮璃、应场、刘桢。这七人大体上代表了建安时期除曹氏父子（即曹操、曹丕、曹植）外的文学成就，所以“七子”之说，得到后世的普遍承认。D项错误。本题可用口诀（42）初唐的孤鹭起，滕王阁作序，王杨卢骆并立来选择C项。因此，选择AC选项。"}]}, {"num": "3.05", "title": "唐诗", "chapter": "第三章 文学知识", "koujue": ["口诀（43）愿作比翼的琵琶女，为你入魔白居易。可怜陋室刘禹锡，乌衣巷燕飞哪里。独钓江", "雪戴裳笠，柳宗元永州记，李贺叹天老矣。诗囚孟郊写游子吟，登科后春风得意。晚唐杜牧李商", "隐，阿房宫赋和无题。"], "defs": ["王维，字摩诘，有“诗佛”之称，苏东坡曾盛赞他的诗“诗中有画，画中有诗”。著作：①“大漠孤烟直，长河落日圆”出自《使至塞上》。“长河落日圆”指光的直线传播，其中的“河”指的是黄河。", "山水②“独在异乡为异客，每逢佳节倍思亲”出自《九月九日忆山东兄弟》，诗中的“佳节”指的是重诗人阳节。③“劝君更尽一杯酒，西出阳关无故人”出自《送元二使安西》，诗句中的“阳关”在今天的甘肃敦煌孟浩然，被称为孟襄阳，是以籍贯命名的，今湖北襄阳人。著作：①“人事有代谢，往来成古今”出自《与诸子登岘山》。盛唐②“春眠不觉晓，处处闻蹄鸟。夜来风雨声，花落知多少”出自《春晓》。③“移舟泊烟渚，日暮客愁新。野旷天低树，江清月近人”出自《宿建德江》。④“故人具鸡黍，邀我至田家”“待到重阳日，还来就菊花”出自田园诗《过故人庄》边塞派诗人以高适、岑参、李颁、王昌龄、王之最为知名，而高、岑成就最高，所以也叫高岑诗", "边塞诗人派。王昌龄、王之并称“二王”。著作：①“莫愁前路无知已，天下谁人不识君”高适《别董大》。②“忽如一夜春风来，千树万树梨花开”一一岑参《白雪歌送武判官归京》。③“但使龙城飞将在，不教胡马度阴山”王昌龄《出塞》。④“白日依山尽，黄河入海流”一王之渔《登鹤雀楼》。③“笛何须怨杨柳，春风不度玉门关”一一王之《凉州词》。“凉州”是今甘肃武威市，“玉门关”在今甘肃敦煌市西北李白，字太白，号青莲居士，人称“谪仙人”“诗仙”，有《李太白集》传世，《梦游天姥吟留别》等，创造了古代浪漫主义文学的高峰。著作：①“孤帆远影碧空尽，唯见长江天际流”出自《黄鹤楼送孟浩然之广陵》。②“天生我材必有用，千金散尽还复来”出自《将进酒》。③“我醉欲眠卿且去，明朝有意抱琴来”出自《山中与幽人对酌》。④“日照香炉生紫烟，遥看瀑布挂前川”出自《望庐山瀑布》。③“又闻子规夜月，愁空山。蜀道之难，难于上青天，使人听此调朱颜！”出自《蜀道难》。③“长风破浪会有时，直挂云帆济沧海”出自《行路难》，体现的哲理是事物发展是前进性与曲折性的统一。“脚著谢公履，身登青云梯。半壁见海日，空中闻天鸡”出自《梦游天姥吟留别》，“谢公”指的是谢灵运。盛唐大李③“床前明月光，疑是地上霜”出自《静夜思》。“青梅竹马，两小无猜”出自《长干行》杜甫，字子美，自号少陵野老，世称“杜工部”“诗圣”，其诗被称为“诗史”，唐代现实主义诗人，常被称为“老杜”，又与李白合称“李杜”“大李杜”。有《杜工部集》传世。著作：①“三吏”（《新安吏》《石壕吏》《潼关吏》）。（《晕垂》《咕率》《楼》）“三，③③“国破山河在，城春草木深。感时花溅泪，恨别鸟惊心”出自《春望》。④“无边落木萧萧下，不尽长江滚滚来”出自《登高》。③“岱宗夫如何？齐鲁青未了”“会当凌绝顶，一览众山小”出自《望岳》，是杜甫登泰山写下的豪言壮语。“岱宗”指的是泰山。③“露从今夜白，月是故乡明”出自《月夜忆舍弟》。②“安得广厦千万间，大庇天下寒士俱欢颜！风雨不动安如山”出自《茅屋为秋风所破歌》。", "大李盛唐③“三顾频烦天下计，两朝开济老臣心”出自《蜀相》。②《北征》《兵车行》《闻官军收河南河北》白居易，字乐天，号香山居士，世称“诗魔”“诗王”，现实主义诗人。著作：①“风翻白浪花千片，雁点青天字一行”出自《江楼晚跳景物鲜奇吟玩成篇寄水部张员外》。②“同是天涯沦落人，相逢何必曾相识”出自《琵琶行》。③“文章合为时而著，歌诗合为事而作”出自《与元九书》。④“日出江花红胜火，春来江水绿如蓝”出自《忆江南》。中唐诗魔③“回眸一笑百媚生，六宫粉黛无颜色”“在天愿作比翼鸟，在地愿为连理枝”出自《长恨歌》。③“半匹红绡一丈绫，系向牛头充炭直”出自《卖炭翁》，在经济学上来说，其中的“红绡”“绫”代表的是一般等价物。“乱花渐欲迷人眼，浅草才能没马蹄。最爱湖东行不足，绿杨阴里白沙堤”出自《钱塘湖春行》，描写的是杭州西湖的风景。③“离离原上草，一岁一枯荣。野火烧不尽，春风吹又生”出自《赋得古原草送别》李贺，字长吉，浪漫主义诗人，世称李昌谷，著有《昌谷集》。被后人誉为“诗鬼”。著作：①“黑云压城城欲摧，甲光向日金鳞开”出自《雁门太守行》。②“衰兰送客咸阳道，天若有情天亦老”出自《金铜仙人辞汉歌》。诗鬼③“昆山玉碎凤凰叫，芙蓉泣露香兰笑”出自《李凭笙筷引》。④“老兔寒蟾泣天色，云楼半开壁斜白”出自《梦天》。③“长吉体”是李贺的诗歌所独有的风格意境，李贺特别擅长短篇，如《天上谣》《梦天》《帝子歌》等，被后人称为“长吉体”的代表作中唐刘禹锡，字梦得，人称“诗豪”，代表作有《陋室铭》《竹枝词》《杨柳枝词》《乌衣巷》等。", "著作：①“山不在高，有仙则名。水不在深，有龙则灵”出自《陋室铭》。诗豪②“唯有牡丹真国色，花开时节动京城”出自《赏牡丹》。③“旧时王谢堂前燕，飞人寻常百姓家”出自《乌衣巷》。④“塞北梅花羌笛吹，淮南桂树小山词。请君莫奏前朝曲，听唱新翻杨柳枝”出自《杨柳枝词》，这首诗体现的哲理是事物是不断变发展的，要有创新精神孟郊，人称“诗囚”，与贾岛并称为“郊寒岛瘦”。其代表作有《游子吟》《登科后》。", "诗囚“春风得意马蹄疾，一日看尽长安花”出自《登科后》李商隐，字义山，号玉溪生，创写了以男女之情为题材的无题诗。其诗构思新奇，风格称丽，尤其是一些爱情诗和无题诗写得缠绵排侧，优美动人，后世广为传诵。著作：①“沧海月明珠有泪，蓝田日暖玉生烟”出自《锦瑟》。②“相见时难别亦难，东风无力百花残。春蚕到死丝方尽，蜡炬成灰泪始干”出自《无题·相见时难别亦难》。③“君问归期未有期，巴山夜雨涨秋池。何当共剪西窗烛，却话巴山夜雨时”出自《夜雨寄北》。④“历览前贤国与家，成由节俭破由奢”出自《咏史》，这是李商隐在总结唐朝由盛世走向衰败的历史教训时写下的警世名言晚唐小李杜牧，字牧之，世称杜樊川，因晚年隐居樊川，号“樊川居士”，作品集《樊川文集》。杜牧是我国第一个大量用七绝写咏史诗的诗人。他以七绝咏史见长，作品被称为“二十八字史论”。著作：①“东风不与周郎便，铜雀春深锁二乔”出自《赤壁》。②“商女不知亡国恨，隔江犹唱后庭花”出自《泊秦淮》。③“停车坐爱枫林晚，霜叶红于二月花”出自《山行》。④“天阶夜色凉如水，卧看牵牛织女星”出自《秋夕》。③“清明时节雨纷纷，路上行人欲断魂”出自《清明》。③“南朝四百八十寺，多少楼台烟雨中”出自《江南春》。②“灭六国者六国也，非秦也；族秦者秦也，非天下也”出自《阿房宫赋》。“勾心斗角”一词出自《阿房宫赋》。③“一骑红尘妃子笑，无人知是荔枝来”出自《过华清宫》"], "shizhan": [{"q": "【单选】唐诗是中华民族珍贵的文化遗产之一，是中国文化宝库中的一颗明珠，下列诗人与诗句对应正确的是：", "options": ["李商隐—一人事有代谢，往来成古今", "李白一一莫愁前路无知已，天下谁人不识君", "杜甫一海上生明月，天涯共此时", "刘禹锡一旧时王谢堂前燕，飞入寻常百姓家"], "a": 3, "e": "“旧时王谢堂前燕，飞入寻常百姓家”出自唐朝刘禹锡的《乌衣巷》，意思是当年王导、谢安檐下的燕子，如今已飞进寻常百姓家中。这两句诗感慨沧海桑田，人生多变。D项正确。本题可以用口诀（43）可怜陋室刘禹锡，乌衣巷燕飞哪里来解答。因此，选择D选项。"}]}, {"num": "3.06", "title": "宋词", "chapter": "第三章 文学知识", "koujue": ["口诀（44）范仲淹岳阳楼与谁同归，婉约派李清照绿肥红瘦"], "defs": ["范仲淹，字希文，世称范文正公，代表作《岳阳楼记》，是一篇散文，重点描写的是洞庭湖的景色。①《岳阳楼记》常考名句：“先天下之忧而忧，后天下之乐而乐”。“居庙堂之高则忧其民，处江湖之远则优其君”。“政通人和，百废具兴”。“阴风怒号，浊浪排空”。“长烟一空，皓月千里”。“不以物喜，不以已悲”。②“差管悠悠霜满地，人不，将军白发征夫泪”出自《渔家傲·秋思》辛弃疾，字幼安，号稼轩，山东济南人。南宋豪放派词人、将领。辛弃疾艺术风格多样，但以豪放为主，有“词中之龙”之称。与苏合称“苏辛”，与李清照并称“济南二安”。主要作品有《稼轩长短句》《清平乐》。著作：①“江晚正愁余，山深闻鹧鸪”出自《菩萨蛮·书江西造口壁》，“鹧鸪”这个意象表达了诗人离愁别绪，落魄、怀古的情绪。②“想当年，金戈铁马，气吞万里如虎”出自《永遇乐·京口北固亭怀古》，属于怀古诗。③《美芹十论》从第一论以至于第十论，无一不是精辟之论。同时，这也是一部很好的军事论著，有着很高的研究价值。除此之外，《美芹十论》成了辛弃疾的代名词，郭沫若先生为辛弃疾墓写过一副挽联：“铁板铜琶，继东坡高唱大江东去（上联）；美芹悲黍，冀南宋莫随鸿雁南飞（下联）。”④“稻花香里说丰年，听取蛙声一片”出自《西江月·夜行黄沙道中》。③“八百里分麾下炙，五十弦翻塞外声，沙场秋点兵”出自《破阵子·为陈同甫赋壮词以寄之》。③“东风夜放花千树，更吹落，星如雨。宝马雕车香满路。凤箫声动，玉壶光转，一夜鱼龙舞。蛾儿雪柳黄金缕，笑语盈盈暗香去。众里寻他千百度。骞然回首，那人却在，灯火阑珊处”出自辛弃疾的《青玉案·元夕》。其中“青玉案”是词牌名，“元夕”是题名。②著名的国学大师王国维说：“古今之成大事业、大学问者，必经过三种之境界。”他引用宋词中的名句来形容这三种境界。第一境界是：“昨夜西风凋碧树，独上高楼，望尽天涯路”（出自晏殊的《蝶恋花·槛菊愁烟兰泣露》）。第二境界是：“衣带渐宽终不悔，为伊消得人樵痒”（出自柳永的《蝶恋花·仁倚危楼风细细》）。第三境界是：“众里寻他千百度。葛然回首，那人却在，灯火阑珊处”。③《九议》撰写于宋孝宗乾道年间（1165一1173年），当时辛弃疾参与耿京起义，擒杀叛徒张安国，回归南宋，面对南宋在与金国对峙中的被动局面，他结合自身抗金经验和对时局的洞察，写下这组奏议，希望能说服朝廷转变国策，积极备战抗金，但不被朝廷采纳岳飞，字鹏举，代表作：《满江红·怒发冲冠》《小重山·咋夜寒蟹不住鸣》。《满江红·怒发冲冠》考点：①《满江红·怒发冲冠》是南宋抗金民族英雄岳飞创作的一首词，表现了作者抗击金兵、收复故土、统一祖国的强烈的爱国精神。", "②常考名句：A.“笑谈渴饮匈奴血”，其中“匈奴”是指女真统治者。B.“靖康耻，犹未雪。臣子恨，何时灭”讲述了发生在宋朝的“靖康之变”（金破东京擒二帝），“靖康”指的是年号。C.“莫等闲，白了少年头，空悲切”表达了岳飞对南宋抗金历史事件的感慨。从哲学角度看，这句话说明了时间的一维性陆游，字务观，号放翁，现存诗9300余首，是中国古代存诗最多的诗人，诗集为《剑南诗稿》，文集为《渭南文集》。代表作是《示儿》《钗头凤》。", "①《示儿》考点：“王师北定中原日，家祭无忘告乃翁”出自《示儿》，直接导致北宋灭亡的历史事件是靖康之变。②《头凤·红酥手》考点：A.《钗头凤·红酥手》描写了词人与原配唐婉的爱情悲剧。记述了词人与唐氏被迫分开后，在禹迹寺南沈园的一次偶然相遇的情景。陆游乘醉吟赋这首词，信笔题于园壁之上。B.“春如旧，人空瘦，泪痕红浥鲛绡透”出自《钗头凤·红酥手》李煜，字重光，号钟隐、莲峰居士，史称五代十国时期“南唐后主”“千古词帝”。李煜虽出身皇室，却不喜参政和国家大事，他一心潜没于诗词文学的深海，精书法、工绘画、通音律，诗文均有一定造谐，尤以词的成就最高。代表作：①《虞美人》A.虞美人是词牌名，代表作有李煜《虞美人·春花秋月何时了》《虞美人·风回小院庭芜绿》等。B.《虞美人·春花秋月何时了》名句：“雕栏玉砌应犹在，只是朱颜改”。“问君能有几多愁？恰似一江春水向东流”。②《相见欢·无言独上西楼》A.李煜的名篇，词牌名为相见欢，咏的却是离别愁。B.原文：无言独上西楼，月如钩。寂寞梧桐深院锁清秋。剪不断，理还乱，是离愁。别是一般滋味在心头。③《浪淘沙·帘外雨瀑瀑》A.浪淘沙原为唐教坊曲名，后用为词牌名。中唐刘禹锡、白居易依小调《浪淘沙》唱和而首创乐府歌辞《浪淘沙》。B.原文：帘外雨瀑瀑，春意阑珊。罗不耐五更寒。梦里不知身是客，一响贪欢。独自莫凭栏，无限江山。别时容易见时难。流水落花春去也，天上人间柳永，字耆卿，原名三变，北宋婉约派词人的代表人物。柳永制作大量慢词长调，以“白衣卿相”自谓，精通音律，擅长铺陈点染，其创作重心主要在词的创作，擅长用细腻的笔触描写都市繁华和男女情感。柳永的词在宋元时代流传最广，“凡有井水饮处，皆能歌柳词”。代表作：①《雨霖铃·寒蝉凄切》原文：寒蝉凄切，对长亭晚，骤雨初歇。都门帐饮无绪，留恋处，兰舟催发。执手相看泪眼，竞无语凝嘻。念去去，千里烟波，暮沉沉楚天阔。多情自古伤离别，更那堪，冷落清秋节！今宵酒醒何处？杨柳岸，晓风残月。此去经年，应是良辰好景虚设。便纵有千种风情，更与何人说？②《蝶恋花·倚危楼风细细》原文：倚危楼风细细，望极春愁，黯黯生天际。草色烟光残照里，无言谁会凭阑意。拟把疏狂图一醉，对酒当歌，强乐还无味。衣带渐宽终不悔，为伊消得人樵粹。③“渔市孤烟農寒碧，水村残叶舞愁红”出自《雪梅香·景萧索》。④“渐霜风凄紧，关河冷落，残照当楼”“惟有长江水，无语东流”“想佳人，妆楼颚望，误几回、天际识归舟”出自《八声甘州·对潇潇暮雨洒江天》。被苏轼评价为“唐人高处，不过如此”③“三秋桂子，十里荷花”出自《望海潮·东南形胜》秦观，字少游，号淮海居士，属于“苏门四学士”（黄庭坚、秦观、显补之、张耒）之一。代表作：《鹊桥仙·纤云弄巧》。《鹊桥仙·纤云弄巧》是一首咏七夕的节序词，借牛郎织女悲欢离合的神话故事，讴歌了真挚、细腻、纯洁、坚贞的爱情。原文：纤云弄巧，飞星传恨，银汉暗度。金风玉露一相逢，便胜却人间无数。柔情似水，佳期如梦，忍顾鹊桥归路。两情若是久长时，又岂在朝朝暮暮李清照，号易安居士，与辛弃疾并称“济南二安”，被称为“千古第一才女”“三瘦词人”，被誉为“词国皇后”。代表作：《一剪梅》《声声慢》《醉花阴》。①李清照被称为“三瘦词人”，所谓“三瘦”是指她喜以“瘦”字入词，来形容花容人貌，并创造了三个因“瘦”而名传千古的佳句：A.“莫道不销魂，帘卷西风，人比黄花瘦”出自《醉花阴》。此句中的“黄花”指的是菊花。B．“知否，知否？应是绿肥红瘦”出自《如梦令·昨夜雨疏风骤》。这里的“红瘦”指的是海棠花。这句词描写的是暮春时节的景色。暮春是春季的最后阶段，此时春天即将过去，夏天即将到来。词中的“绿肥”指的是树叶枝叶繁茂，“红瘦”则指花朵凋零稀少。这种景象正是暮春时节的特点。C.“新来瘦，非干病酒，不是悲秋”出自《凤凰台上忆吹箫》。②“此情无计可消除，才下眉头，却上心头”出自《一剪梅·红藕香残玉章秋》。③“暗淡轻黄体性柔，情疏迹远只香留。何须浅碧深红色，自是花中第一流”出自《鹧鸪天·桂花》，词中描述的是桂花。④“生当作人杰，死亦为鬼雄”出自《夏日绝句》。③“乍暖还寒时候，最难将息”出自《声声慢·寻寻觅觅》。“将息”是指保养身体。③“莫许杯深琥珀浓，未成沉醉意先融”出自《浣溪沙·莫许杯深琥珀浓》。意思是不要说这酒杯太深，如琥珀般的酒太浓，而未醉即已意蚀魂消。李清照在《词论》中批评柳永“虽协音律，而词语尘下”，意思是柳永的词虽然符合音律要求，但用词俗气，不够高雅。这一评价反映了李清照对词的艺术标准的高要求，她推崇典雅含蓄的风格，而柳永的词多写市井风情、男女艳情，语言通俗直白，故被李清照诉病。③“大明湖畔，趵突泉边，故居在垂杨深处；漱玉集中，金石录里，文采有后主遗风”是郭沫若为李清照题写的楹联"], "shizhan": [{"q": "“知否，知否？应是绿肥红瘦”一句出自我国古代著名女词人（)的《如梦令·昨夜雨疏风骤》。", "options": ["朱淑贞", "吴淑姬", "张玉娘", "李清照"], "a": 3, "e": "本题可以用口诀（44）范仲淹岳阳楼与谁同归，婉约派李清照绿肥红瘦来解答。因此，选择D选项。"}]}, {"num": "3.07", "title": "元曲", "chapter": "第三章 文学知识", "koujue": ["口诀（45）元曲四大家：郑关白马（谐音记忆：正在关白马）", "元曲四大悲剧：梧汉赵窦（谐音记忆：武汉找豆）", "元曲四大爱情剧：拜西墙倩（谐音记忆：白锡抢钱）"], "defs": ["郑光祖：《倩女离魂》一张倩女。关汉卿：《窦娥冤》一窦娥；《救风尘》一赵盼儿；《望江亭》一谭记儿。1958年，关元曲四大家汉卿被世界和平理事会列为世界十大文化名人。“郑关白马”白朴：《墙头马上》一裴少俊；《梧桐雨》一唐明皇、杨贵妃。元曲马致远：《汉宫秋》一王昭君、汉元帝；《青衫泪》一白居易元曲四大悲剧《窦娥冤》《梧桐雨》《汉宫秋》《赵氏孤儿》《拜月亭》、《西厢记》（王实甫著，主角为崔莺莺、红娘、张生）、《墙头马上》、《倩元曲四大爱情剧女离魂》"], "shizhan": [{"q": "【多选】下列属于元曲的四大悲剧的是：", "options": ["《窦娥冤》", "《汉宫秋》", "《倩女离魂》", "《赵氏孤儿》"], "a": "ABD", "e": "本题可以用口诀（45）元曲四大悲剧：梧汉赵窦（谐音记忆：武汉找豆）来解答。因此，选择ABD选项。"}]}, {"num": "3.08", "title": "明清文学", "chapter": "第三章 文学知识", "koujue": ["口诀（46）汤显祖四梦里游代，牡丹亭和紫钗记。南洪北孔才华溢，桃花长生多绚丽"], "defs": ["《牡丹亭》《紫锣记》《南柯记》《邯郸记》合称“临川四梦”汤显祖“独写菖蒲竹叶杯，蓬城芳草踏初回。情知不向瓯江死，舟何劳吊屈来”出自汤显祖的《午日处州禁竞渡》徐光启明代著名科学家，《农政全书》是中国古代的一部农业百科全书明末科学家，著《天工开物》一书，对明代农业、手工业生产技术进行了总结，被誉宋应星为“中国17世纪的工艺百科全书”地理学家，著《徐霞客游记》，最早揭示了中国西南地区石灰岩地貌的各种特征，徐徐霞客霞客也因此成为世界上科学考察石灰岩地貌的先驱李时珍著《本草纲目》，集十六世纪以前中国本草学之大成《金瓶梅》为章回体长篇小说，作者署名兰陵笑笑生，被列为明代“四大奇书”之首。《三国演义》是我国第一部长篇章回小说，罗贯中著，全名《三国志通俗演义》，是历史演义小说的经典之作，成书于明代。四大奇书《水浒传》施耐庵著，作于元末明初，是中国历史上第一部用白话文写成的章回小说。“西金三水”《西游记》吴承恩著，是一部规模宏伟、结构完整、用幻想形式来反映社会矛盾的巨著，作于明朝中期，西游记中的西天古称天竺，也就是现在的印度，它是佛陀故乡、佛教圣地", "洪昇：《长生殿》南洪北孔孔尚任：《桃花扇》曹雪芹《红楼梦》：中国古典小说的巅峰，被誉为“中国封建社会的百科全书”《聊斋志异》：古典文言短篇小说的巅峰。“写鬼写妖高人一等，刺贪刺虐人木三分”，蒲松龄“鬼狐有性格，笑骂成文章”《四库全书》：清朝乾隆皇帝在“文字狱”的背景下亲自组织大批学者编写，为当时世界上最大的一部丛书，基本囊括了清代前期的古代所有的图书。1772年开始，经十年编成。丛书分经、史、子、集四部，故名四库。经、史、子、集四分法是古代图书分《四库全书》类的主要方法，它基本上囊括了古代所有图书，故称“全书”。乾隆三十八年（1773年）二月，《四库全书》正式开始编修，以纪晓岚、陆锡熊、孙士毅为总纂官，陆费为总校官，下设纂修官、分校官及监造官等400余人"], "shizhan": []}, {"num": "3.09", "title": "文字发展史", "chapter": "第三章 文学知识", "koujue": ["口诀（47）文字发展先后顺序：甲金篆隶草楷行"], "defs": ["殷商时代写在龟甲和兽骨上的占卜文字，最早出土于河南安阳（殷墟），2017年入选《世界记", "甲骨文忆名录》金文商、周时期刻铸在钟、鼎及其他青铜器上的铭文，又称“钟鼎文”大篆春秋战国到秦时通行的字体，包括“搐文”和“石鼓文”小篆秦朝统一文字为小篆。著名的秦代石刻有《泰山刻石》《会稽刻石》由小篆演变而来，产生于秦，通行于汉，为后世草书、楷书、行书的产生和演变奠定了基础，讲究蚕头燕尾直接从隶书演变而来，汉初始有草书。特点是结构简省、笔画连绵楷书又称正书或真书，出现于汉末，魏晋南北朝时期通行。特点是横平竖直行书行书是介于楷书、草书之间的一种字体，代表作：东晋王羲之《兰亭序》"], "shizhan": [{"q": "在汉字的形体演变过程中，位于小篆和楷书之间的字体是：", "options": ["金文", "大篆", "隶书", "行书"], "a": 2, "e": "本题用口诀（47）文字发展先后顺序：甲金篆隶草楷行解答。因此，选择C选项。"}]}]}, {"name": "第四章 科技知识", "entries": [{"num": "4.01", "title": "航空母舰", "chapter": "第四章 科技知识", "koujue": ["口诀（48）辽宁航母第一艘，山东航母国产首；福建首艘弹射型，阻拦装置常规动"], "defs": ["中国人民解放军海军辽宁舰（代号：001型航空母舰，号：16，简称辽宁舰），是中国人民解放军海军隶下的一艘可以搭载固定翼飞机的航空母舰，也是中国第一艘服役的航空母舰。辽宁舰由", "辽宁舰购自乌克兰的一艘未完工航母改建而成。2012年9月25日，正式更名辽宁号，交付予中国人民解放军海军中国人民解放军海军山东舰（号：17，简称山东舰），是中国第一艘完全自主设计、自主建造、山东舰自主配套的国产航空母舰，是人列中国人民解放军海军的第二艘航空母舰，标志着中国海军正式迎来国产航母时代中国人民解放军海军福建舰（号：18，简称福建舰），我国第三艘航空母舰，是中国完全自主设计建造的首艘弹射型航空母舰，采用平直通长飞行甲板，配置电磁弹射和阻拦装置，满载排水量8万余吨。福建舰采用的是常规动力系统。我国是继美国之后，全世界第2个独立研制航母电", "福建舰磁弹射器的国家。福建舰的命名是根据《海军舰艇命名规定》等相关规定进行的，通常以省级行政区来命名航空母舰"], "shizhan": [{"q": "我国第一艘航空母舰是：", "options": ["山东舰", "辽宁舰", "福建舰", "海南舰"], "a": 1, "e": "本题可以用口诀（48）辽宁航母第一艘，山东航母国产首来解答。因此，选择B选项。"}]}, {"num": "4.02", "title": "两栖攻击舰", "chapter": "第四章 科技知识", "koujue": ["口诀（49）四川舫号51，双舰电弹两栖"], "defs": ["海南舰（舫号31），全称中国人民解放军海军海南舰，是中国自主研制的075型两栖攻击舰首舰，可搭载30架各类直升机（直-8/直-20系列）及两栖装甲车辆，具备立体登陆作战能力。2021年4月23日，海南舰在海南三亚某军港集中交接人列。海南舰并非航空母舰广西舰（号32），全称中国人民解放军海军广西舰，是首艘以少数民族自治区命名的军舰，075型是中国建造的第二艘075型两栖攻击舰。广西舰配备了直通甲板和坞舱，可搭载直升机、两栖两栖攻击舰气垫登陆艇、两栖战车等两栖作战装备，具备立体登陆作战能力。广西舰并非航空母舰安徽舰（眩号33），全称中国人民解放军海军安徽舰，是中国第三艘075型两栖攻击舰。安徽舰配备了直通甲板和坞舱，可搭载直升机、两栖气垫登陆艇、两栖战车等两栖作战装备，具备立体登陆作战能力。2022年11月，中国人民解放军海军官宣中国人民解放军海军安徽舰人列。安徽舰并非航空母舰湖北舰（航号34），中国人民解放军海军湖北舰，是中国第四艘075型两栖攻击舰。2023年12月14日，中国第四艘075型两栖攻击舰在上海沪东中华造船厂顺利下水。2025年8075型月1日，南海舰队官方账号发文，确认中国第四艘075型两栖攻击舰命名为“湖北舰”。", "两栖攻击舰湖北舰最大排水量超过4万吨，配备了直通甲板和坞舱，可搭载直升机、两栖气垫登陆艇、两栖战车等两栖作战装备，具备立体登陆作战能力四川舰（号51），全称中国人民解放军海军四川舰，于2024年12月27日正式下水命名，是076型中国自主研制建造，全球首创“两栖攻击舰+电磁弹射”技术的战舰，设置双舰岛式上层建筑", "两栖攻击舰和全纵通飞行甲板，可搭载固定翼飞机、直升机、两栖装备等。四川舰并非航空母舰"], "shizhan": [{"q": "关于四川舰，以下说法正确的是：", "options": ["四川舰是中国第一艘航空母舰", "四川舰是全球首艘具备“两栖攻击舰+电磁弹射”技术的战舰", "四川舰是隶属东海舰队，舫号是52", "四川舰采用单舰岛设计，并配备电磁弹射系统"], "a": 1, "e": "本题可以用口诀（49）四川航号51，双舰电弹两栖来解答。因此，选择B选项。"}]}, {"num": "4.03", "title": "天问系列", "chapter": "第四章 科技知识", "koujue": ["口诀（50）天问一号首发射，飞向火星去探秘，天问一号文昌起，天问二号西昌起"], "defs": ["2020年7月23日，天问一号在文昌航天发射场由长征五号遥四运载火箭发射升空，飞行约7个月抵达火星，并通过2至3个月的环绕飞行后着陆火星表面，开展探测任务。天问一号执行“绕、落、", "天问一号巡”三大任务。天问一号是我国第一颗人造火星卫星，也是我国成功着陆火星的首枚火星探测器。天问一号发射后实现了从地月系到行星系跨越。天问一号团队获得2022年度“世界航天奖”2025年5月29日，天问二号在西昌卫星发射中心用长征三号乙遥运载火箭成功发射升空。天问二号总的任务周期大约是10年，其中用两年半左右的时间完成对小行星2016H03的伴飞、取样并返天问二号回地球。此后则会继续它的第二项任务：对主带彗星311P的伴飞探测。天问二号探测器的发射成功标志着中国首次小行星探测与采样返回之旅顺利迈出第一步。天问二号是继嫦娥五号月球采样后，中国首次实现小行星采样返回，将验证采样返回技术、深空导航与通信技术"], "shizhan": [{"q": "我国第一颗人造火星卫星是：", "options": ["天问一号", "长征一号", "羲和号", "东方红一号"], "a": 0, "e": "本题可以用口诀（50）天问一号首发射，飞向火星去探秘，天问一号文昌起，天问二号西昌起来解答。因此，选择A选项。"}]}, {"num": "4.04", "title": "神舟系列", "chapter": "第四章 科技知识", "koujue": ["口诀（51）神舟十八成员，八零未来可期，十九二十接替，九零舱外第一", "【神十八】口决：聪富苏", "【神十九】口诀：送菜王", "【神二十】口诀：中冬王", "【3舱3船组合体】口决：船变舱不变"], "defs": ["2025年4月24日，神舟二十号载人飞船在酒泉卫星发射中心搭载长征二号F遥二十运载火箭发射。神舟二十号载人飞船入轨后成功对接于空间站天和核心舱径向端口，整个对接过", "神舟二十号程历时约6.5小时。2025年4月24日是第十个“中国航天日”神舟二十号开展3项生命科学实验，研究对象分别为斑马鱼、涡虫和链霉菌，首次进人太", "科研任务空的是涡虫神舟十八号乘组在轨期间开展了国内首次在轨水生生态研究（斑马鱼、金鱼藻）和国际首次植物茎尖干细胞功能研究，推动空间科学实验创新。②神舟十九号航天员是蔡旭哲（“70后”）、宋令东（“90后”）、王浩泽（“90后”）。", "航天员首位执行舱外活动的“90后”航天员是宋令东。（08，）（0，）（08，）?【总结】“70后”“80后”“90后”齐聚“天宫”，完成中国航天史上第6次“太空会师”，也是两名指令长时隔3年后再次相聚“天宫”", "①天和核心舱：中国空间站发射人轨的首个舱段，是中国研制的规模非常大、系统非常复杂的航天器。2021年4月29日11时23分，天和核心舱由长征五号B遥二运载火箭搭载发射，在文昌航天发射场点火升空。后续，天和核心舱先后迎接天舟货运飞船和神舟飞船的访问，在全面完成空间站关键技术验证后，与问天实验舱、梦天实验舱实施交会对接，完成中国空间站三舱组合体在轨组装建造。", "②问天实验舱：2022年7月24日，问天实验舱搭载长征五号B遥三运载火箭在文昌航天发射场发射，主3舱3船要面向空间生命科学研究。2022年7月25日3时13分，问天实验舱成功对接于天和核心舱前向端口。", "③梦天实验舱：2022年10月31日，梦天实验舱搭乘长征五号B遥四运载火箭在文昌航天发射场发射。2022年11月1日，成功对接于天和核心舱前向端口。2022年11月3日，空间站梦天实验舱顺利完成转位，空间站“T”字基本构型在轨组装完成。梦天实验舱的定位是“工作实验”，因此并没有休息空间的存在，它的入轨对接可以支持航天员进行大规模的科学载荷实验自神舟十八号起飞船采用锂离子电池，替代镉镍电池，能量密度更高且环保，还能为整船", "锂离子电池减重约50公斤刘洋是我国第一个女航天员。女性航天员王浩泽是我国第一个女飞行工程师。王亚平是我国第一个太空行走的女航天员中国3位飞行工程师：朱杨柱、王浩泽、王杰朱杨柱是中国第一个飞行工程师。", "飞行工程师王浩泽是中国第一个飞行女工程师。王杰是第三批航天员中首个参与在轨轮换的飞行工程师杨利伟是我国第一个航天员。航天员之最翟志刚是我国第一个太空行走的航天员。桂海潮是我国第一个飞天的载荷专家2021年，吴伟仁（中国探月工程总设计师）获2020年度钱学森最高成就奖钱学森最高2022年，包为民（运载火箭技术专家）获2021年度钱学森最高成就奖成就奖2023年，周建平（中国载人航天工程总设计师）获2022年度钱学森最高成就奖2024年，杨利伟（中国首飞航天员）获2023年度钱学森最高成就奖"], "shizhan": [{"q": "神舟二十号于2025年4月24日17时17分发射。下列说法正确的有几项？①神舟二十号飞船采用的电源是镉镍电池，与神舟十八号飞船不同②神舟二十号任务中首次进人太空开展实验的生物是涡虫③陈冬是中国执行载人航天任务次数最多的航天员④神舟二十号发射后将会在空间站形成两舱两船组合体③神舟二十号乘组包括陈冬、陈中瑞、王杰", "options": ["1", "2", "3", "4"], "a": 1, "e": "说法正确的有①③两项。本题可以用口诀（51）【神二十】口诀：中冬王；【3舱3船组合体】口诀：船变舱不变来解答。因此，选择B选项。"}]}, {"num": "4.05", "title": "天舟系列", "chapter": "第四章 科技知识", "koujue": ["口诀（52）天舟货运补给，八号九号接力"], "defs": ["天舟系列货运飞船负责为空间站（或空间实验室）运输补给物资和载荷、补加推进剂、在轨存", "概述储和下行废弃物资，任务结束后受控陨落于预定区域2024年11月15日，搭载天舟八号货运飞船的长征七号遥九运载火箭在我国文昌航天发射场点天舟八号火发射。约10分钟后，天舟八号货运飞船与火箭成功分离并进入预定轨道，之后飞船太阳能帆板顺利展开，发射取得圆满成功2025年7月15日，天舟九号搭载长征七号遥十运载火箭在文昌发射升空，成功对接于空间站天和核心舱后向端口。同日，神舟二十号航天员乘组进人天舟九号开展货物转运等相关工作。天天舟九号舟九号是空间站应用与发展阶段组批生产的第四艘货运飞船，承担着为神舟二十号和神舟二十一号乘组运送物资的任务，装载了航天员在轨驻留消耗品、推进剂、应用实验装置等物资，共约6.5吨，为空间站在轨运营和航天员长期驻留提供了有力保障和支撑"], "shizhan": [{"q": "关于中国天舟系列货运飞船，以下哪项说法是正确的？", "options": ["天舟九号货运飞船于2024年11月15日在西昌发射", "天舟八号货运飞船由长征五号运载火箭发射升空", "天舟货运飞船负责为空间站运输补给物资和载荷、补加推进剂、在轨存储和下行废弃物资", "天舟八号货运飞船的太阳能帆板在发射后未能展开，导致任务失败"], "a": 2, "e": "A项：2025年7月15日，搭载天舟九号货运飞船的长征七号遥十运载火箭，在我国文昌航天发射场点火发射。A项错误。B项：天舟八号由长征七号遥九运载火箭发射，不是长征五号。B项错误。C项：天舟货运飞船负责为空间站（或空间实验室）运输补给物资和载荷、补加推进剂、在轨存储和下行废弃物资，任务结束后受控陨落于预定区域。C项正确。D项：天舟八号发射后太阳能帆板顺利展开，任务取得圆满成功。D项错误。本题可以用口诀（52）天舟货运补给，八号九号接力来解答。因此，选择C选项。"}]}, {"num": "4.06", "title": "嫦娥六号", "chapter": "第四章 科技知识", "koujue": ["口诀（53）嫦娥六号文昌起，月球背面来探秘"], "defs": ["2020年11月，长征五号遥五运载火箭搭载“嫦娥五号”探测器在中国文昌航天发射场成功发射，并于2020年12月实现了中国首次月球无人采样返回，标志着中国探月工程“绕、落、回”三步", "嫦娥五号走战略的全面实现，展现深空探测领域自主创新能力。“嫦娥五号”月球样品为一类新的月海玄武岩2024年5月，“嫦娥六号”搭载长征五号遥八运载火箭在中国文昌航天发射场成功发射，开启世界首次月球背面采样返回之旅，并于2024年6月实现世界首次月球背面采样返回。嫦娥六号2025年3月21日，中国科学家通过“嫦娥六号”采回的月球背面月壤样品研究，确定月球最古老、最大的撞击遗迹南极一艾特肯盆地（SPA盆地）形成于42.5亿年前。该成果被国际权威期刊《自然》列为2025年度重大科学发现，属于国家重大科技专项的标志性成就"], "shizhan": [{"q": "我国探月工程中开启世界首次月球背面采样返回之旅的是：", "options": ["嫦娥六号", "娥五号", "嫦娥四号", "嫦娥三号"], "a": 0, "e": "本题可以用口诀（53）娣娥六号文昌起，月球背面来探秘来解答。因此，选择A选项。"}]}, {"num": "4.07", "title": "科技奖项", "chapter": "第四章 科技知识", "koujue": ["口诀（54）诺奖瑞典立，六类分高低。物化和生理，文学加经济。候选需保密，防止有争议"], "defs": ["世界科技奖项诺贝的。诺贝尔奖包括物理学奖、化学奖、和平奖、生理学或医学奖、文学奖、经济学奖。①诺贝尔奖是根据瑞典化学家诺贝尔的遗嘱设立的。是以诺贝尔的部分遗产作为基金在1900年创立尔奖诺贝尔奖遵循的原则是，除了公布最终获奖者外，候选人的名单都不对外公开，并设置了50年的保密期。②12月10日是诺贝尔逝世纪念日，每年这天（除因战时中断外）分别在瑞典斯德哥尔摩和挪威奥斯陆举行诺贝尔奖的授奖仪式。诺贝尔生理学或医学奖、物理学奖、化学奖、文学奖、经济学奖在瑞典首都斯德哥尔摩颁发，诺贝尔和平奖在挪威首都奥斯陆颁发。诺贝③中国籍获奖者：杨振宁（1957年，诺贝尔物理学奖，与李政道一起）、莫言（2012年，诺贝尔文", "尔奖学奖）、屠呦呦（2015年，诺贝尔生理学或医学奖，分离出青蒿素用于疟疾治疗）。两次获得诺贝尔奖的有：居里夫人、莱纳斯·鲍林、约翰·巴丁、弗雷德里克·桑格和卡尔·巴里·夏普莱斯①菲尔兹奖一数学界②图灵奖一一计算机界（专门奖励对计算机事业作出重要贡献的个人，被誉为“计算机界的诺贝尔奖”）其他③普利策奖一一新闻界（被誉为“新闻界的诺贝尔奖”）奖项④南丁格尔奖-护理界③劳伦斯奖—体育界?普利兹克奖一建筑界①拉斯克奖医学界国家最高科学技术奖是中国五个国家科学技术奖（国家最高科学技术奖、国家自然科学奖、国家技术发明奖、国家科学技术进步奖、中华人民共和国国际科学技术合作奖）中最高等级的奖项，于概况2000年设立，每年评选一次。国家最高科学技术奖由国家主席签署并颁发奖章、证书和奖金，奖金额由国务院规定（目前为800万元）①首届获奖者袁隆平（获得“共和国勋章”“杂交水稻之父”）、吴文俊（数学家）。②2023年度获奖者李德仁（地球空间信息领域）、薛其坤（凝聚态物理领域，首次实现了量子反常霍尔效应）。获奖③其他部分获奖者王选（“当代毕昇”）、吴孟超（“中国肝胆外科之父”）。（之国中，之国中，国，）程开甲（获得“八一勋章”“两弹一星”元勋）、于敏（“共和国勋章”“中国氢弹之父”）。屠呦呦（获得“共和国勋章”，研究发现了青蒿素，获得2015年诺贝尔生理学或医学奖）。黄旭华（获得“共和国勋章”“中国核潜艇之父”）"], "shizhan": [{"q": "下列关于诺贝尔奖的表述不正确的是：", "options": ["诺贝尔奖是以瑞典著名化学家、硝化甘油炸药的发明人诺贝尔的部分遗产作为基金在1900年创立的", "根据诺贝尔的遗嘱，诺贝尔奖分设了物理、化学、生理或医学、文学、和平五个奖项", "12月10日是诺贝尔逝世纪念日，每年这天（除因战时中断外）分别在瑞典斯德哥尔摩和挪威奥斯陆举行诺贝尔奖的授奖仪式", "诺贝尔奖除了公布最终获奖者，也同时公布候选人名单"], "a": 3, "e": "本题可以用口诀（54）诺奖瑞典立，六类分高低。物化和生理，文学加经济。候选需保密，防止有争议来解答。因此，选择D选项。"}, {"q": "【多选】世界著名的诺贝尔奖的奖项包括：", "options": ["生物学奖", "物理学奖", "和平奖", "经济学奖"], "a": "BCD", "e": "诺贝尔奖是指根据诺贝尔1895年的遗瞩而设立的五个奖项，包括：物理学奖、化学奖、和平奖、生理学或医学奖和文学奖。其旨在表彰在物理学、化学、和平、生理学或医学以及文学上“对人类作出最大贡献”的人士。瑞典中央银行1968年设立的诺贝尔经济学奖，用于表彰在经济学领域作出杰出贡献的人。其中不包括生物学奖。本题可以用口决（54）诺奖瑞典立，六类分高低。物化和生理，文学加经济来解答。因此，选择BCD选项。"}]}, {"num": "4.08", "title": "科考站", "chapter": "第四章 科技知识", "koujue": ["口诀（55）南极长城开先河，中山圈内极光多，昆仑冰穹最高冷，泰山中继连脉络，秦岭太平", "洋开拓，北极黄河看熊窝，中冰北极已联合"], "defs": ["两船七站一基地“雪龙”号于1993年由乌克兰赫尔松船厂建造完工，中国从乌克兰购得后经改装而成，1994年开始执行中国的南极考察任务。2015年11月7日，中国南极科学考察队乘“雪龙”号破冰", "雪龙号船，赴南极执行科考任务，继长城站、中山站、昆仑站和泰山站之后，中国第五座南极考察站在此次科考中确定选址两船“雪龙2”号极地考察船（H2560）是中国第一艘自主建造的极地科学考察破冰船，是全球第一艘采用船、船瞩双向破冰技术的极地科考破冰船，能够在1.5米厚的冰层中连续破冰航行。2016年12月20日开工，2018年9月10日正式在上海下水。2019年7月交付并首航南极。雪龙2号2019年10月，中国第36次南极科学考察启程。本次考察实施两船四站考察任务，我国首艘自主建造的极地科学考察破冰船一一“雪龙2”号将与“雪龙”号一起“双龙探极”，开启中国极地考察新格局“一基地”指位于上海浦东的中国极地考察国内基地（负责极地考察后勤保障），中国所有极地科考任务（如南极站补给、北极考察）均从该基地出发，是连接国内与极地的“大本营”。同时服务“雪龙”基地号和“雪龙2”号，保障双船协同运作。“一基地”是我国极地科考体系的国内后勤中枢，是支撑“双龙探极”及多站联动的战略基础设施。1985年2月，我国第一个南极科考站一长城站在南极洲乔治王岛菲尔德斯半岛南部建设完成。位于南极圈外的乔治王岛，无极昼极夜现象。地球上最后一个被发现，唯一没有人定居，", "长城站被人们称为第七大陆的洲是南极洲。南极洲位于地球南端，四周被南冰洋所包围，全洲无定居居民，只有来自世界各地的科学考察人员和捕鲸队中山站建立于1989年2月26日，是中国第二个南极考察站，位于南极圈内的拉斯曼丘陵。由于其特殊的地理位置，在极夜期间，更容易观测到极光现象。极光由太阳风与地球磁场和高层", "中山站大气相互作用产生，南极圈内是观赏极光的理想区域之一，所以中山站有较多机会欣赏到绚丽南极多彩的极光", "科考昆仑站是南极内陆冰盖最高点上的科学考察站。昆仑站的纬度最高，它最接近极点，是我国南昆仑站极科考站中距南极点最近的科考站。昆仑站位于冰穹A地区，极度缺氧，平均气温常年在零下30摄氏度以下，被称为“人类不可到达的生命禁区”泰山站是继长城站、中山站、昆仑站之后中国的第四个南极科学考察站。2014年1月3日，“泰山站”完成主体封顶；2014年2月8日上午11点，中国海洋局宣布，中国南极泰山站正式泰山站建成开站。泰山站位于中山站与昆仑站之间的伊丽莎白公主地，距离中山站约520公里，海拔高度约2621米，是一座南极内陆考察的度夏站。泰山站是南极内陆考察的中转站，支撑冰盖深空探测和物资补给。①2024年2月7日，南极大陆的新地标一中国南极秦岭站开站，这是中国第五个南极考察站。习近平总书记强调，更好地认识极地、保护极地、利用极地，为造福人类、推动构建人类南极命运共同体作出新的更大的贡献。科考秦岭站②秦岭站的主体设计为南十字星造型，设计理念源自中国航海家郑和下西洋使用的南十字星导航。③秦岭站是我国继长城站、中山站之后第三个常年考察站；是我国首个面向太平洋扇区的考察站；是新时代我国建成的第一个越冬考察站黄河站建成于2004年7月28日，是中国首个北极科考站，北极黄河站拥有全球极地科考中规模最大的空间物理观测点，位于挪威斯匹次卑尔根群岛。该地区处于北极圈以北，是北极熊等", "黄河站北极动物的栖息地。在黄河站周边，有机会观察到北极熊等极地动物。黄河站研究重点是生北极态、冰川、海洋科考中冰联合北极科学考察站（简称“中冰站”）是中国与冰岛合作建立的北极科学考察站，2018年10月，正式揭牌。中冰站位于冰岛北部城市阿克雷里附近，是中国在北极地区继黄河站之", "中-冰后的第二个重要科研基地，也是中国首个与其他国家联合运营的北极科考站。合作建站是我国北极站参与北极治理、提升国际科研话语权的重要举措。中冰联合管理，研究重点是北极气候变化、大气与空间物理、冰川与海洋环境、极光观测等。"], "shizhan": [{"q": "根据我国极地科考站布局特点，以下选项中描述错误的是：", "options": ["长城站一中国首个南极科考站，建于乔治王岛", "秦岭站中国首个面向大西洋的南极常年站", "昆仑站一位于南极冰穹A地区，开展深冰芯钻探", "中-冰北极站中冰联合建设，研究极光与大气科学"], "a": 1, "e": "本题可以用口诀（55）南极长城开先河，中山圈内极光多，昆仑冰穹最高冷，泰山中继连脉络，秦岭太平洋开拓，北极黄河看熊窝，中冰北极已联合来解答。因此，选择B选项。"}]}]}, {"name": "第五章 法律知识", "entries": [{"num": "5.01", "title": "法的作用", "chapter": "第五章 法律知识", "koujue": ["口诀（56）法的作用：指评教预强（谐音：只凭教育强）", "指引自已，评价他人，预测你我他，教育大多数，强制一小撮"], "defs": ["法具有指引、评价、预测、教育和强制五种规范作用。指引作用，是指法对本人行为起到导向、引路的作用。指引作用对象是每个人自已的行为。根据指引作用法律规范的行为模式，分为确定的指引和有选择的指引。其中，义务模式对人们行为的指引是确定的指引，而权利模式对人们行为的指引是有选择的指引，即不确定的指引评价作用评价作用，是指法律作为人们对他人行为的评价标准所起的作用。评价作用对象是他人的行为预测作用，是指人们根据法律可预先估计人们相互间将怎样行为以及行为的后果等，从而对自已", "预测作用的行为作出合理的安排。预测作用对象是人们的相互行为教育作用，是指通过法律的实施，使法律对一般人的行为产生影响。教育作用对象是一般人的", "教育作用行为强制作用，是指法可以用来制裁、约束违法犯罪行为。法的强制作用是法律其他规范作用的保证。", "强制作用其作用对象是违法犯罪者的行为"], "shizhan": [{"q": "法的规范作用包括指引、（）作用。", "options": ["评价、惩罚、强制、教育", "评价、教育、预测、惩罚", "教育、强制、鼓励、预测", "评价、预测、教育、强制"], "a": 3, "e": "本题考查口诀（56）法的作用：指评教预强。因此，选择D选项。"}, {"q": "【单选】大学生李某的一项发明获省级科技竞赛一等奖，为防止该项发明被他人非法利用，李某依法申请了专利。李某的做法所体现的法的作用是：", "options": ["指引作用", "评价作用", "教育作用", "强制作用"], "a": 0, "e": "法的指引作用是指法通过授权性或义务性规范来使人们明确其在法律上的权利和义务，进而对本人的行为起到引路和导向作用。“依法申请专利”体现了法对李某行为的指引作用。本题考查口诀（56）指引自己，评价他人，预测你我他，教育大多数，强制一小撮。因此，选择A选项。"}]}, {"num": "5.02", "title": "国家机构", "chapter": "第五章 法律知识", "koujue": ["口诀（57）改变与撤销：", "领导关系：上级既可撤销也可改变下级立法", "监督关系：上级只能撤销不能改变下级立法"], "defs": ["全国最高的权力机关、立法机关。全国人大和全国人大常委会之间的关系是领导和被领导关系。", "全国人大（全国人大可以改变或者撤销全国人大常务委员会不适当的决定）全国人民代表大会的常设机关，不是一个独立的立法机关，在全国人民代表大会闭会期间行使全国人大最高国家权力。全国人大常委会与全国人大是隶属关系。全国人大常委会和地方人大常委会是常委会监督和被监督关系。全国人大常委会和国务院之间是监督和被监督关系（全国人大常委会有权撤销国务院制定的同宪法、法律相抵触的行政法规、决定和命令）性质：中华人民共和国主席是我国的国家元首，包括国家主席和副主席。是我国国家机构的重", "国家主席要组成部分。对外代表中华人民共和国中央军委性质：全国武装力量的最高领导机关。军委主席没有任期限制，对全国人大及其常委会负责国务院性质：最高国家行政机关，中央人民政府。职权：制定行政法规，发布决定和命令等法院性质：审判机关。领导体制：上下级法院是监督与被监督关系检察院性质：法律监督机关。领导体制：上下级检察院之间是领导与被领导关系监察委员会性质：监察机关。领导体制：上下级监察委员会之间是领导与被领导的关系"], "shizhan": [{"q": "《宪法》规定，国务院对各部、委员会发布的不适当的命令、指示和规章有权（）", "options": ["改变", "发回", "改变或撤销", "撤销"], "a": 2, "e": "《宪法》第八十九条第十三项规定，国务院对各部、各委员会发布的不适当的命令、指示和规章有权改变或撤销。本题考查口诀（57）领导关系：上级既可撤销也可改变下级立法。因此，选择C选项。"}, {"q": "【单选】全国人大常委会有权（）国务院制定的同宪法、法律相抵触的行政法规、决定和命令。", "options": ["改变", "撤销", "改变或撤销", "发回"], "a": 1, "e": "《宪法》第六十七条第七项规定，全国人大常委会有权撤销国务院制定的同宪法、法律相抵触的行政法规、决定和命令。本题考查口诀（57）监督关系：上级只能撤销不能改变下级立法。因此，选择B选项。"}]}, {"num": "5.03", "title": "国家制度", "chapter": "第五章 法律知识", "koujue": ["口诀（58）选举制度：普遍平等与秘密，公民十八有权利。直选间选县为界，城乡同票一比", "，差额选举有效力"], "defs": ["中华人民共和国是工人阶级领导的、以工农联盟为基础的人民民主专政的社会主义国家。国体我国的国体是人民民主专政政体是国家政权的组织形式，即统治阶级为实现其统治而采用的国家政权机关的组织体系和运作方式。国体决定政体，政体反映国体。我国的政体是人民代表大会制度。人民代表大政体会制度是我国的根本政治制度，是我国人民民主专政的政权组织形式，中华人民共和国的一切权力属于人民。人民行使国家权力的机关是全国人民代表大会和地方各级人民代表大会根本制度社会主义制度是中华人民共和国的根本制度中国的政党制度是中国共产党领导的多党合作和政治协商制度。中国人民政治协商会议是中国人民爱国统一战线的组织，是中国共产党领导的多党合作和政党制度政治协商的重要机构。共产党是执政党，民主党派是参政党，中国共产党同各民主党派合作的十六字方针是“长期共存、互相监督、肝胆相照、荣厚与共”（1）选举权的普遍性原则①凡年满18周岁的中华人民共和国公民，除依法被剥夺政治权利的人以外，不分民族、种族、性别、职业、家庭出身、宗教信仰、教育程度、财产状况和居住期限，都享有选举权和被选举权。②精神病人享有选举权，不能行使选举权的，经选举委员会确认，不列人选民名单（2）选举权的平等性原则①在一次选举中选民平等地拥有相同的投票权。②原则上每一代表所代表的选民人数相同（3）直接选举和间接选举并用的原则直接选举，即由选民直接选举人大代表。不设区的市、市辖区、县、自治县、乡、民族乡、镇的人民代表大会的代表，由选民直接选举。选举制度间接选举，即由下一级人民代表大会选举上一级人民代表大会代表。全国人民代表大会的代表，省、自治区、直辖市、设区的市、自治州的人民代表大会的代表，由下一级人民代表大会选举（4）秘密投票原则全国和地方各级人民代表大会代表的选举，一律采用无记名投票的方法（5）差额选举原则指候选人的人数多于应选代表的名额，给选民提供更多选择空间，促进候选人之间的竞争，避免“等额选举”可能导致的形式化", "选举程序：①直接选举：采取双过半原则在选民直接选举人民代表大会代表时，选区全体选民的过半数参加投票，选举有效。代表候选人获得参加投票的选民过半数的选票时，始得当选。②间接选举：代表候选人获得全体代表过半数的选票时，始得当选①民族自治地方：自治区、自治州、自治县。②自治机关：民族自治地方的自治机关是自治区、自治州、自治县的人民代表大会和人民政府。", "民族区域③领导担任：自治区、自治州、自治县的人民代表大会常务委员会中应当有实行区域自治", "自治制度的民族的公民担任主任或者副主任。自治区主席、自治州州长、自治县县长由实行区域自治的民族的公民担任特别行政区拥有高度自治权，主要有行政管理权、立法权、独立的司法权和终审权，但是特别行政区制度不拥有外交权和防务权基层群众居民委员会和村民委员会是我国的基层群众自治组织，居民委员会、村民委员会的主任、自治制度副主任和委员由居民选举"], "shizhan": [{"q": "【多选】下列哪几项是我国选举制度的基本原则？", "options": ["选举权的普遍性原则", "选举权的平等性原则", "公开投票原则", "直接选举和间接选举并用原则"], "a": "ABD", "e": "C项中的公开投票原则不是我国选举制度的基本原则。本题可以利用口诀（58）选举制度：普遍平等与秘密，公民十八有权利。直选间选县为界，城乡同票一比一，差额选举有效力，快速"}]}, {"num": "5.04", "title": "全国人大", "chapter": "第五章 法律知识", "koujue": ["口诀（59）全国人大职权：一批一改二审三法五选五决定", "主席提名定总理，总理提名定兄弟（副务员部审总秘）"], "defs": ["性质和地位全国人大是国家最高权力机关、立法机关修改宪法。由全国人民代表大会常务委员会或者五分之一以上的全国人民代表大会代表提议，并由全国人民代表大会以全体代表的三分之二以上的多数通过监督宪法的实施", "职权制定和修改刑事、民事、国家机构的和其他的基本法律。法律和其他议案由全国人民代表大会以全体代表的过半数通过选举中华人民共和国主席、副主席根据中华人民共和国主席的提名，决定国务院总理的人选；根据国务院总理的提名，决定国务院副总理、国务委员、各部部长、各委员会主任、审计长、秘书长的人选选举中央军事委员会主席；根据中央军事委员会主席的提名，决定中央军事委员会其他组成人员的人选选举国家监察委员会主任选举最高人民法院院长选举最高人民检察院检察长职权审查和批准国民经济和社会发展计划和计划执行情况的报告审查和批准国家的预算和预算执行情况的报告改变或者撤销全国人民代表大会常务委员会不适当的决定批准省、自治区和直辖市的建置决定特别行政区的设立及其制度决定战争和和平的问题应当由最高国家权力机关行使的其他职权"], "shizhan": [{"q": "根据《宪法》规定，有权修改宪法的国家机关是（）", "options": ["国务院", "全国政协", "全国人大", "全国人大常委会"], "a": 2, "e": "《宪法》第六十二条第一项规定，全国人民代表大会有权修改宪法。本题考查口诀（59）全国人大职权：一批一改二审三法五选五决定中的“三法”。因此，选择C选项。"}]}, {"num": "5.05", "title": "全国人大常委会", "chapter": "第五章 法律知识", "koujue": ["口诀（60）全国人大常委会职权：一个制定，两个解释，两个监督，两个撤销，两个规定，三", "个提请，五个闭会期间，五个决定"], "defs": ["全国人大常委会是全国人民代表大会的常设机关，在全国人民代表大会闭会期间行使最高国", "性质和地位家权力机关的部分职权。全国人大常委会与全国人大是隶属关系（1）全国人大常委会由委员长、副委员长若干人、秘书长、委员若干人组成。他们都由每届全国人大第一次会议主席团从代表中提出人选，常委会的组成人员不得担任国家行政机关、监察机关、审判机关和检察机关的职务。自第十届全国人大起，全国人大常委会还增设了若", "组成和任期干专职委员。（2）全国人大常委会的任期与全国人大相同，即五年。委员长、副委员长连续任职不得超过两届解释宪法，监督宪法的实施制定和修改除应当由全国人民代表大会制定的法律以外的其他法律在全国人民代表大会闭会期间，对全国人民代表大会制定的法律进行部分补充和修改，但是不得同该法律的基本原则相抵触解释法律在全国人民代表大会闭会期间，审查和批准国民经济和社会发展计划、国家预算在执行过程中所必须作的部分调整方案监督国务院、中央军事委员会、国家监察委员会、最高人民法院和最高人民检察院的工作职权撤销国务院制定的同宪法、法律相抵触的行政法规、决定和命令撤销省、自治区、直辖市国家权力机关制定的同宪法、法律和行政法规相抵触的地方性法规和决议在全国人民代表大会闭会期间，根据国务院总理的提名，决定部长、委员会主任、审计长、秘书长的人选在全国人民代表大会闭会期间，根据中央军事委员会主席的提名，决定中央军事委员会其他组成人员的人选根据国家监察委员会主任的提请，任免国家监察委员会副主任、委员根据最高人民法院院长的提请，任免最高人民法院副院长、审判员、审判委员会委员和军事法院院长根据最高人民检察院检察长的提请，任免最高人民检察院副检察长、检察员、检察委员会委员和军事检察院检察长，并且批准省、自治区、直辖市的人民检察院检察长的任免决定驻外全权代表的任免决定同外国缔结的条约和重要协定的批准和废除规定军人和外交人员的衔级制度和其他专门衔级制度规定和决定授予国家的勋章和荣誉称号", "职权决定特赦在全国人民代表大会闭会期间，如果遇到国家遭受武装侵犯或者必须履行国际间共同防止侵略的条约的情况，决定战争状态的宣布决定全国总动员或者局部动员决定全国或者个别省、自治区、直辖市进人紧急状态全国人民代表大会授予的其他职权"], "shizhan": [{"q": "下列职权中，不属于全国人民代表大会常务委员会行使的是：", "options": ["决定全国进入紧急状态", "决定驻外全权代表的任免", "选举最高人民检察院检察长", "规定和决定授予国家的勋章和荣誉称号"], "a": 2, "e": "我国《宪法》规定，由全国人民代表大会选举最高人民检察院检察长。本题考查口诀（59）全国人大职权：一批一改二审三法五选五决定中的“五选”。因此，选择C选项。"}, {"q": "【单选】我国宪法的解释权由（)行使。", "options": ["国家主席", "最高人民法院", "最高人民检察院", "全国人民代表大会常务委员会"], "a": 3, "e": "本题考查口诀（60），全国人大常委会职权：一个制定，两个解释，两个监督，两个撤销，两个规定，三个提请，五个闭会期间，五个决定。因此，选择D选项。"}]}, {"num": "5.06", "title": "中华人民共和国主席", "chapter": "第五章 法律知识", "koujue": ["口诀（61）国家主席职权：公布权、任免权、外事权、荣典权"], "defs": ["中华人民共和国主席是我国的国家元首，是我国国家机构的重要组成部分。对外代表中华人民性质和地位共和国。国家主席并不是一个职务，而是一个国家机构。我国国家元首职权由国家主席与全国人民代表大会常务委员会共同行使（外事权）代表国家，进行国事活动（外事权）代表国家，接受外国使节（公布权）根据全国人大常委会的决定，宣布批准或废除条约和重要协定（公布权）公布法律，发布命令（公布权）发布特赦令、宣布进人紧急状态、动员令、宣布战争状态等职权（任免权）国务院总理、副总理、国务委员、各部部长、各委员会主任、审计长、秘书长，经全国人大或全国人大常委会正式确定人选后，由国家主席宣布其任职或免职。国家主席根据全国人大常委会的决定，派出或召回驻外大使（荣典权）根据全国人大常委会的决定，代表国家向那些对国家有重大功勋的人授予荣誉奖章和光荣称号。注：国家主席行使职权须以全国人大或全国人大常委会的决定为依据，主要采取主席令的形式"], "shizhan": [{"q": "我国《宪法》规定，公布法律的权力属于：", "options": ["国务院", "国家主席", "全国人民代表大会", "全国人大常委会"], "a": 1, "e": "本题考查口诀（61）国家主席职权：公布权、任免权、外事权、荣典权中的“公布权”。因此，选择B选项。"}]}, {"num": "5.07", "title": "公民的基本权利", "chapter": "第五章 法律知识", "koujue": ["口诀（62）人身自由权：秘宅格生肉"], "defs": ["《宪法》第三十三条第二款规定，中华人民共和国公民在法律面前一律平等。平等权体现在社会生活的各个方面，如政治权利平等、经济机会平等、社会生活中的平平等权等对待等。公民依法享有平等权，以保障自身在社会中的公平地位和发展机会。注意：不能将平等视为平均主义，不允许任何区别对待，平等权也不意味着部分弱者可以享有法律特权选举权和被选举权是我国公民最基本的政治权利政治权利和自由政治自由包括言论、出版、集会、结社、游行、示威的自由", "监督权和获得监督权和获得赔偿权包括批评权、建议权、申诉权、控告权、检举权以及获得赔偿权", "赔偿权", "①自主选择权：中华人民共和国公民有宗教信仰自由。②禁止强制与歧视：任何国家机关、社会团体和个人不得强制公民信仰宗教或者不信仰宗教，不得歧视信仰宗教的公民和不信仰宗教的公民。", "宗教信仰自由③合法宗教活动受保护：国家保护正常的宗教活动。任何人不得利用宗教进行破坏社会秩序、损害公民身体健康、妨碍国家教育制度的活动。④宗教事务独立原则：宗教团体和宗教事务不受外国势力的支配①生命权。②人身自由不受侵犯。A.任何公民，非经人民检察院批准或者决定或者人民法院决定，并由公安机关执行，不受逮捕。B.禁止非法拘禁和以其他方法非法剥夺或者限制公民的人身自由，禁止非法搜查公民的身体③公民的住宅不受侵犯。人身自由权禁止非法搜查或者非法侵入公民的住宅④人格尊严不受侵犯。禁止用任何方法对公民进行侮辱、诽谤和诬告陷害③公民的通信自由和通信秘密受法律的保护。除因国家安全或者追查刑事犯罪的需要，由公安机关或者检察机关依照法律规定的程序对通信进行检查外，任何组织或者个人不得以任何理由侵犯公民的通信自由和通信秘密。例：李某系刘某的姐姐，某日李某在家时收到快递邮来的信件，信件收件人是刘某，李某在未经刘某同意的情况下拆开阅读，李某的行为侵犯了刘某的通信秘密劳动权：公民有劳动的权利和义务，国家通过各种途径创造劳动就业条件，加强劳动保护，改善劳动条件，并在发展生产的基础上提高劳动报酬和福利待遇（《宪法》第四十二条）休息权：劳动者有休息的权利，国家发展劳动者休息和休养的设施，规定职工的工作时间和休假制度（《宪法》第四十三条）社会经济权利获得物质帮助权：公民在年老、疾病或丧失劳动能力时，有从国家和社会获得物质帮助的权利。国家发展为公民享受这些权利所需要的社会保险、社会救济社会经济、文化和医疗卫生事业（《宪法》第四十五条）教育方面的权利财产权：公民的合法的私有财产不受侵犯。国家依照法律规定保护公民的私有财产权和继承权。国家为了公共利益的需要，可以依照法律规定对公民的私有财产实行征收或征用并给予补偿（《宪法》第十三条）受教育权：公民有受教育的权利和义务。国家培养青年、少年、儿童在品德、智力、体质等方面全面发展（《宪法》第四十六条）文化教育权利文化权利和自由：公民有进行科学研究、文学艺术创作和其他文化活动的自由。国家对于从事教育、科学、技术、文学、艺术和其他文化事业的公民的有益于人民的创造性工作，给以鼓励和帮助（《宪法》第四十七条）"], "shizhan": [{"q": "公民的人格尊严不受侵犯的权利属于公民的基本权利和自由中的：", "options": ["平等权", "政治权利和自由", "人身自由权", "其他权利"], "a": 2, "e": "《宪法》第三十八条规定，中华人民共和国公民的人格尊严不受侵犯。禁止用任何方法对公民进行侮辱、诽谤和诬告陷害。公民的人格尊严不受侵犯的权利属于公民的基本权利和自由中的人身自由权。本题考查口诀（62）人身自由权：秘宅格生肉中的“格”。因此，选择C选项。"}]}, {"num": "5.08", "title": "宪法修正案与宪法史", "chapter": "第五章 法律知识", "koujue": ["口诀（63）1988年：私营经济是补充，土地使用可转让", "1993年：初级特色政协商，五县联产立市场", "1999年：法治邓论分配多，私营统分危国上", "2004年：三个代表乡里变，社保人权土地偿", "2018年：党领导就是本质的特征，党领导一切写进宪法中。新时代的核心价值观，五千年的文", "明代代传。新宪法增加就职要宣誓，主席任期和人大要一致。国务院有了新的职权，生态文明建设", "更精彩", "口诀（64）5次宪法修正案：88年99年93年04年18年（谐音：爸爸舅舅小三小四要发）"], "defs": ["（一）前四次《宪法修正案》时间基本政治制度基本经济制度其他①私营经济是补充，保护合1988年法权益，国家引导、监督、管理；②土地使用权转让③国营改国有；④家庭联产①正处初级阶段，中国特色，宪法修正案治协商主管理义市场经济；集体独立，民1993年改革开放；②多党合作，政承包责任制；③实行社会主@县三改五③发展社会主义市场经济，①长期初级，沿着建设中特按劳分配为主，多种分配并1999年道路，邓小平理论；②法治存；④统分结合；③个体私③反革命改危害国家安全国家营重要，保护合法权益，国家引导、监督、管理时间基本政治制度基本经济制度其他③保护合法私有财产权，征宪法修正案①沿着特色，三个代表；收征用并补偿；③非公经济，人权制度；③特区人大代④为公共利益需要，对土地征收征用并补偿；②社保制度；2004年②政治文明；③社会主义事保护合法权益，国家鼓励、支表；戒严改成紧急状态；业建设者持、引导、监督、管理①主席国事活动；②乡三改五；增国歌（二）2018年第五次《宪法修正案》①删主席副主席不超两届①在马列毛邓三科习近平新时代中国特色社会①设区的市可定地方性法规主义思想指引下增监察委员会②和谐美丽现代化强国/伟大复兴增人大产生监察机关③致力复兴的爱国者①④删国务院/县以上政府监察职能④①平等团结互助和谐民族关系2018年①增人大常委监督监察委职能③倡导社会主义核心价值观@增人大选举并署免监察委主任职能③宪法和法律委员会①)增人大常委会任免国家监察委副主任/委员职能①和平发展/互利共赢/命运共同体增人大常委不得担任监察机关职务③党领导是最本质的特征社会主义“法制”变社会主义“法治”③增就职要宣誓②国务院职权增加“生态文明建设”"], "shizhan": []}, {"num": "5.09", "title": "物权VS 债权", "chapter": "第五章 法律知识", "koujue": ["口诀（64）物权是绝对权/对世权/支配权，债权是相对权/对人权/请求权"], "defs": ["所有权：是所有人依法对自已财产所享有的占有、使用、收益和处分的权利。是绝对权（对世权）、支配权", "物权用益物权：土地承包经营权、建设用地使用权、宅基地使用权、地役权、居住权（民法典新增）担保物权：抵押权、质权、留置权债权是相对权（对人权）、请求权。包括合同之债、侵权行为之债、不当得利之债和无因管理", "债权之债"], "shizhan": []}, {"num": "5.10", "title": "抵押权VS质押权", "chapter": "第五章 法律知识", "koujue": ["口诀（65）抵押和质押区别：是否转移占有", "不得抵押的财产：公鸭争土鸡"], "defs": ["抵押人（即债区分原则（抵《民法典》第四百零一条：“抵押务人或第三人）动产权人在债务履行期限届满前，与押合同和抵约定担保不转移抵押人约定债务人不履行到期债抵押权人（即押权并非同物权占有务时抵押财产归债权人所有的，债权人）不动产时生效)只能依法就抵押财产优先受偿”", "抵押权下列财产不得抵押：（1）土地所有权；（2）宅基地、自留地、自留山等集体所有的土地使用权，但是法律规定可以抵押的除外；（3）学校、幼儿园、医疗机构等为公益目的成立的非营利法人的教育设施、医疗卫生设施和其他公益设施；（4）所有权、使用权不明或者有争议的财产；（5）依法被查封、扣押、监管的财产；（6）法律、行政法规规定不得抵押的其他财产出质人（即债《民法典》第四百二十八条：务人或第三人）动产区分原则（质“质权人在债务履行期限届满押合同和质约定担保前，与出质人约定债务人不履", "质权转移占有权并非同时物权行到期债务时质押财产归债权质权人（即债权利生效)人所有的，只能依法就质押财权人)产优先受偿”留置权人（即留置权债权人）动产法定担保转移占有留置的财产必须与债权人的债权物权有牵连关系债务人"], "shizhan": [{"q": "下列财产中，不能用于抵押的是：", "options": ["抵押人所有的机器", "抵押人依法有权处分的交通运输工具", "抵押人依法有权处分的国有的土地使用权", "抵押人所有，但因没有及时归还银行贷款被暂时查封扣押的房屋"], "a": 3, "e": "下列财产不得用于抵押：（1）土地所有权；（2）宅基地、自留地、自留山等集体所有的土地使用权，但是法律规定可以抵押的除外；（3）学校、幼儿园、医疗机构等为公益目的成立的非营利法人的教育设施、医疗卫生设施和其他公益设施；（4）所有权、使用权不明或者有争议的财产；（5）依法被查封、扣押、监管的财产；（6）法律、行政法规规定不得抵押的其他财产。本题考查口诀（65）不得抵押的财产：公鸭争土鸡。因此，选择D选项。"}]}, {"num": "5.11", "title": "诉讼时效VS追诉时效", "chapter": "第五章 法律知识", "koujue": ["口诀（66）三年有效期，四年有两际，五年人寿险，二十殊可延"], "defs": ["三年有效期：向人民法院请求保护民事权利的诉讼时效期间为三年。法律另有规定的，依照其规定四年有两际：4年（国际货物买卖合同和国际技术转让合同）五年人寿险：根据《保险法》规定，人寿保险的受益人向保险人请求给付保险金的诉讼时", "诉讼时效效期间为五年，自其知道或者应当知道保险事故发生之日起计算二十殊可延：诉讼时效期间自权利人知道或者应当知道权利受到损害以及义务人之日起计算。法律另有规定的，依照其规定。但是自权利受到损害之日起超过二十年的，人民法院不予保护，有特殊情况的，人民法院可以根据权利人的申请决定延长（1）法定最高刑为不满5年有期徒刑的，追诉时效的期限为5年；（2）法定最高刑为5年以上不满10年有期徒刑的，追诉时效期限为10年；刑法追诉时效（3）法定最高刑为10年以上有期徒刑的，追诉时效的期限为15年；（4）法定最高刑为无期徒刑、死刑的，追诉时效的期限为20年；如果20年以后认为必须追诉的，报请最高人民检察院核准后，仍然可以追诉【判断】根据《中华人民共和国民法典》规定，一般向人民法院请求保护民事权利的普通诉讼时效期间为一年。（【解析】本题考查口诀（66）三年有效期，四年有两际，五年人寿险，二十殊可延。因此，本题错误。"], "shizhan": []}, {"num": "5.12", "title": "民事主体VS犯罪主体", "chapter": "第五章 法律知识", "koujue": ["口诀（67）十六到十八，自己挣钱自己花", "十二到十四，两故致死或残疾", "十四十六未成年，八种重罪要承担，杀抢爆炸和强奸，伤重致死别小看，放火投毒加毒贩，犯", "了必究莫等闲"], "defs": ["项目“无人”“限人”“完人”人<8周岁人≥18周岁8周岁≤人<18周岁无民事行为能力人16周岁≤人<18周岁（“十六到实施民事法律行为由其法定代理人代理或者实施的民事法律行经其法定代理人同意、追认；但是，可以独十八，自己挣钱自己花”，即已主体为无效。由其法定满16周岁不满18周岁的人能以立实施纯获利益的民事法律行为或者与其年代理人代理实施民自已的劳动收人养活自已的，龄、智力相适应的民事法律行为事法律行为视为完全民事行为能力人）项目“无人”“限人”“完人”①12周岁≤人<14周岁，犯故意杀人、故意伤害罪，致人死亡或者以特别残忍手段致人重伤造成严重残疾，情节恶劣，经最高人民检察院核准追诉的，应当负刑事责任。（口诀：两故致死或残疾）②14周岁≤人<16周岁（“两故、两抢、两犯罪人<12周岁火、两毒”：即只对八种行为负责一一故意杀人≥16周岁主体不负刑事责任人、故意伤害致人重伤或死亡、抢劫、强奸、放火、爆炸、贩卖毒品、投放危险物质）注：八罪指的是八种行为而非八个具体罪名，如14到16周岁的人对绑架罪不负责任，但是，如果在参与绑架的过程中有撕票行为，则应认定为故意杀人罪"], "shizhan": [{"q": "【多选】已满14周岁不满16周岁的人，犯下列哪些罪行应当负刑事责任？", "options": ["故意伤害致人轻伤", "抢劫", "贩卖毒品", "盗窃"], "a": "BC", "e": "已满十四周岁不满十六周岁的人，犯故意杀人、故意伤害致人重伤或者死亡、强奸、抢劫、贩卖毒品、放火、爆炸、投放危险物质罪的，应当负刑事责任。本题考查口（67）十四十六未成年，八种重罪要承担，杀抢爆炸和强奸，伤重致死别小看，放火投毒加毒贩，犯了必究莫等闲。因此，选择BC选项。"}, {"q": "【多选】根据《中华人民共和国刑法修正案（十一）》的规定，已满12周岁不满14周岁的未成年人承担刑事责任的事件是：", "options": ["所犯的罪为故意杀人，故意伤害罪", "情节恶劣", "所造成的结果是致人死亡或是以特别残忍手段致人重伤或造成严重残疾", "程序上要经最高人民检察院核准追诉"], "a": "ABCD", "e": "《刑法》第十七条规定，已满十二周岁不满十四周岁的人，犯故意杀人、故意伤害罪，致人死亡或者以特别残忍手段致人重伤造成严重残疾，情节恶劣，经最高人民检察院核准追诉的，应当负刑事责任。本题考查口诀（67）十二到十四，两故致死或残疾。因此，选择ABCD选项。"}]}, {"num": "5.13", "title": "宣告失踪 VS 宣告死亡", "chapter": "第五章 法律知识", "koujue": ["口诀（68）宣告失踪法律后果：财产代管制度", "宣告死亡法律后果：家破人亡妻子散，死亡撤销破镜圆，除非再婚或书面，有权请求财产返"], "defs": ["项目宣告失踪宣告死亡①一般情况下，下落不明满4年；②因意外事件下落不明的，满2年；自然人下落不③因意外事件下落不明，经有关机关证明该自然人不可能生存的，申请宣告死明满2年亡不受2年时间的限制。", "申请条件注意：对同一自然人，有的利害关系人申请宣告死亡，有的申请宣告失踪，符", "不同合宣告死亡条件的，人民法院应当宣告死亡有利害关系人申请人包括：①配偶；②父母、子女；③兄弟姐妹、祖父母、外祖父母、孙子的申请女、外孙子女；其他有民事权利义务关系的人须经法院宣告须经法院宣告项目宣告失踪宣告死亡“妻离子散，家破人亡”《民法典》第47条：对同一自然人，有的利害关系人申请宣告死亡，有的利害关系人申请宣告失踪，符合本法规定的宣告死亡条件的，人民法院应当宣告财产代管制度死亡。（为失踪人设《民法典》第48条：被宣告死亡的人，人民法院宣告死亡的判决作出之日视为立财产管理人，其死亡的日期；因意外事件下落不明宣告死亡的，意外事件发生之日视为其死有权代理失踪亡的日期。法律后果人从事一定的《民法典》第50条：被宣告死亡的人重新出现，经本人或者利害关系人申请，不同民事活动，包人民法院应当撤销死亡宣告。括代理失踪人《民法典》第51条：被宣告死亡的人的婚姻关系，自死亡宣告之日起消除。死履行债务和受亡宣告被撤销的，婚姻关系自撤销死亡宣告之日起自行恢复。但是，其配偶再领他人的履婚或者向婚姻登记机关书面声明不愿意恢复的除外。《民法典》第52条：被宣告死亡的人在被宣告死亡期间，其子女被他人依法收养的，在死亡宣告被撤销后，不得以未经本人同意为由主张收养行为无效《民法典》第53条：被撤销死亡宣告的人有权请求依照本法第六编取得其财产的民事主体返还财产；无法返还的，应当给予适当补偿注：宣告失踪不是宣告死亡的必经程序"], "shizhan": [{"q": "钟某因下落不明被法院依法宣告死亡，其财产被继承人继承，孩子被他人依法收养，妻子改嫁他人，后又离婚。6年后，钟某又回到住所地，法院根据钟某的申请撤销了对他的死亡宣告。关于本案，下列说法正确的是：", "options": ["钟某有权要求取得其遗产的人返还遗产", "钟某之子与他人的收养关系立即解除", "钟某与妻子的婚姻关系自行恢复", "撤销死亡宣告的申请只能由钟某的近亲属向法院提出"], "a": 0, "e": "《民法典》第五十三条规定，被撤销死亡宣告的人有权请求依照本法第六编取得其财产的民事主体返还财产；无法返还的，应当给予适当补偿。本题考查口诀（68）宣告死亡法律后果：家破人亡妻子散，死亡撤销破镜圆，除非再婚或书面，有权请求财产返。因此，选择A选项。"}]}, {"num": "5.14", "title": "行政诉讼VS行政复议", "chapter": "第五章 法律知识", "koujue": ["口诀（69）行政诉讼被告：复议维持的，共同告；复议不作为的，选择告；复议改变的，复议", "机关是被告"], "defs": ["【行政诉讼的被告】《行政诉讼法》第二十六条规定：“公民、法人或者其他组织直接向人民法院提起诉讼的，作出行政行为的行政机关是被告。经复议的案件，复议机关决定维持原行政行为的，作出原行政行为的行政机关和复议机关是共同被告；复议机关改变原行政行为的，复议机关是被告。复议机关在法定期限内未作出复议决定，公民、法人或者其他组织起诉原行政行为的，作出原行政行为的行政机关是被告；起诉复议机关不作为的，复议机关是被告。”【行政复议机关的确定】被申请人复议机关县级以上政府部门本级人民政府省级以下人民政府上一级人民政府垂直领导机关上一级主管部门省部级单位原机关自己政府派出机关设立该派出机关的人民政府县级以上政府部门派出机构本级人民政府直辖市/设区的市政府部门派出机构派出机构所在地的人民政府国务院部门设立的派出机构国务院部门本级政府或其工作部门授权的组织本级人民政府国务院部门授权的组织国务院部门"], "shizhan": [{"q": "刘某因工伤问题提出工伤认定申请，甲机关受理此申请，经核实认定刘某不属于工伤，后刘某向乙机关提出行政复议，乙机关经审查决定维持甲机关的行政行为。刘某不服，决定提起诉讼。则此案的被告是：", "options": ["甲机关", "乙机关", "甲机关和乙机关", "刘某的工作单位"], "a": 2, "e": "《行政诉讼法》第二十六条规定，公民、法人或者其他组织直接向人民法院提起诉讼的，作出行政行为的行政机关是被告。经复议的案件，复议机关决定维持原行政行为的，作出原行政行为的行政机关和复议机关是共同被告；复议机关改变原行政行为的，复议机关是被告。本案中，案件经过了复议，且乙机关决定维持甲机关的行政行为，故甲机关与乙机关是共同被告。本题考查口诀（69）行政诉讼被告：复议维持的，共同告；复议不作为的，选择告；复议改变的，复议机关是被告。因此，选择C选项。"}]}, {"num": "5.15", "title": "行政处罚 VS 行政处分 VS 刑罚", "chapter": "第五章 法律知识", "koujue": ["口诀（70）行政处罚种类：警告批评加罚款，没收违法非法严，降质暂扣吊证件，限制经营从", "业限，责令关闭和停产，再加行政拘留全"], "defs": ["（一）警告、通报批评；（二）罚款、没收违法所得、没收非法财物；（三）暂扣许可证件、行政处罚降低资质等级、吊销许可证件；（四）限制开展生产经营活动、责令停产停业、责令关闭、限制从业；（五）行政拘留；（六）法律、行政法规规定的其他行政处罚行政处分警告、记过、记大过、降级、撤职、开除管制（323）：管制的期限为三个月以上二年以下。数罪并罚时，最高不能超过三年拘役（161）：拘役的期限为一个月以上六个月以下，数罪并罚时，最高不能超过一年有期徒刑（615）：判决宣告以前一人犯数罪的，除判处死刑和无期徒刑的以外，应当在总和刑期以下、数刑中最高刑期以上，酌情决定执行的刑期，但是有期徒刑总和刑期不满三十五年的，最高不能超过二十年，总和刑期主刑在三十五年以上的，最高不能超过二十五年。一般情况下，有期徒刑的期刑罚限为六个月以上十五年以下无期徒刑死刑：包括死刑立即执行和死刑缓期二年执行。死刑适用于罪行极其严重的犯罪分子。除由最高人民法院判决以外，都应报最高院核准，死缓的，可以由省高院判决或核准三类人不适用死刑：犯罪时不满18周岁的人；审判时怀孕的妇女；审判时已满75周岁的人，但以特别残忍手段致人死亡的除外附加刑罚金、剥夺政治权利、没收财产以及只能适用于犯罪的外国人的驱逐出境"], "shizhan": [{"q": "【多选】下列属于行政处罚种类的有：", "options": ["没收财产", "警告、通报批评", "降低资质等级", "限制从业"], "a": "BCD", "e": "本题考查口诀（70）行政处罚种类：警告批评加罚款，没收违法非法严，降质暂扣吊证件，限制经营从业限，责令关闭和停产，再加行政拘留全。因此，选择BCD选项。"}]}, {"num": "5.16", "title": "行政强制措施VS 行政强制执行", "chapter": "第五章 法律知识", "koujue": ["口诀（71）行政强制措施：限封冻扣", "行政强制执行：加处滞纳不迟疑，划款拍卖解难题，排除妨碍复原状，代履行时找人替"], "defs": ["行政机关在行政管理过程中，为制止违法行为、防止证据损毁、避免危害发生、控制危险扩大等情形，依法对公民的人身自由实施暂时性限制，或者对公民、法人或其他组织的财行政强制措施物实施暂时性控制的行为种类：限制公民人身自由；查封场所、设施或财物；扣押财物；冻结存款、汇款；其他行政强制措施行政机关或行政机关申请法院，对不履行行政决定的公民、法人或其他组织，依法强制履行义务的行为", "行政强制执行种类：加处罚款或滞纳金；划拨存款、汇款；拍卖或依法处理查封、扣押的场所、设施或财物；排除妨碍、恢复原状；代履行；其他强制执行方式"], "shizhan": [{"q": "孔某驾驶一辆满载垃圾的货车经过某一路段时，车厢挡板松动，大量垃圾倾倒在公路上，严重危害交通安全且污染环境，当地交管部门及时协调专业人员将垃圾清除，之后责令孔某支付清除垃圾所产生的必要费用。当地交管部门采取的措施属于：", "options": ["行政征收", "行政强制执行", "行政强制措施", "行政摊派"], "a": 1, "e": "交管部门雇人清理孔某倾倒在公路上的垃圾并责令支付必要费用，属于行政强制执行中的代履行。本题考查口诀（71）行政强制执行：加处滞纳不迟疑，划款拍卖解难题，排除妨碍复原状，代履行时找人替。因此，选择B选项。"}, {"q": "【单选】某税务机关接到群众举报，称S有限公司涉嫌偷税漏税，为了开展调查，该税务机关冻结了S有限公司的银行存款，查封了其办公场所，并扣押了S有限公司其他全部财产。税务机关冻结S有限公司银行存款、查封场所的行为属于：", "options": ["行政强制措施", "行政确认", "行政强制执行", "行政处罚"], "a": 0, "e": "本题考查口诀（71）行政强制措施：限封冻扣。因此，选择A选项。"}]}, {"num": "5.17", "title": "犯罪未遂VS犯罪中止", "chapter": "第五章 法律知识", "koujue": ["口诀（72）未遂是欲达目的而不能，中止是能达目的而不欲"], "defs": ["项目犯罪未遂犯罪中止含义不同欲达目的而不能能达目的而不欲项目犯罪未遂犯罪中止（1）行为人主观上具有中止犯罪的决意；（1）行为人已经着手实行犯罪；（2）行为人客观上实施了中止犯罪的行为；构成要件不同（2）犯罪没有得；（3）犯罪中止必须发生在犯罪过程中，而不能发（3）犯罪未得是由于行为人意志以生在犯罪过程之外；外的原因（4）犯罪中止必须是有效地停止了犯罪行为或者有效地避免了危害结果"], "shizhan": [{"q": "甲与一女子有染，其妻乙生怨。某日，乙将毒药拌入饭菜中意图杀甲。甲食用有毒的饭菜后，乙因惧怕法律制裁遂将投毒实情告知甲，并送其去医院，经救治，甲基本无碍。乙的行为属于：", "options": ["犯罪中止", "犯罪未遂", "犯罪既遂", "犯罪预备"], "a": 0, "e": "犯罪中止必须是有效地停止了犯罪行为或者有效地避免了危害结果，本题甲食用有毒的饭菜后，乙因惧怕法律制裁遂将投毒实情告知甲，并送其去医院，经救治，甲基本无碍。很显然属于犯罪中止。本题考查口诀（72）未遂是欲达目的而不能，中止是能达目的而不欲。因此，选择A选项。"}]}, {"num": "5.18", "title": "刑罚的具体运用", "chapter": "第五章 法律知识", "koujue": ["口诀（73）一般累犯五年内，前后故意又犯罪。特别累犯危恐黑，刑毕再犯都算累。累犯应当", "从重锤，缓刑假释全作废"], "defs": ["一般累犯：前后罪都是故意犯罪；前后罪都被判处有期徒刑以上刑罚；后罪发生的时间，必须在前罪所判处的刑罚执行完毕或者赦免以后的五年之内累犯特别累犯：危害国家安全犯罪、恐怖活动犯罪、黑社会性质的组织犯罪的犯罪分子，在刑罚执行完毕或者赦免以后，在任何时候再犯上述任一类罪的，都以累犯论处。对累犯的处罚：应当从重处罚。累犯不适用缓刑、假释一般自首：犯罪以后自动投案；如实交代自己所犯的全部罪行自首特别自首：主体必须是被采取强制措施的犯罪嫌疑人、被告人和正在服刑的罪犯；必须如实供述司法机关还未掌握的本人其他罪行一般立功：是犯罪分子到案后检举、揭发他人犯罪行为，包括共同犯罪案件中的犯罪分子揭发同案犯共同犯罪以外的其他犯罪，经查证属实；提供侦破其他案件的重要线索，经查证属实；阻止他人犯罪活动；协助司法机关抓捕其他犯罪嫌疑人（包括同案犯）；具有其他有利于国家和社会的突出表现《刑法》第六十八条：犯罪分子有揭发他人犯罪行为，查证属实的，或者提供重要线索，从而得以侦立功破其他案件等立功表现的，可以从轻或者减轻处罚；有重大立功表现的，可以减轻或者免除处罚重大立功：犯罪分子检举、揭发他人重大犯罪行为，经查证属实；提供侦破其他重大案件的线索，经查证属实；阻止他人重大犯罪活动；协助司法机关抓捕其他重大犯罪嫌疑人（包括同案犯）；对一般是指犯罪嫌疑人、被告人可能被判处无期徒刑以上刑罚或者案件在本省、自治区、直辖市或者全国范围内有较大影响的情形条件：①犯罪分子被判处的刑罚是拘役或者是三年以下有期徒刑。②犯罪情节较轻，有悔罪表现，缓刑没有再犯罪的危险，宣告缓刑对所居住社区没有重大不良影响。③犯罪分子不是累犯和犯罪集团的首要分子减刑以后实际执行的刑期不能少于下列期限：（一）判处管制、拘役、有期徒刑的，不能少于原判刑期的二分之一；（二）判处无期徒刑的，不能少于十三年；", "减刑（三）人民法院依照《刑法》第五十条第二款规定，限制减刑的死刑缓期执行的犯罪分子，缓期执行期满后依法减为无期徒刑的，不能少于二十五年，缓期执行期满后依法减为二十五年有期徒刑的，不能少于二十年①假释只适用于被判处有期徒刑或者无期徒刑的犯罪分子。②被判处有期徒刑的犯罪分子，执行原判刑期二分之一以上，被判处无期徒刑的犯罪分子，实际执行十三年以上，才可以适用假释。如果有特殊情况，经最高人民法院核准，可以不受上述执行刑期的限制。", "假释③假释只适用于刑罚执行期间认真遵守监规，接受教育改造，确有悔改表现，没有再犯罪危险的犯罪分子。④对累犯以及因故意杀人、强奸、抢劫、绑架、放火、爆炸、投放危险物质或者有组织的暴力性犯罪被判处十年以上有期徒刑、无期徒刑的犯罪分子，不得假释"], "shizhan": [{"q": "【单选】蒋某因诈骗罪被判处9年有期徒刑，刑满释放后次年，又因盗窃罪被判处2年有期徒刑，并处罚金2000元。蒋某的行为在刑法上属于：", "options": ["初犯", "再犯", "累犯", "惯犯"], "a": 2, "e": "《刑法》第六十五条规定，被判处有期徒刑以上刑罚的犯罪分子，刑罚执行完毕或者赦免以后，在五年以内再犯应当判处有期徒刑以上刑罚之罪的，是累犯，应当从重处罚，但是过失犯罪和不满十八周岁的人犯罪的除外。本题中，蒋某因诈骗罪被判处9年有期徒刑，刑满释放后次年又因盗窃罪被判处2年有期徒刑，符合累犯的构成要件。本题考查口诀（73）一般累犯五年内，前后故意又犯罪。因此，选择C选项。"}]}, {"num": "5.19", "title": "治安管理处罚法", "chapter": "第五章 法律知识", "koujue": ["口诀（74）十六到十八，限人初违法，严重恶劣才处罚。七十岁老人，十四岁小娃，一年两违", "法，恶劣都处罚，例外有一个，哺乳期妈妈"], "defs": ["2025年6月27日，第十四届全国人大常委会第十六次会议表决通过新修订的《治安管", "实施时间理处罚法》，自2026年1月1日起施行《治安管理处罚法》第十九条：为了免受正在进行的不法侵害而采取的制止行为，造成重构“被殿打还手损害的，不属于违反治安管理行为，不受处罚；制止行为明显超过必要限度，造成较大即互殴”的认定标准损害的，依法给予处罚，但是应当减轻处罚；情节较轻的，不予处罚《治安管理处罚法》第八十九条：饲养动物，干扰他人正常生活的，处警告；警告后不改正的，或者放任动物恐吓他人的，处一千元以下罚款。违反有关法律、法规、规章规定，出售、饲养烈性犬等危险动物的，处警告；警告后不改正的，或者致使动物宠物伤人可直接伤害他人的，处五日以下拘留或者一千元以下罚款；情节较重的，处五日以上十日", "治安处罚以下拘留。未对动物采取安全措施，致使动物伤害他人的，处一千元以下罚款；情节较重的，处五日以上十日以下拘留。驱使动物伤害他人的，依照本法第五十一条的规定处罚《治安管理处罚法》第二十三条：违反治安管理行为人有下列情形之一，依照本法应当给予行政拘留处罚的，不执行行政拘留处罚：（一）已满十四周岁不满十六周岁的；14一18周岁严重（二）已满十六周岁不满十八周岁，初次违反治安管理的；（三）七十周岁以上的；", "违法可拘留（四）怀孕或者哺乳自已不满一周岁婴儿的。前款第一项、第二项、第三项规定的行为人违反治安管理情节严重、影响恶劣的，或者第一项、第三项规定的行为人在一年以内二次以上违反治安管理的，不受前款规定的限制《治安管理处罚法》第一百一十七条：公安机关作出吊销许可证件、处四千元以上罚款的治安管理处罚决定或者采取责令停业整顿措施前，应当告知违反治安管理行为人有权要求举行听证；违反治安管理行为人要求听证的，公安机关应当及时依法举行听证。对依照本法第二十三条第二款规定可能执行行政拘留的未成年人，公安机关应当告知未新增听证程序成年人和其监护人有权要求举行听证；未成年人和其监护人要求听证的，公安机关应当及时依法举行听证。对未成年人案件的听证不公开举行。前两款规定以外的案情复杂或者具有重大社会影响的案件，违反治安管理行为人要求听证，公安机关认为必要的，应当及时依法举行听证。公安机关不得因违反治安管理行为人要求听证而加重其处罚"], "shizhan": []}, {"num": "5.20", "title": "公职的丧失", "chapter": "第五章 法律知识", "koujue": ["口诀（75）-1应予辞退的情形：“狂懒变笨傻”"], "defs": ["项目特点应注意问题想辞职而辞不了：①未满最低服务年限；②担任涉密职位或未满原职脱密期限；公务员自己提出，③重要公务尚未处理完毕且须本人继续处理；④正接受审计、纪检、刑事审查辞职后无特殊待遇不想辞而必须辞：①引咎辞职：②责令引咎辞职①“笨”年度考核连续2年不称职（1年不称职仅降1级）；②“傻”不胜任现单位单方面决定，职又不接受其他安排；③“变”因所在单位变动需要调整工作，本人拒绝合理被辞退后按照失业安排；④“狂”不履行义务，不遵守纪律，不适合继续工作又不宜开除的；处理③“懒”连续旷工超15天或1年累计旷工超30天因客观原因丧失职正常退休：达到法定年龄位，可获退休金和提前退休：①工龄满30年；②距规定退休年龄不足5年且工龄满20年；③符合其他待遇规定的其他情况"], "shizhan": [{"q": "国家公务员具有下列情形，应予辞退的是（）", "options": ["王某在年度考核中，三年中有两次被评为不称职", "小张对工作单位不满，平日满腹牢骚，大错不犯，小错不断，但又不符合开除的条件", "李某所在单位因缩减编制名额需要调整工作", "张某休假期满后，无正当理由连续20天没回单位"], "a": 3, "e": "本题考查口诀（75）-1应予辞退的情形：“狂懒变笨傻”。A项不符合辞退条件，考查口中的第一种情况：①“笨”年度考核连续2年不称职才会被辞退。B项也不符合辞退条件，有些考生可能认为属于口诀④“狂”不履行义务，不遵守纪律，不适合继续工作又不宜开除的，在此解释清楚本选项说满腹牢骚，大错不犯，小错不断，并不等于不履行义务，不遵守纪律，不适合继续工作。C项不符合辞退条件，口决第三种情况（③“变”因所在单位变动需要调整工作，本人拒绝合理安排）必须是本人拒绝合理安排才能辞退。D项符合辞退的第五个条件，③“懒”连续旷工超15天或1年累计旷工超30天。因此，选择D选项。"}]}, {"num": "5.21", "title": "公务员错误命令抵抗权", "chapter": "第五章 法律知识", "koujue": ["口诀（75）-2命令有错可抵抗；上级坚持应执行；执行后果上级负；明显违法责自负"], "defs": ["公务员执行公务时，认为上级的决定或命令有错误的，可以向上级提出改正或撤销该命令有错可抵抗决定或者命令的意见上级坚持应执行上级不改变该决定或者命令，或者要求立即执行的，公务员应当执行该决定或者命令执行后果上级负执行的后果由上级负责，公务员不承担责任明显违法责自负公务员执行明显违法的决定或者命令的，应当依法承担相应的责任"], "shizhan": [{"q": "公务员执行公务时，认为上级的决定或者命令有错误的：", "options": ["应当向上级机关提出复议", "应当无条件执行", "应当拒绝执行，但同时应当说明理由", "可以向上级提出改正或者撤销该决定或者命令的意见"], "a": 3, "e": "本题考查口诀（75）-2中的“命令有错可抵抗；上级坚持应执行”。A项错误，行政复议是针对外部行政行为作出的，公务员认为上级的决定或命令有错误的，不能复议，可以向上级提出改正或撤销该决定或者命令的意见。B项明显错误，说法过于绝对。C项错误，不是先拒绝，而是先提出意见。因此，选择D选项。学习资源库：https://www_kdocs.cn/I/cgB4uhRbBYAX"}, {"q": "【单选】公务员在执行公务时，认为上级决定有误且上级机关坚持应执行的情况下，公务员应当（)。", "options": ["拒不执行", "向上级机关反映", "应当执行", "向上级机关提出改正或撤销"], "a": 2, "e": "本题考查口（75）-2中的“上级坚持应执行”，选择C选项。D项向上级机关提出改正或撤销该决定或者命令应在公务员认为上级决定或命令有错误之时，而此题中已说了“上级机关坚持执行”，隐含了公务员已经提出过改正或撤销决定的意见，但上级机关并未接受，上级机关坚持不改变决定或者命令这一条件，故D项不能选。"}]}]}, {"name": "第六章 历史知识", "entries": [{"num": "6.01", "title": "春秋五霸与战国七雄", "chapter": "第六章 历史知识", "koujue": ["口诀（76）春秋五霸：齐桓首霸尊周王，宋襄泓水仁义上。晋文退避智谋广，秦穆拓疆西戎", "强。楚庄问鼎志高昂，五雄争辉春秋扬", "战国七雄：东齐西秦南楚北燕，中间是赵魏韩"], "defs": ["春秋五霸，是指春秋时期五个诸侯之长。", "春秋五霸《史记·索隐》中认为春秋五霸指的是：齐桓公、宋襄公、晋文公、秦穆公、楚庄王齐桓公首倡“尊王夷”，尊奉周王为中原之主，抵御北方游牧民族以及南方齐桓首霸尊周王楚蛮的大举人侵，重用管仲称霸。春秋时齐桓公争霸，屡次与诸侯会盟，其中在鲁公年间的四次，齐国带有军队，被称为“兵车之会”宋襄公以“仁义”为旗，泓水之战坚守礼制。泓水之战中，楚兵强大，宋襄公讲究“仁义”，要待楚兵渡河列阵后再战，结果大败受伤，次年伤重而死，葬于襄陵。宋襄泓水仁义上筑台望母：相传宋襄公因为思念自己的母亲而建筑了一个高台，每到自己的生日、母亲的生日和平时节假日，宋襄公都会登高遥望远方，思念自已的母亲。宋襄公筑台望母的故事在后世流传甚广，渐成佳话", "春秋五霸晋文公城濮之战“退避三舍”，智取中原霸权。公元前632年，楚国和晋国的军队在作战时相遇。晋文公为了实现他许下的诺晋文退避智谋广言，下令军队后退九十里，驻扎在城濮。楚军见晋军后退，以为对方害怕了，马上追击。晋军利用楚军骄傲轻敌的弱点，集中兵力，大破楚军，取得了城濮之战的胜利秦穆公开拓西部疆域，称霸西戎。羊皮换贤：秦穆公以五张黑羊皮从楚国赎回沦为奴隶的百里奚，拜为大夫，称秦穆拓疆西戎强“五毅大夫”。百里奚辅佐穆公改革内政，发展农业，使秦国迅速崛起。体现了秦穆公不拘一格、重视人才的治国理念，成为重视人才的典范楚庄王“问鼎中原”显雄心，郊之战一鸣惊人。公元前606年，楚庄王借伐陆浑之戎（今河南嵩县东北）之机，把楚国大军开至东周首都洛阳南郊，举行盛大的阅兵仪式。即位不久的周定王志志不安，派善于应对的王孙满去慰劳。庄王见了王孙满，劈头就问道：“周天子的鼎有多春秋五霸楚庄问鼎志高昂大？有多重？”言外之意是，要与周天子比权量力。以鼎的多少标明身份，是周王朝的礼乐文化，楚庄王“问鼎中原”，恰是融人以周为正统的华夏文明的证明。从此以后，人们就将企图夺取政权称为“问鼎”战国七雄是战国时期七个最强大的诸侯国的统称（秦国、楚国、齐国、燕国、赵国、魏国、韩战国七雄国），经过春秋时期旷日持久的争霸战争，周王朝境内的诸侯国数量大大减少。在这七雄之中，后期以秦国力量最强。最终秦国灭掉其他六国统一天下。秦国灭掉的最后一个国家是齐国"], "shizhan": [{"q": "战国七雄分别是秦、齐、楚、赵、魏、（）、韩。", "options": ["晋", "鲁", "越", "燕"], "a": 3, "e": "本题可以用口诀（76）战国七雄：东齐西秦南楚北燕，中间是赵魏韩来解答。因此，选择D选项。"}, {"q": "【单选】（)打着“尊王夷”的口号，扩充疆界，成为春秋时期第一个霸主。", "options": ["宋襄公", "秦穆公", "楚庄王", "齐桓公"], "a": 3, "e": "本题可以用口诀（76）春秋五霸：齐桓首霸尊周王来解答。因此，选择D选项。"}]}, {"num": "6.02", "title": "盛世之治", "chapter": "第六章 历史知识", "koujue": ["口诀（77）汉朝文景光武兴，隋朝开皇焕新程，唐朝贞观开元盛，康乾盛世留英名", "【清朝皇帝】努尔哈赤皇顺康，雍乾嘉道咸同光。清朝一共十二帝，最后宣统很悲伤"], "defs": ["盛世所在朝代西汉文景之治：汉文帝、汉景帝汉朝文景光武兴东汉光武中兴：汉光武帝隋朝开皇焕新程隋朝开皇之治：隋文帝唐朝贞观之治：唐太宗唐朝贞观开元盛唐朝开元盛世：唐玄宗清朝康乾盛世：清圣祖（康熙）、清世宗（雍正）、清高宗（乾隆）康乾盛世留英名【清朝皇帝】努尔哈赤皇顺康，雍乾嘉道咸同光。清朝一共十二帝，最后宣统很悲伤"], "shizhan": [{"q": "中国古代出现过多次“治世”局面。下面“治世”局面出现的先后顺序排序正确的是：", "options": ["康乾盛世一文景之治一贞观之治一开元盛世", "开元盛世一康乾盛世一文景之治一贞观之治", "贞观之治一开元盛世一康乾盛世一文景之治", "文景之治一贞观之治一开元盛世一康乾盛世"], "a": 3, "e": "本题可以用口诀（77）汉朝文景光武兴，隋朝开皇焕新程，唐朝贞观开元盛，康乾盛世留英名来解答。因此，选择D选项。"}]}, {"num": "6.03", "title": "古代战争", "chapter": "第六章 历史知识", "koujue": ["口诀（78）涿鹿之战、甘之战：炎黄在涿鹿点燃了战火，甘之战后启建立夏禅让制没落", "鸣条之战、牧野之战：汤在鸣条把夏桀拉下了王座，姬发胜于牧野约了断了自我", "肥水之战：前秦兵将广投鞭能断江，草木的模样吓得心发慌", "长勺之战、城濮之战、桂陵之战、长平之战：曹靠什么，赶走了齐国，城濮之战退避三舍楚", "也打不过，围魏救赵救韩是孙嫔妙计多，长平白起赢下那谈兵的赵括", "巨鹿之战、垓下之战：巨鹿项羽狂豪气冲万丈，人秦的刘邦约法有三章，垓下的月光四面楚歌", "响，别姬的霸王自勿在乌江", "三国战役：汉末分三国，三战三把火，许攸献策焚毁乌巢袁绍气不过，周郎趁着东风把曹船烧", "沉没，陆逊燃起连营七百里的烈火"], "defs": ["距今大约4600年前，人文初祖黄帝部落联合炎帝部落，与蛋尤在涿鹿进行了一场大战，蛋尤战败，炎黄部落取得胜利。涿鹿之战的目的是双方争夺适于放牧和浅耕的中原地带。涿鹿之战对于", "涿鹿之战原地区的基础，并起到了进一步融合各氏族部落的催化作用启在其父禹死后，通过武力排除各反对力量，最终登上华夏部落联盟领袖之位，甘之战是启讨伐甘之战不服他最高领袖地位的有扈氏的战争，最终获胜，启建立中国第一个王朝一夏朝。夏朝（约公元前2070一公元前1600年）是中国史书中记载的第一个世袭制朝代，在春秋战国时期之前夏朝末年（约公元前1600年），在商灭夏的战争中，商汤率领商部落士兵与夏桀的军队在鸣条鸣条之战（今山西省夏县之西）进行的一场决战，商军大败夏军。这场战争成为夏王朝灭亡的转折点。战争的结果导致夏王朝灭亡，商汤建立了中国的第二个王朝一商朝商纣王穷兵武，加剧了社会和阶级矛盾，牧野之战兵败自焚于鹿台，商朝灭亡。牧野之战发生在商朝末年（约公元前1046年），是武王伐的决胜战，战场地点为牧野（今河南牧野之战省新乡）。牧野之战是中国历史上以少胜多、先发制人的著名战例，也是中国古代车战初期的著名战例。周武王姬发率军直捣商都朝歌，在牧野大破商军，商朝军队阵前倒戈。商亡，周武王建立周朝，都城在镐，史称西周。西周采用分封制和井田制长勺之战指春秋时期（公元前684年）齐国与鲁国之间的一场战役，发生于长勺（今山东省莱芜）。长勺之战是历史上著名的以少胜多的战役。齐强鲁弱，齐国兵力远超鲁国。但鲁国在曹刻的", "长勺之战指挥下，采用“一鼓作气，再而衰，三而竭”的策略（等齐军三次击鼓后才反击），以劣势兵力击败齐军公元前632年，晋文公退避三舍，大破楚军，奠定了晋国的霸主地位。晋国为战胜敌人，造成自", "城濮之战已强大的假象，用虎皮蒙马吓晓敌人，让敌军误以为是真老虎冲过来，吓得纷纷后退公元前354年，魏国围攻赵国都城邯郸，田忌、孙滨率军援救。孙引兵攻魏都大梁（今河南省桂陵之战开封），诱使魏将庞涓赶回应战。孙又在桂陵（今河南省长垣）伏袭，大败魏军，生擒庞涓。", "成语：围魏救赵公元前342年，魏国攻打韩国，韩国向齐国求救。齐国派孙滨用“减灶计”诱敌。交战的双方分别是齐国与魏国。马陵之战是设伏歼敌的战例，孙利用庞涓的弱点，制造假象。引诱其就范，", "马陵之战在战局中始终居于主动地位。", "成语：减灶诱敌长平之战是战国时期（公元前260年）秦国名将白起率军在赵国的长平一带同赵国的军队发生的战争。“纸上谈兵”这个典故出自长平之战中的赵括。", "长平之战长平之战是战国历史的最后转折。此战是中国古代军事史上最早、规模最大、最彻底的大型歼灭战公元前207年，项羽在巨鹿与秦军决战，最终以少胜多，大败秦军。成语“破釜沉舟”源于巨鹿巨鹿之战之战。“约法三章”指刘邦入关后公布的临时法规：“杀人者死，伤人及盗抵罪”楚汉相争的最后阶段（公元前202年），刘邦率领的汉军与项羽的楚军在垓下（今安徽省灵璧）展开决战。汉军由刘邦、韩信、彭越等多路军队汇合，总兵力约70万；楚军总兵力约10万，且粮草匮乏、士气低落。汉军采用“十面埋伏”战术，将楚军围困，并以“四面楚歌”瓦解楚军军心。垓下之战项羽率残军突围至乌江，汉军发起战略追击，最终楚军全军覆没，项羽自。此战是中国古代大规模追击战的经典战例，结束了秦末混战的局面，标志着西汉王朝的建立。琵琶曲《十面埋伏》运用音乐手段表现了垓下之战的激烈战况，向世人展现了一幅生动感人的古战场画面官渡之战发生于东汉末年（公元200年），曹军与袁军相持于官渡，袁绍谋士许攸因受猜忌投奔曹官渡之战操，献策指出袁绍军粮囤积于乌巢（今河南省封丘西），且防守薄弱。曹操突袭袁军粮仓，击败袁军主力。曹操以少胜多，大败袁绍，为其统一北方奠定了基础赤壁之战发生在东汉末年（公元208年），曹操南下与孙权、刘备联军在赤壁决战。孙刘联军使用火攻，由周瑜指挥，在长江流域赤壁一带大破曹军。以少胜多，赤壁之战奠定了三国鼎立的基础。赤壁之战赤壁之战是第一次在长江流域进行的大规模江河作战，也是孙、曹、刘各家都派出主力参加的唯一的战事。赤壁之战是三国时期“三大战役”中最为著名的一场。典故：火烧赤壁、草船借箭夷陵之战又称彝陵之战、虢亭之战，是刘备对东吴发动的大规模战役，是中国古代战争史上一次著名的积极防御的成功战例，也是三国“三大战役”的最后一场。刘备称帝三个月后，以替关羽夷陵之战报仇为由，挥兵东吴。孙权求和不成，一面向曹魏求和，避免两线作战，一面派陆逊率军应战。陆逊用以逸待劳的方法，趁蜀军懈怠、防备松邂之时发起反击。他派士兵携带茅草，趁夜突袭蜀军营地，顺风放火。最终打败蜀军。夷陵之战的惨败，是蜀汉继关羽失荆州后又一次实力大损公元383年，前秦皇帝持坚亲自率领九十万大军南下进攻东晋，号称把马鞭丢人江中就能堵塞长江截断水流。东晋仅以八万军力在谢石、谢玄指挥下，奋勇抗击前秦军。坚看到东晋军队阵容严整，又远望八公山，把山上的草木都当成晋军，十分恐惧。两军相遇于耙水。结果，前秦军兵肥水之战败如山倒，高度紧张的前秦士兵听到风声和鹤叫声也疑心是追兵，前秦从此一蹶不振。水之战是以少胜多的一场著名战役。人物：谢玄，荷坚。成语：投鞭断流、风声鹤、草木皆兵"], "shizhan": [{"q": "下列战争与历史人物对应错误的是：", "options": ["垓下之战—刘邦、项羽", "桂陵之战——庞涓、孙滨", "长勺之战一一白起、岳飞", "城濮之战晋文公、楚成王"], "a": 2, "e": "本题可以用口诀（78）长平白起赢下那谈兵的赵括来解答。因此，选择C选项。"}, {"q": "【单选】“四面楚歌”这一典故出自历史上的：", "options": ["马陵之战", "垓下之战", "长平之战", "牧野之战"], "a": 1, "e": "“四面楚歌”最早出自于汉朝司马迁所著的《史记·项羽本纪》。《项羽本纪》记载：“项王军壁垓下，兵少食尽，汉军及诸侯兵围之数重。夜闻汉军四面皆楚歌，项王乃大惊，日：“汉皆已得楚乎？是何楚人之多也。’”“四面楚歌”出自垓下之战。本题可以用口诀（78）该下的月光四面楚歌响，别姬的霸王自刻在乌江来解答。因此，选择B选项。"}]}, {"num": "6.04", "title": "变法和改革", "chapter": "第六章 历史知识", "koujue": ["口诀（79）管仲改革：春秋齐国用管仲，改革相地而衰征", "李变法：李埋变法尽地力，制定法经用平", "洋务运动：十九世纪的洋务，口号自强和求富，曾李左张是人物"], "defs": ["管仲改革李埋是战国初期魏国的改革家，主持了最早的系统性变法之一。李慢变法他主张政治上废止世袭贵族特权，经济上推行“尽地力之教”，实行“平乘法”，率先制定《法经》，以法律的形式肯定和保护变法战国时期，秦孝公任用商鞅进行两次变法，主要内容有废井田，开阡陌，确立土地私有制；商鞅变法奖励军功，按功授爵；户籍什伍制，连坐法。商鞅变法的“分户令”推动了自耕农经济的发展北魏孝文帝改革主要内容有整顿吏治，颁布“均田令”，迁都洛阳，学习汉族文化，与汉族人联姻，等等宋神宗任用王安石进行变法，变法内容有青苗法、免役法（募役法）、农田水利法、方田均", "王安石变法税法、保甲法等。王安石被列宁誉为“中国十一世纪的改革家”明神宗万历年间，张居正改革主张整顿吏治，实行“一条鞭法”，即把各州县的田赋、役张居正改革以及其他杂征总为一条，合并征收银两，按亩折算缴纳。张居正改革的“一条鞭法”意在整顿赋役制度①19世纪60一90年代，洋务派掀起了一场“师夷长技以自强”的洋务运动。前期以“自强”为旗号，后期打出“求富”的旗号。②代表人物：洋务派在中央以恭亲王奕近为代表，在地方以曾国藩、李鸿章、左宗棠、张之洞为代表。【奕】1861年，奕诉会同桂良、文祥上奏《通筹夷务全局酌拟章程六条》，推行以富国强兵为目标的洋务运动。根本目的是维护清王朝的统治。【左宗棠】湘军的重要领导人之一，参与了平定太平天国运动。【李鸿章】李鸿章创办的第一个民用企业是轮船招商局，李鸿章在南京设立的军工企业是金陵机器局。洋务运动③指导思想：中学为体，西学为用。", "④主要内容：A.创建近代海军和训练式海军；B.派遣留学生出国深造；C.兴办新式学堂（京师同文馆是中国近代第一所新式学堂，以培养外语和外交人才为主要目标）；D.创办近代军事工业和民用工业（曾国藩创办安庆内军械厂，李鸿章建江南制造总局，左宗棠创办福州船政局，张之洞创办汉阳兵工厂）。", "影响：开始了中国早期的工业化进程，开辟了近代教育学先河1895年，康有为、梁启超等组织“公车上书”，揭开了戊戌变法的序幕。1898年，光绪皇帝颁布《定国是诏》，宣布开始变法，持续了103天，史称戊戌变法，又称戊戌变法百日维新。1898年9月21日，慈禧太后发动“戊戌政变”，标志着戊戌变法失败。戊戌变法中设立的京师大学堂是中国近代第一所国立大学1905年，孙中山在东京成立中国同盟会。同盟会是中国第一个资产阶级革命政党，以“驱除鞑虏，恢复中华，创立民国，平均地权”为纲领。该纲领后来又被解释为三民主义，即民族、民权、民生，其中民权主义是三民主义的核心。1911年10月10日，武昌起义爆发，辛亥革命开始。", "辛亥革命1912年1月1日，中华民国临时政府在南京宣告成立。孙中山就任中华民国第一任临时大总统。辛亥革命传播了民主共和的理念，在中华大地上建立起亚洲第一个共和制国家，以巨大的震撼力和深刻的影响力推动了中国社会变革，为实现中华民族伟大复兴探索了道路"], "shizhan": [{"q": "春秋战国时期，各国为增强自身实力纷纷进行了变法，不少改革家薪露头角。其中，推行“尽地力之教”，实行“平法”，率先制定《法经》，加强法治的是：", "options": ["吴起变法", "管仲改革", "李变法", "商鞅变法"], "a": 2, "e": "李埋是战国初期魏国的改革家，主持了最早的系统性变法之一。他编纂的《法经》是中国历史上第一部较为完整的成文法典，分为盗、贼、囚、捕、杂、具六篇，奠定了古代中国法治的基础。本题可以用口诀（79）李埋变法尽地力，制定法经用平余来解答。因此，选择C选项。"}, {"q": "【单选】下列属于春秋时期齐国管仲改革的主要内容是：", "options": ["奖励军功", "方田均税法", "相地而衰征", "废除井田制"], "a": 2, "e": "“相地而衰征”是管仲提出的按照土地不同情况分等级征收农业税的财政思想。管仲认为，征收赋税额仅根据土地数量，而不考虑好坏程度、距离远近情况等因素，就会造成赋税负担不合理的状况，从而引起一部分劳动者因赋税负担过重而破产逃亡，甚至进行反叛斗争。本题可以用口诀（79）春秋齐国用管仲，改革相地而衰征来解答。因此，选择C选项。"}]}, {"num": "6.05", "title": "农民起义", "chapter": "第六章 历史知识", "koujue": ["口诀（80）秦朝末期大泽乡，领导陈胜和吴广。元末红巾朱元璋，建立明朝元朝亡。明末李自", "成起义，口号均田和免粮"], "defs": ["陈胜吴广起义又称大泽乡起义，公元前209年，陈胜、吴广在大泽乡发起了我国历史上第一次大规模的农民战争，具有首创精神，“斩木为兵，揭竿为旗”。提出“王侯将相，宁有种乎”的口号。大泽乡起义是我国秦朝末期农民战争的一部分。毛泽东《贺新郎·读史》：“更陈王奋起挥黄铖”中的“陈王”指的是陈胜。", "陈胜吴广起义西汉司马迁《史记·陈涉世家》：①“将军身披坚执锐、伐无道、诛暴秦、复立楚国之社稷，攻宜为王。”②“苟富贵，勿相忘”“燕雀安知鸿之志哉”“天下苦秦久矣，吾闻二世少子也，不当立，当立者乃公子扶苏”西汉末年王莽篡权时发生的农民起义，赤眉军后来与刘演、刘秀起义军会合，成为光", "绿林赤眉起义武中兴的源头东汉初期的光武帝调整了统治政策，使社会出现了“光武中兴”的局面。但东汉后期，豪强地主势力发展，社会黑暗，爆发了黄巾大起义。黄巾起义是我国历史上规模最大的一次带有宗教色彩的起义。东汉末年，巨鹿人张角", "黄巾起义号召百姓起义，纷纷揭竿而起，他们头扎黄巾，高喊“苍天已死，黄天当立，岁在甲子，天下大吉”的口号，史称“黄巾起义”。这次起义给予了东汉沉重打击，促使东汉政权名存实亡瓦岗寨起义又称瓦岗军起义，是隋大业七年（611年）至隋大业十四年（618年）期", "瓦岗寨起义间发生的一场农民起义875年，唐朝爆发黄巢起义，以“天补均平”为口号。黄巢起义后，唐朝的统治已虚", "黄巢起义弱不堪，地方上的藩镇势力又有所发展1351年，元朝征发15万民工修治黄河，韩山童、刘福通趁机在颖州（今安徽省阜阳）发动起义。因消息泄露，韩山童被捕牺牲，刘福通继续领导起义军，以红巾为号，迅速攻占颖州，红巾起义正式爆发。后红巾军内部分裂，朱元璋在众多势力中胜出，红巾起义1368年朱元璋攻占元大都，元朝灭亡，明朝建立。红巾起义虽未直接建立新王朝，但其推翻元朝的历史使命由朱元璋完成了。红巾起义是元末农民起义，是一次农民阶级的反封建斗争，这次农民战争规模之大、历时之久、起义阶段的全面程度是空前的明朝末年，李自成农民军提出“均田免赋”的口号，1644年，攻占北京，明朝灭亡。李自成起义李自成起义提出了“均田免赋”“平买平卖”等口号，在一定程度上推动了历史的进步“反清复明”运动反清复明，是指在清朝统治期间，民间所采取的对抗清朝政权而欲恢复明朝的行为太平天国运动是清朝咸丰元年到同治三年（1851年一1864年）期间，以金田起义为开端，由洪秀全、杨秀清、萧朝贵、冯云山、韦昌辉、石达开等组成的领导集团从广太平天国运动西金田村率先发起的反对清朝封建统治和外国资本主义侵略的农民起义战争，是19世纪中叶中国规模最大的一场反清运动。1864年，随着太平天国都城天京（南京）的陷落，标志着太平天国运动失败"], "shizhan": []}, {"num": "6.06", "title": "不平等条约", "chapter": "第六章 历史知识", "koujue": ["口诀（81）中国沦为半殖民地半封建社会的程度：南京是开始，马关是大大，辛丑是完全"], "defs": ["战争不平等条约主要内容影响①割让香港岛给英国；鸦片战争②赔款2100万银元；中国近代第一个不平等条约，《南京条约》③开放广州、厦门、福州、宁波、上海为中国开始沦为半殖民地半封建（1840—1842年）通商口岸；社会④协定关税①外国公使进驻北京；《天津条约》②外国传教士可到内地传教：使中国丧失了大片的领土和大第二次鸦片战争③外国商船和军舰可在长江各口岸航行量的主权，中国的半殖民地半（1856—1860年）封建化程度进一步加深①增开天津为通商口岸；《北京条约》②割让九龙司地方一区给英国①清政府割辽东半岛、台湾全岛及其附属帝国主义列强对华经济侵略由甲午中日战争各岛屿、澎湖列岛给日本；商品输出转变为以资本输出为（1894—1895年）《马关条约》②赔偿日本军费白银2亿两；主，中国社会的半殖民地半封③开放沙市、重庆、苏州、杭州为通商口岸；建化程度大大加深④允许日本在中国开办工厂八国联军侵华战争①赔款白银本息共计9.8亿多两；清政府沦为帝国主义列强统治《辛丑条约》②北京设“使馆区”，各国驻兵保护；中国的工具，中国完全陷人半（1900—1901年）③设外务部，位于六部之上殖民地半封建社会的深渊"], "shizhan": [{"q": "下列哪个条约的签订，标志中国完全沦为半殖民地半封建社会？", "options": ["天津条约", "南京条约", "马关条约", "辛丑条约"], "a": 3, "e": "本题考查口诀（81）中国沦为半殖民地半封建社会的程度：南京是开始，马关是大大，辛丑是完全。因此，选择D选项。"}]}, {"num": "6.07", "title": "中共党史", "chapter": "第六章 历史知识", "koujue": ["口诀（82）一大是党创立，二大把纲领立，国共合作三大确立，四大听谁滴。陈独秀五大愁，", "六大苏联瞅一瞅，八一南昌第一枪，八七老毛还靠枪。过三湾要靠党，古田那军队要增强，朱毛带", "队上井冈，五次围剿受重创，丢了山头长征慌，遵义会议挽救党。瓦窑一起来抗日，洛川敌后抗日", "忙。开七大毛确立，七届二中快胜利，进入城市离开乡，你说我党棒不棒。八大主矛搞建设，九大", "十大不用讲，十一三中搞开放，重心放到建设上，团结一致向前看，党的历史转折点，实事求是解", "思想，小平精髓记心上。", "六中讲毛主席，功过要分三七，中国特色社会主义，十二大提起，讲经济十三大，一个中心两", "基本，初级阶段路很长，百年努力才富强。邓南方提本质，重申科技生产力，泽民十四建市场，十", "五小平进党章，十六代表奔小康，十七科观人党章，十八的五位放金光，十八三中深化改，市场基", "础改决定，十八四中论法治，两个建设有名堂，十八五中五发展，二孩政策加强党，十八六中五任", "务，财政货币严治党，十九大矛盾变，美丽加入党路线，十九届二中宪法改，全国走进新时代。十", "九届三中机构改，党的领导全覆盖。十九届四中制度好，体系能力少不了。十九届五中四基本，三", "五远景一定稳，十九届六中三决议，百年奋斗创奇迹，二十大中国式现代化，中心任务有变化。", "二十届三中进一步，深化改革稳脚步，两个治理齐跃步，继续完善好制度，高水平市场在三", "五，中叶建成强国图"], "defs": ["会议时间地点内容上海第一个共产主义小组在上海成立；确定党的名称为“中国共产党”；规定中共一大1921年浙江了党的奋斗目标，宣告了中国共产党的正式成立；选举陈独秀为中央局7月嘉兴书记分析了国际形势，制定了党的最高纲领和最低纲领。最高纲领：共产主义。最低纲领：消除内乱，打倒军阀；推翻帝国主义的压迫；中华民族统一为1922年中共二大上海真正的民主共和国。7月指出了中国革命要分两步走，在中国近代史上第一次提出了彻底的反帝反封建的民主革命纲领（消除内乱，打倒军阀，建设国内和平）。中国共产党第一个党章在中共二大上诞生确定国共合作，决定全体共产党员以个人名义加人国民党，以建立各民主中共三大1923年广州阶级的统一战线，同时保持共产党在组织上、政治上的独立性，为第一次6月国共合作打下政治基础国共第一1924年广州会上确定了“联俄、联共、扶助农工”新三民主义。国民党一大的召开，次合作标志着第一次国共合作的正式形成会议时间地点内容1925年大会着重讨论了无产阶级在民族革命运动中的地位，提出无产阶级在民主", "中共四大上海1月革命中的领导权问题和工农联盟问题1927年批评了陈独秀的右倾错误，并决定党的重大方针政策。实际上没有解决任中共五大4月汉口何问题1927年南昌起义打响了武装反抗国民党统治的第一枪：", "南昌起义南昌8月1日领导者：周恩来、贺龙、叶挺、朱德、刘伯承八七会议总结了失败教训，纠正了陈独秀右倾投降主义错误，确定了土地1927年革命和武装反抗国民党反动派统治的总方针，并把发动农民举行秋收起义八七会议8月7日汉口作为当前党的主要任务。毛泽东提出政权是从枪杆子中取得的。瞿秋白开始担任领导工作三湾改编1927年9月三湾提出党对军队绝对领导秋收起义1927年湖南秋收起义创立了第一个农村革命根据地井冈山革命根据地9月9日1928年明确规定了没收一切土地，确定了依靠贫雇农、联合中农的阶级路线，对中共六大6月莫斯科富农的政策也有调整，但没有根本解决福建古田会议1929年确立了共产党对红军的绝对领导古田会议时间地点内容结束了王明“左”倾冒险主义在党中央的统治，开始确立了以毛泽东1935年为代表的新的中央的正确领导；是中国共产党第一次独立自主地运用", "遵义会议遵义1月马克思列宁主义原理解决中国革命问题；是中国共产党从幼年走向成熟的标志1935年陕北批判了党内长期存在着的“左”倾关门主义，决定建立最广泛的抗日民族", "瓦窑堡会议12月瓦窑堡统一战线制定全面抗战路线，通过了《关于目前形势与党的任务的决定》和《抗日1937年洛川会议洛川救国十大纲领》。会议决定把党的工作重心放在战区和敌后，开辟敌后战8月场，建立敌后抗日根据地①毛泽东作《论联合政府》的政治报告，提出我党的三大作风：理论联系1945年中共七大延安实际、密切联系群众、批评与自我批评。（这是区别其他政党的标志）。4月②确立了毛泽东思想为党的指导思想七届二中1949年西柏坡工作重心由农村转移到城市；首次提出加强执政党建设。提出“两个务必”全会3月①分析了国内形势和主要矛盾的变化，指出我国国内的主要矛盾是人民对中共八大1956年北京经济文化迅速发展的需求同当前经济文化不能满足人民需要的状况之间的矛盾。②大会肯定陈云提出的“三个主体，三个补充”思想会议时间地点内容邓小平：《解放思想，实事求是，团结一致向前看》，重新确立了解放思想、实事求是的原则；作出了把党的工作重点转移到社会主义现代化建设十一届1978年北京上来的战略决策；提出了改革开放的重要思想。改革开放是党和人民事业三中全会12月大踏步赶上时代的重要法宝。十一届三中全会是划时代的，开启了改革开放和社会主义现代化建设新时期1982年邓小平提出走自已的道路，建设有中国特色社会主义。它标志着建设有中中共十二大9月北京国特色社会主义思想的正式确立系统地阐述了关于社会主义初级阶段的理论：①已经进人社会主义初级阶中共十三大1987年北京段；②长期处于社会主义初级阶段。10月党在社会主义初级阶段的基本路线：一个中心：经济建设（核心）；两个基本点：四项基本原则（立国之本）、改革开放（强国之路）会议时间地点内容①坚持党的“一个中心、两个基本点”的基本路线，一百年不动摇；②不要纠缠于姓“资”还是姓“社”的问题讨论。改革开放的判断标准主要看是否有利于发展社会主义社会的生产力，是否有利于增强社会主义国家的综合国力，是否有利于提高人民的生活水平。现在要警惕“右”，但南方谈话1992年主要是防止“左”。计划和市场不是社会主义和资本主义的本质区别；③发展才是硬道理，重申了科技是第一生产力；坚持两手抓，两手都要硬；③社会主义本质理论：社会主义的本质是解放生产力，发展生产力，消灭剥削，消灭两极分化，最终达到共同富裕1992年中共十四大北京确定我国经济体制改革的目标是建立社会主义市场经济体制10月①依法治国，建设社会主义法治国家，是党领导人民治理国家的基本方略，1997年完整地提出和论述了党在社会主义初级阶段的基本纲领；中共十五大9月北京②非公有制经济是我国社会主义市场经济的重要组成部分；③把邓小平理论确立为中国共产党的指导思想并载人党章2002年高举邓小平理论伟大旗帜，全面贯彻“三个代表”重要思想，继往开来，中共十六大北京11月与时俱进，提出全面建设小康社会的奋斗目标会议时间地点内容①高举中国特色社会主义伟大旗帜，以邓小平理论和“三个代表”重要思想为指导，深人贯彻落实科学发展观，继续解放思想，坚持改革开放，推中共十七大2007年北京动科学发展，促进社会和谐，为夺取全面建设小康社会新胜利而奋斗；②把反腐倡廉建设作为党建重要内容与思想建设、组织建设、作风建设、制度建设并列居民收人增长和经济发展同步；劳动报酬的增长和劳动生产两个同步率提高同步双翻番国内生产总值和城乡居民人均收入比2010年翻一番2012年三个自信全党要坚定：道路自信、理论自信、制度自信。（文化自信）中共十八大北京11月三清反腐干部清正、政府清廉、政治清明四个意识忧患意识、创新意识、宗旨意识、使命意识四种监督党内监督、民主监督、法律监督和奥论监督五位一体经济、政治、文化、社会、生态文明建设会议时间地点内容坚持人民主体地位；坚持解放和发展生产力坚持推进改革开放；坚持维护社会公平正义八个坚持坚持走共同富裕道路；坚持促进社会和谐坚持和平发展；坚持党的领导改革不走坚定不移高举中国特色社会主义伟大旗帜“两条路”既不走封闭僵化的老路、也不走改旗易帜的邪路2012年中共十八大11月北京新四化坚持走中国特色新型工业化、信息化、城镇化、农业现代化道路强化经济体制改革的核心问题是处理好政府和市场的关系国有经济反腐败与十八大报告将反腐败提高到“亡党亡国”的高度政治清明生态文明十八大报告首次专章论述生态文明，首次提出“推进绿色发与美丽中国展、循环发展、低碳发展”和“建设美丽中国”①主题：全面深化改革；②总目标：完善和发展中国特色社会主义制度，推进国家治理体系和治理能力现代化；③方向：社会主义市场经济；④出十八届2013年发点落脚点：增进人民福让、促进社会公平正义；③重点：经济体制改革，北京核心：处理好政府和市场的关系；③总依据：社会主义初级阶段；②总任三中全会11月务：实现社会主义现代化和中华民族的伟大复兴；十八届三中全会也是划时代的，开启了新时代全面深化改革、系统整体设计推进改革新征程，开创了我国改革开放全新局面会议时间地点内容《中共中央关于全面推进依法治国若干重大问题的决定》十八届2014年总目标：建设中国特色社会主义法治体系，建设社会主义法治国家。四中全会11月北京党的领导是中国特色社会主义最本质的特征，是社会主义法治最根本的保证“十三五”时期，经济保持中高速增长，年均经济增速为6.5%；十八届2015年五个发展：实现创新发展、协调发展、绿色发展、开放发展、共享发展；北京五中全会11月二孩政策;加强党建和反腐①十八届六中全会的一个主题、两个板块：一个主题：全面从严治党；两个板块：严肃党内政治生活、加强党内监督。十八届2016年②十八届六中全会将继续实施积极的财政政策和稳健的货币政策。北京六中全会10月③十八届六中全会将全面落实“去产能、去库存、去杠杆、降成本、补短板”供给侧改革五大重点任务，抑制资产泡沫，房市调控有望分化。④去产能和去杠杆的关键是深化国有企业和金融部门的基础性改革，行政和市场手段相结合去产能会议时间地点内容主题：不忘初心，牢记使命，高举中国特色社会主义伟大旗帜，决胜全面建成小康社会，夺取新时代中国特色社会主义伟大胜利，为实现中华民族伟大复兴的中国梦不懈奋斗。主要矛盾：中国特色社会主义进入新时代，我国社会主要矛盾已经转化为人民日益增长的美好生活需要和不平衡不充分的发展之间的矛盾。基本路线：领导和团结全国各族人民，以经济建设为中心，坚持四项基本2017年中共十九大北京原则，坚持改革开放，自力更生，艰苦创业，为把我国建设成为富强民主10月文明和谐美丽的社会主义现代化强国而奋斗。两个阶段：第一个阶段，从二O二O○年到二O三五年，在全面建成小康社会的基础上，再奋斗十五年，基本实现社会主义现代化。第二个阶段，从二O三五年到本世纪中叶，在基本实现现代化的基础上，再奋斗十五年，把我国建成富强民主文明和谐美丽的社会主义现代化强国。中国共产党人的初心和使命：为中国人民谋幸福，为中华民族谋复兴①宪法是国家的根本法，是治国安邦的总章程，是党和人民意志的集中体现。依法治国首先是依宪治国。十九届2018年②坚持习近平新时代中国特色社会主义思想。北京二中全会1月③坚持和加强党对一切工作的领导。中国共产党领导是中国特色社会主义最本质的特征，是中国特色社会主义制度最大的优势，必须坚持和加强党对一切工作的领导会议时间地点内容④五位一体、新发展理念和奋斗目标。经济建设、政治建设、文化建设、社会建设、生态文明建设“五位一体”总体布局，创新、协调、绿色、开十九届2018年放、共享的新发展理念，到2020年全面建成小康社会、到2035年基本实北京二中全会1月现社会主义现代化、到本世纪中叶建成社会主义现代化强国的奋斗目标，实现中华民族伟大复兴。③构建人类命运共同体①审议通过了《中共中央关于深化党和国家机构改革的决定》和《深化党和国家机构改革方案》。②指导思想：马克思列宁主义、毛泽东思想、邓小平理论、“三个代表”重要思想、科学发展观、习近平新时代中国特色社会主义思想为指导。③党领导一切：不忘初心、牢记使命，全面加强党对一切工作的领导。十九届2018年北京总基调：稳中求进。三中全会2月③总体布局：五位一体。③战略布局：四个全面。②深化党和国家机构改革的重要保障：机构编制法定化。③深化党和国家机构改革的首要任务：完善坚持党的全面领导的制度，加强党对各领域各方面工作领导，确保党的领导全覆盖，确保党的领导更加坚强有力会议时间地点内容十九届2019年审议《中共中央关于坚持和完善中国特色社会主义制度、推进国家治理体北京四中全会10月系和治理能力现代化若干重大问题的决定》2020年10月29日，中国共产党第十九届中央委员会第五次全体会议通过《中国共产党第十九届中央委员会第五次全体会议公报》。全会提出了到二○三五年基本实现社会主义现代化远景目标，这就是：1.基本实现新型工业化、信息化、城镇化、农业现代化，建成现代化经济体系；十九届2020年2.基本实现国家治理体系和治理能力现代化，人民平等参与、平等发展权北京五中全会10月利得到充分保障；3.基本建成法治国家、法治政府、法治社会；4.建成文化强国、教育强国、人才强国、体育强国、健康中国，国民素质和社会文明程度达到新高度，国家文化软实力显著增强；广泛形成绿色生产生活方式，碳排放达峰后稳中有降，生态环境根本好转，美丽中国建设目标基本实现通过《关于党的百年奋斗重大成就和历史经验的决议》十九届2021年对比记忆：《关于建国以来党的若干历史问题的决议》1981年6月27日中六中全会11月北京国共产党十一届六中全会通过对比记忆：《关于若干历史问题的决议》会议时间地点内容中国式现代化，是中国共产党领导的社会主义现代化，既有各国现代化的共同特征，更有基于自已国情的中国特色。中国式现代化是人口规模巨大的现代化，是全体人民共同富裕的现代化，是物质文明和精神文明相协调中共二十大2022年北京的现代化，是人与自然和谐共生的现代化，是走和平发展道路的现代化。10月从现在起，中国共产党的中心任务就是团结带领全国各族人民全面建成社会主义现代化强国、实现第二个百年奋斗目标，以中国式现代化全面推进中华民族伟大复兴审议通过了《中共中央关于进一步全面深化改革推进中国式现代化的决定》。进一步全面深化改革的总目标是继续完善和发展中国特色社会主义制度，推进国家治理体系和治理能力现代化。到二O三五年，全面建成高水平社会主义市场经济体制，中国特色社会主义制度更加完善，基本实现国家治理体系和治理能力现代化，基本实现社会主义现代化，为到本世纪中叶全面建成社会主义现代化强国奠定坚实基础。二十届2024年“七个聚焦”：北京①聚焦构建高水平社会主义市场经济体制；三中全会7月②聚焦发展全过程人民民主；③聚焦建设社会主义文化强国；④聚焦提高人民生活品质；③聚焦建设美丽中国；③聚焦建设更高水平平安中国；②聚焦提高党的领导水平和长期执政能力，继续把改革推向前进。到二○二九年中华人民共和国成立八十周年时，完成本决定提出的改革任务"], "shizhan": [{"q": "进一步全面深化改革的总目标是继续完善和发展中国特色社会主义制度，推进：", "options": ["社会主义现代化强国建设", "中华民族伟大复兴", "全面建设社会主义现代化国家", "国家治理体系和治理能力现代化"], "a": 3, "e": "本题可以用口诀（82）二十届三中进一步，深化改革稳脚步，两个治理齐跃步，继续完善好制度，高水平市场在三五，中叶建成强国图来解答。因此，选择D选项。"}]}]}, {"name": "第七章 管理知识", "entries": [{"num": "7.01", "title": "管理职能 VS 政府职能", "chapter": "第七章 管理知识", "koujue": ["口诀（83）管理职能记4条，控制织计和领导，计划职能是首要"], "defs": ["组织职能：政府机构和工作人员把制订的计划方案付诸实施的活动过程计划职能：计划职能属于决策性职能。决策是管理的核心。计划职能是对未来活动进行的预先筹划和安排，它包括确定组织的目标、制定实现目标的策略和方案以及分配资源等。计划职能是管理活动的首要职能。管理职能例：不打无准备之仗领导职能：管理者通过激励、指导、沟通、协调冲突等方式影响组织成员。领导职能是实现管理效率和效果的灵魂，是管理过程的核心环节控制职能：保证组织各部门各环节能按预定要求运作而实现组织目标政治职能（最核心）：包括军事保卫职能、外交职能、治安职能、民主政治建设职能。例：钓鱼岛巡航护渔经济职能：主要是利用经济杠杆进行调节。包括宏观调控职能、提供公共物品和服务职能、市场监管职能。例：提高个人所得税专项附加扣除标准文化职能：包括发展科学技术、教育、文化事业和卫生体育的职能。政府职能例：某市政府加强体育公园、健身步道等基础设施建设，完善“15分钟健身圈”，构建“处处可健身”的高品质运动空间社会职能：包括调节社会分配和组织社会保障职能；保护生态环境和自然资源职能；促进例：某省深入实施全民参保计划，针对新业态从业人员、农民工等重点群体特点，分类施策、精准扩面；政府积极推动医疗事业改革，健全大病救助体系，完善社会保障体系；开展老年人居家适老化改造；建设无烟示范社区；实施汽车国六排放标准"], "shizhan": [{"q": "管理职能中，首要的职能是：", "options": ["计划", "组织", "领导", "控制"], "a": 0, "e": "本题可以用口诀（83）管理职能记4条，控制织计和领导，计划职能是首要来解答。因此，选择A选项。"}]}, {"num": "7.02", "title": "管理层次VS 管理幅度", "chapter": "第七章 管理知识", "koujue": ["口诀（84）层次与规模成正比，层次与幅度成反比。扁平解决人臃肿，锥形影响积极性"], "defs": ["项目管理层次组织规模管理层次与组织规模成正比：组织规模越大，包含的成员越多，则层次越多管理层次与管理幅度成反比：在组织规模已定的条件下，主管直接控制的下属越多，管理层次越管理幅度少，相反，管理幅度减小，则管理层次增加。例：管理的事务越难越多，越不规范，则要求管理幅度越小", "项目管理层次扁平结构指通过减少行政管理层次，裁减穴余人员，从而建立一种紧凑、干练的组织结构。美国管理学家德鲁克认为，“组织不良常见的病症，也就是最严重的病症，便是管理层次太多”。扁平化管理可以较好地解决这种“病症”，即减少管理层次，形成一条最短的指挥链。①优点：能够提高管理效率，减少管理失误，降低管理费用，扩大管理幅度。扁平组织分权程度高，几乎每个成员都有一定的决定权，在分权程度比较高的组织，组织成员更加自由，分权有利于下级因地制宜贯彻上级指示，充分发挥自已的聪明才干。②缺点：由于管理幅度较宽，权力分散，不易实施严密控制，加重了对下属组织及人员进行协调扁平结构的负担总经理部门经理部门经理部门经理员工员工员工员工管理层次多，管理幅度小。①优点：管理严密、分工明确、易于协调。", "锥形结构②缺点：管理人员多，易造成“官多兵少”；协调工作会大量增加；有可能会出现职能交叉，推扯皮的现象；等级森严，影响下属积极性"], "shizhan": [{"q": "下列有关管理幅度与层次相适应的原则说法不正确的是：", "options": ["在管理对象和内容不变的情况下，管理幅度和层次成反比", "管理幅度同管理者的能力及管理手段的先进程度成正比", "管理幅度与事务的难易程度成反比", "管理层次与组织效率成正比"], "a": 3, "e": "A项：管理幅度是指一个管理者能够直接管理的下属数量。如果管理幅度增大，即管理者能够直接管理更多的下属，那么管理层次就会减少；反之，如果管理幅度减小，管理层次就会增加。因此，管理幅度和层次成反比。本选项也可以用口诀（84）层次与规模成正比，层次与幅度成反比来确定。A项正确。B项：管理者的能力越强，管理手段越先进，能够有效管理的下属数量就越多，管理幅度也就越大。例如，使用先进的信息技术和管理工具，管理者可以更高效地监督和指导下属的工作。B项正确。C项：事务越复杂、难度越大，管理者需要投入的时间和精力就越多，能够有效管理的下属数量就会减少，管理幅度也就越小。例如，处理复杂的项目任务时，管理者需要更细致地指导和监督，因此管理幅度会缩小。C项正确。D项：管理层次与组织效率成反比。管理层次过多会导致信息传递的延迟和失真，增加管理成本，降低组织效率。一般来说，管理层次越少，信息传递越高效，组织效率越高。D项错误。因此，选择D选项。"}]}, {"num": "7.03", "title": "行政监督体系", "chapter": "第七章 管理知识", "koujue": ["口诀（85）内部监督：内部第一道防线，直接迅速审一般，一般监督种类三，日常职能和主管", "外部监督：外部监督二道线，有力有效的监管，监党立法和社会，司法检察院法院"], "defs": ["类型地位分类和常考案例①日常监督。例：行政机关上下级之间的监督②职能监督。一般监督例：财政部对各部委预算工作的监督第一道防线，最直内部行政监督接、最迅速③主管监督。例：上级政府的工作部门对下级政府相应的工作部门的监管，市财政局对县财政局的监督专门监督审计监督，即政府自我监督。例：审计署对财政资金管理的监督立法监督人大及其常委会审议政府工作报告监察监督监察委员会开展反腐败工作检察院、法院及司法行政机关等，通过行政诉讼、刑司法监督事诉讼程序监督等方式，对行政机关履职过程实施制约第二道防线政党监督党的纪律检查委员会处理党员违纪外部行政监督最有力、最有效①社会团体监督。例：中国福利会对国家机关的监督。社会监督②公民监督。例：公民向有关部门提出批评、建议。③社会舆论监督。例：新闻媒体曝光行政人员失职行为"], "shizhan": [{"q": "（)是行政监督体系的第一道防线，也是最直接、最迅速的监督。", "options": ["内部监督", "立法监督", "司法监督", "社会监督"], "a": 0, "e": "本题可以用口诀（85）内部监督：内部第一道防线，直接迅速审一般，一般监督种类三，日常职能和主管来解答。因此，选择A选项。"}, {"q": "【单选】行政监督中最有力的、最有效的一道防线是：", "options": ["外部行政监督", "内部行政监督", "审计监督", "一般监督"], "a": 0, "e": "本题可以用口诀（85）外部监督：外部监督二道线，有力有效的监管，监党立法和社会，司法检察院法院来解答。因此，选择A选项。"}]}, {"num": "7.04", "title": "心理效应", "chapter": "第七章 管理知识", "koujue": ["口诀（86）晕轮效应：晕轮即光环，常以偏概全，一丑遮百面，爱屋连乌篇", "首因效应：首因初印象，先人定交往，新官三把火，恶人先告状", "门槛效应：门槛步步登，得寸再进尺，小求先应下，大求顺然至", "棘轮效应：棘轮单向前，考察消费观，由俭人奢易，由奢入俭难", "蝴蝶效应：蝴蝶翅膀扇，微变引巨澜。一发动全身，小动撼大千", "马太效应：马太效应强弱分，富者越富穷越贫，两极分化显分明"], "defs": ["晕轮效应也叫光环效应，是在人际交往中，人身上表现出的某一方面特征，掩盖了其他特征，从而造成人际认知的障碍。晕轮效应的最大弊端就在于以偏概全。", "晕轮效应例：爱屋及乌；情人眼里出西施；一白遮百丑；某位私垫先生见一学生相貌丑陋，觉得他一定没什么才气，因此对他的态度十分冷淡首因效应是美国心理学家洛钦斯首先提出的，也叫首次效应、优先效应或第一印象效应，指交往双方形成的第一次印象对今后交往关系的影响，也是“先人为主”带来的效果。", "首因效应例：“新官上任三把火”“早来晚走”“恶人先告状”“先发制人”“下马威”等，都是想利用首因效应占得先机近因效应是指最新出现的刺激物促使印象形成的心理效果。1957年，由美国心理学家卢琴斯根据", "近因效应决定因素是后来新出现的刺激物。例如，介绍一个人，前面先讲他的优点，接着“但是”，讲了许多缺点，那么后面的话对印象形成产生的效果就属于近因效应羊群效应也称从众效应，指当个体受到群体的影响，会怀疑并改变自已的观点、判断和行为，朝", "羊群效应着与群体大多数人一致的方向变化。就是通常人们所说的“随大流”，人云亦云刻板效应也叫定型效应，人们用印刻在自已头脑中的关于某人、某一类人的固定印象，来作为判", "刻板效应断和评价人的依据的现象破窗效应指的是一个房子如果窗户破了，没有人去修补，隔不久，其他的窗户也会莫名其妙地被", "破窗效应人打破。这里体现的是一种从众心理马蝇效应是指再懒情的马，只要身上有马蝇叮咬，它也会精神抖，飞快奔跑。因此，有压力才", "马蝇效应有动力鸟笼效应是指一个人买了一个空鸟笼放在家里，随后很有可能会因为用这只笼子而再买一只鸟。", "鸟笼效应因此，人们常常会成为物品的“俘虏”鲶鱼效应，原是指鲶鱼在搅动小鱼生存环境的同时，也激活了小鱼的求生能力。从人才开发的角度来看，“鲶鱼效应”是企业管理者激发员工活力的有效措施，具体是指组织管理部门通过引进优鲶鱼效应秀人才以激活原有员工的活力，产生一石激起千层浪的激荡效果。例：机关单位实行的公开招考和竞争上岗，能够使人产生危机感从而更好地工作，体现了鲶鱼效应的原理“木桶效应”又称“木桶原理”“短板理论”，是由美国管理学家彼得提出的经典理论，其核心思木桶效应想可概括为：一只木桶能装多少水，不取决于最长的那块木板，而取决于最短的那块木板。因此，在一个团队中，我们应该把最弱的成员剔除门槛效应即登门槛效应，又称得寸进尺效应，指一个人一旦接受了他人的一个微不足道的要求，为了避免认知上的不协调，或想给他人以前后一致的印象，就有可能接受更大的要求。这种现象，", "门槛效应犹如登门坎时要一级台阶一级台阶地登，这样能更容易更顺利地登上高处。“得寸进尺”是典型的门槛效应马太效应是社会学家和经济学家们常用的术语，反映了两极分化的社会现象，即“富的更富，穷", "马太效应的更穷”运用到管理实践中，就是领导者如果要搞好工作，应该与下属保持亲密关系，但这是“亲密有间”的关系，是一种不远不近的恰当合作关系棘轮效应指人们在消费时的一种习惯。当工资收入达到某个水平后，此时的消费习惯，如爱消费棘轮效应高档次的衣服和食品，会稳定在某一个水平；而当工资再一次提高时，消费习惯可能会上调，但是不会随着收入的降低而减低自已的消费水平。例：由俭入奢易，由奢人俭难霍桑效应指当被观察者知道自已被关注、被观察或者被注意到而改变行为倾向的反应，经常被用来暗示被试者可能由于受到研究者的关注而改善他们的行为表现，且这种改善并非源于对自变量", "霍桑效应的操纵。霍桑效应是根据实验地点命名的，霍桑工厂实验表明，工人由于被挑选出来参与试验，感到被关注和重视，而表现出工作效率提高青蛙效应是指如果将一只青蛙放进沸水中，它会跳出来，但如果将它放进冷水中慢慢加热，青蛙会因为察觉不到危险而被煮死。青蛙效应告诉人们，企业竞争环境的改变大多是渐热式的，如果", "青蛙效应管理者与员工对环境之变化没有疼痛的感觉，最后就会像这只青蛙一样，被煮熟、淘汰了仍不知道挤出效应是政府为了平衡财政预算赤字，采取发行政府债券的方式，向私人借贷资金市场筹措资", "挤出效应金，从而使市场利率上升，私人投资和支出因而相应地下降边际效应边际效应指随着消费量的增加，每增加一单位商品或服务的效用递减投射效应是指将自已的特点归因到其他人身上的倾向。在认知和对他人形成印象时，以为他人也投射效应具备与自已相似的特性的现象，把自已的感情、意志、特性投射到他人身上并强加于人，即推已及人的认知障碍蝴蝶效应指一个微小的初始事件可能引发一系列连锁反应，最终导致重大变化。", "蝴蝶效应例：“牵一发而动全身”经济学上的隧道效应是指由于市场结构和行为导致的资源配置失灵现象。在这种情况下，市场参", "隧道效应与者因信息不对称和利益冲突等原因，无法有效配置资源，最终导致经济效率下降"], "shizhan": [{"q": "司马光《训俭示康》：“由俭人奢易，由奢入俭难。”这体现的是经济学中的：", "options": ["棘轮效应", "羊群效应", "挤出效应", "隧道效应"], "a": 0, "e": "本题可以用口诀（86）棘轮效应：棘轮单向前，考察消费观，由俭入奢易，由奢入俭难来解答。因此，选择A选项。"}, {"q": "【单选】下列常见管理学效应与词语对应不正确的一项是：", "options": ["羊群效应——随声附和", "晕轮效应—以偏概全", "马太效应——得寸进尺", "蝴蝶效应——牵一发而动全身"], "a": 2, "e": "A项：羊群效应指个体在决策时倾向于模仿多数人的行为或跟随主流意见，缺乏独立思考。“随声附和”意为别人说什么就跟着说什么，符合羊群效应的特征。A项对应正确。B项：晕轮效应指基于某个方面的突出印象（如外貌、能力）来整体评价一个人或事物，忽略其他方面。“以偏概全”意为用局部或片面的看法来概括整体，与晕轮效应一致。B项对应正确。也可以用口诀（86）晕轮效应：晕轮即光环，常以偏概全，一丑遮百面，爱屋连乌篇来确定B项。C项：马太效应源自《圣经》，指“强者愈强、弱者愈弱”的现象，即资源、优势或成功会累积，导致不平等加剧。“得寸进尺”意为得到一点好处就想得到更多，形容贪心不足或步步进逼的行为，与马太效应的核心含义不符。“得寸进尺”更接近心理学中的“登门槛效应”。C项对应不正确。也可以用口诀（86）马太效应：马太效应强弱分，富者越富穷越贫，两极分化显分明。门槛效应：门槛步步登，得寸再进尺，小求先应下，大求顺然至来确定C项。D项：蝴蝶效应指一个微小的初始事件可能引发一系列连锁反应，最终导致重大变化。“牵一发而动全身”意为拉动一根头发就牵动整个身体，比喻小部分的变化会影响全局，与蝴蝶效应一致。D项对应正确。也可以用口诀（86）蝴蝶效应：蝴蝶翅膀扇，微变引巨澜。一发动全身，小动撼大千来确定D项。因此，选择C选项。"}]}]}, {"name": "第八章 公文知识", "entries": [{"num": "8.01", "title": "公文要素", "chapter": "第八章 公文知识", "koujue": ["口诀（87）左上一行是份号，密级二行左上角，密期隔开用星号，秘密机密和绝密，十年二十", "三十年，保密期限不可少"], "defs": ["版头份号、密级和保密期限、紧急程度、发文机关标志、发文字号、签发人公文主体标题、主送机关、正文、附件说明、发文机关署名、成文日期、印章、附注、附件18要素版记抄送机关、印发机关和印发日期页码公文印制份数的顺序编号。涉密公文应当标注份号。份号顶格编排在版心左上角第一行，一般份号使用6位3号阿拉伯数字，不足的用0补齐密级和限一般为30年；机密级公文的保密期限不超过20年；秘密级公文的保密期限不超过10年。密保密期限级和保密期限一般用3号黑体字，顶格编排在版心左上角第二行。格式为“密级★保密期限”（如“秘密★1年”）。但通知、通报、公告、通告没有涉密程度紧急公文应当分别标注“特急”“加急”，电报应当分别标注“特提”“特急”“加急”“平急”。紧急程度如需标注紧急程度，一般用3号黑体字，顶格编排在版心左上角。如需同时标注份号、密级和保密期限、紧急程度，按照份号、密级和保密期限、紧急程度的顺序自上而下分行排列由发文机关全称或者规范化简称加“文件”二字组成，也可以使用发文机关全称或者规范化简称。联合行文时，发文机关标志可以并用联合发文机关名称，也可以单独用主办机关名称。", "发文机关发文机关标志居中排布，上边缘至版心上边缘为35mm。联合行文时，如需同时标注联署发文机标志关名称，一般应当将主办机关名称排列在前；如有“文件”二字，应当置于发文机关名称右侧，以联署发文机关名称为准上下居中排布由发文机关代字、年份、发文顺序号组成。联合行文时，使用主办机关的发文字号。编排在发文机关标志下空二行位置，居中排布。年份、发文顺序号用阿拉伯数字标注；年份应标全称，用六角括号“【】”括人；发文顺序号不加“第”字，不编虚位（即1不编为01），发文字号在阿拉伯数字后加“号”字。例如，“国发【2025】1号”，要注意机关代字、年份、序号不能颠倒。引用文件时文件名在前，用“《》”括人，发文字号在后，使用“（）”括人。例如，《关于分上行文应当标注签发人姓名。由“签发人”三字加全角冒号和签发人姓名组成，居右空一字，编排在发文机关标志下空二行", "签发人如有多个签发人，签发人姓名按照发文机关的排列顺序从左到右、自上而下依次均匀编排，一般每行排两个姓名，回行时与上一行第一个签发人姓名对齐标题=发文机关+关于+事由+的+文种。发文机关和事由可省略。唯一不能省略文种。（注意“关于”与“的”位置，“关于”不能在发文机关前面。如“关于国务院发布《国家行政机关公标题文处理办法》的通知”格式错误，“关于”应位于“国务院”之后。“的”后面一定是文种，如“×xx的情况报告”格式错误，“情况报告”不是文种，应为“×xx情况的报告”）标题一般用2号小标宋体字，编排于红色分隔线下空二行位置，分一行或多行居中排布公文的主要受理机关，应当使用机关全称、规范化简称或者同类型机关统称。", "主送机关编排于标题下空一行，居左顶格，回行时仍顶格，最后一个主送机关名称后标全角冒号正文一般由三部分组成：缘由+事项+结尾。正文正文一般用3号仿宋体字，编排于主送机关名称下一行，每个自然段左空二字，回行顶格。文“（）”“，“（一）”“一，公文附件的顺序号和名称。公文如有附件，在正文下空一行左空二字编排“附件”二字，后标全角冒号和附件名称。如有多个附件，使用阿拉伯数字标注附件顺序号（如“附件：1．×x××附件说明×”）；附件名称后不加标点符号。附件名称较长需回行时，应当与上一行附件名称的首字对齐。附件说明处的标题应与附件本身的标题相一致。“附件说明”中仅需要写明附件标题名称，无须书名号，只有一个附件时也无须标注“1”", "发文机关署发文机关全称或者规范化简称", "署名署会议通过或者发文机关负责人签发的日期。联合行文时，署最后签发机关负责人签发的日期。成文日期成文日期中的数字用阿拉伯数字将年、月、日标全，年份应标全称，月、日不编虚位（即1不编为01)印章公文中有发文机关署名的，应当加盖发文机关印章，并与署名机关相符。有特定发文机关标志的普发性公文和电报可以不加盖印章公文印发传达范围等需要说明的事项，如公文的发放范围、政府信息公开方式、联系人和联系附注电话等。如有附注，用3号仿宋体字，居左空二字加圆括号编排在成文日期下一行。“请示”件应在附注处注明联系人和电话附件是公文正文的说明、补充或者参考资料。附件应当另面编排，并在版记之前，与公文正文一起装订。“附件”二字及附件顺序号用3号黑体字顶格编排在版心左上角第一行。附件标题居中编排在版心第三行。附件顺序号和附件标题应当与附件说明的表述一致。附件格式要求同附件正文。如附件与正文不能一起装订，应当在附件左上角第一行顶格编排公文的发文字号并在其后标注“附件”二字及附件顺序号除主送机关外需要执行或者知晓公文内容的其他机关，应当使用机关全称、规范化简称或者同类型机关统称。抄送机关如有抄送机关，一般用4号仿宋体字，在印发机关和印发日期之上一行、左右各空一字编排。“抄送”二字后加全角冒号和抄送机关名称，回行时与冒号后的首字对齐，最后一个抄送机关名称后标句号公文的送印机关和送印日期。编排在末条分隔线之上，印发机关左空一字，印发日期右空一字，", "印发机关和用阿拉伯数字将年、月、日标全，年份应标全称，月、日不编虚位（即1不编为01），后加印发日期“印发”二字页码是公文页数顺序号。根据《党政机关公文格式》，页码是公文的一个独立格式要素，不归属传统“版头一主体一版记”分类里的某一部分。页码的作用是为公文分页编排顺序、方便查阅。", "页码页码编排在公文版心下边缘之下，单页码居右空一字，双页码居左空一字。公文的版记页前有空白页的，空白页和版记页均不编排页码。公文的附件与正文一起装订时，页码应当连续编排"], "shizhan": [{"q": "【多选】关于公文的密级和保密期限，下列说法错误的有：", "options": ["绝密级公文的保密期限不超过30年", "机密级公文的保密期限不超过10年", "密级和保密期限应顶格编排在版心左上角第一行", "密级和保密期限之间可使用“★”号隔开"], "a": "BC", "e": "A项：根据《党政机关公文处理工作条例》及相关规定，绝密级公文保密期限一般为30年。A项正确。B项：机密级公文的保密期限不超过20年；秘密级公文的保密期限不超过10年。B项错误。C项：密级和保密期限应顶格编排在版心左上角第二行；版心左上角第一行编排的是公文的份号（如“000001”）。C项错误。D项：密级和保密期限之间可使用“★”号隔开（如“绝密★30年”），是公文格式的规范要求。D项正确。本题考查口诀（87）左上一行是份号，密级二行左上角，密期隔开用星号，秘密机密和绝密，十年二十三十年，保密期限不可少。因此，选择BC选项。"}]}, {"num": "8.02", "title": "公文种类", "chapter": "第八章 公文知识", "koujue": ["口诀（88）公文种类：两决两公三个通，令议报请批复中，意见纪要还有函，十五公文都来", "全，公报决议是新添"], "defs": ["公文种类决议、决定、公报、公告、通知、通报、通告、命令（令）、议案、报告、请示、批复、意见、15种函、纪要决议。适用于会议讨论通过的重大决策事项决定。适用于对重要事项作出决策和部署、奖惩有关单位和人员、变更或者撤销下级机关不适当的决定事项命令（令）。适用于公布行政法规和规章、宣布施行重大强制性措施、批准授予和晋升衔级、嘉奖有关单位和", "人员公报。适用于公布重要决定或者重大事项公告。适用于向国内外宣布重要事项或者法定事项通告。适用于在一定范围内公布应当遵守或者周知的事项意见。适用于对重要问题提出见解和处理办法通知。适用于发布、传达要求下级机关执行和有关单位周知或者执行的事项，批转、转发公文通报。适用于表彰先进、批评错误、传达重要精神和告知重要情况报告。适用于向上级机关汇报工作、反映情况，回复上级机关的询问请示。适用于向上级请求指示、批准批复。适用于答复下级机关请示事项。议案。适用于各级人民政府按照法律程序向同级人民代表大会或者人民代表大会常务委员会提请审议事项函。适用于不相隶属机关之间商洽工作、询问和答复间题、请求批准和答复审批事项纪要。适用于记载会议主要情况和议定事项注意：2012年《党政机关公文处理工作条例》增加了决议和公报，明确法定公文为15种。这一调整更适应党政机关工作协同的需要，也使公文体系更加规范完整"], "shizhan": [{"q": "【多选】下列属于正式公文文种的有：", "options": ["报告", "条例", "议案", "公报"], "a": "ACD", "e": "本题考查口诀（88）公文种类：两决两公三个通，令议报请批复中，意见纪要还有函，十五公文都来全，公报决议是新添。因此，选择ACD选项。"}]}]}]};
