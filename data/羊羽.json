{"meta":{"version":1,"createdAt":1789725743658},"settings":{"mode":"cumulative","dailyReset":false,"timerGoalMin":25,"quizMode":"practice"},"profile":{"avatar":"","signature":""},"countdown":{"exams":[{"id":"gk","name":"国考","date":"2026-11-30","color":"#34e7e4"},{"id":"gd","name":"广东省考","date":"2026-12-06","color":"#ff5cf0"},{"id":"sy","name":"事业编联考","date":"2027-03-15","color":"#ffd166"}]},"timer":{"sessions":{"2026-09-18":1},"subjectSessions":{"2026-09-18":{"常识":1}},"counts":{}},"timerGoal":{},"accuracyCumulative":{"常识":{"correct":3,"total":5}},"studyPlan":{"言语":60,"资料":60,"逻辑":45,"政治":45,"数量":45,"常识":30,"申论":30},"todos":{"common":[{"id":"mu6srwb7i578v","type":"quiz-wrong","text":"常识错题 2 道（待复盘）","done":false,"day":"2026-09-18","createdAt":1789726208083}],"wrongbook":[{"id":"mu6t1zicgrq3z","text":"常识判断错题复习（2题）","done":false,"day":"2026-09-18","subject":"常识","type":"wrong-review"}],"current":[]},"formulas":{"data":[],"quantity":[]},"politics":{"questions":[],"lastGen":null},"mutiHistory":[],"common":{"questions":[],"kpDaily":{"date":null,"ids":[]},"kpDeck":{"seed":0,"ptr":20,"round":1}},"verbalDef":{"seed":0,"ptr":0,"round":1},"wrongwords":[],"idiomReview":{},"politicsReview":{},"learnedLog":{"common_kp":{"2026-09-18":["kp-0539","kp-0120","kp-0691","kp-0434","kp-0516","kp-0317","kp-0333","kp-0405","kp-0339","kp-0148"],"2026-09-19":["kp-0013","kp-0377","kp-0242","kp-0200","kp-0642","kp-0415","kp-0382","kp-0833","kp-0094","kp-0030"]}},"commonModules":{"geo":[],"law":[],"eco":[],"tech":[],"pol":[]},"commonHistory":{},"essay":{"xiaoti":{"done":0,"total":0},"dagongwen":{"done":0,"total":0},"quotes":[],"quoteDaily":{"date":null,"seed":0,"picks":[],"done":[]},"essaysEdit":{}},"calendar":{"2026-09-18":{"start":"","end":"","checked":true},"2026-09-19":{"start":"","end":"","checked":true}},"checkin":{"lastDate":"2026-09-19","dates":["2026-09-18","2026-09-19"]},"quotesLib":[],"wrongbook":{"常识":[{"id":"mu6srwb6wf1nm","q":"日常生活中，人们通常把鱼出现上浮并翻肚子称为“翻塘”，该情形极易导致鱼死亡，那么，若无污染、沼气等影响，在一天中，鱼儿最容易因缺氧而“翻塘”的时间是（）。","options":["晚上","下午","早晨","上午"],"a":2,"ua":0,"date":"2026-09-18","e":".【A】本题考查科技常识。影响水体溶氧最主要的几个因素中，首先是温度，水温升高，水体的细菌、藻类、鱼类和其它水生动物活动加强，水中的溶氧就会降低；水温越高，水中溶氧的饱和度就越低。一天之中，池塘中的溶氧也是动态变化的。白天光照强，通过光合作用产生较多的氧气溶解于水中，中、上层水的溶解氧在自然状态下开始上升，在中午过后逐渐达到最高值，溶解氧甚至能达到过饱和状态。到了夜晚，由于没有了光合作用，而池塘内对氧气的消耗量并没有明显减少，使得水体的溶解氧含量逐渐减少，一天之中黎明和清晨的温度最低，所以一天中，早晨池塘中的氧最少。因此早晨最容易出现鱼儿最容易因缺氧而“翻塘”。故正确答案为A。","optInfo":null,"note":"","img":""},{"id":"mu6srwb71wliq","q":"关于天体及其运行，下列表述错误的是：","options":["黄道面是指月球绕地球运行的轨道面","在火星和木星轨道之间存在一个小行星带","天球是为了确定天体位置和运动而假想的圆球"],"a":0,"ua":1,"date":"2026-09-18","e":".【C】A项正确，天文学等领域中，天球是一个想象的旋转的球，理论上具有无限大的半径，与地球同心。天空中所有的物体都想象成是在天球上。与地球相对应，它有天赤道，天极。B项正确，在火星和木星轨道之间存在小行星带，位于火星和木星轨道之间的小行星密集区域，估计此地带存在50万颗小行星。关于形成原因，比较普遍的观点是太阳系形成初期，由于某种原因，火星与木星之间空当地带未能积聚形成一颗大行星，结果留下了大批小行星。C项错误，黄道面就是地球绕日旋转轨道所在的平面，所指的是地球，并不是指月球。D项正确，星座是指在道家占星学上，天上一或器具联系起来，称之为“星座”。本题为选非题，故正确答案为C。","optInfo":null,"note":"","img":""}]},"favorites":{"常识":[],"言语":[],"资料":[],"逻辑":[],"政治":[],"数量":[],"申论":[]},"notes":{},"reviews":{"verbal":{}},"lastResetDay":"2026-09-23","dailyPlan":{"2026-09-18":{"items":[{"module":"常识","type":"quiz","text":"常识刷题 5 题 · 正确率 60%","meta":{"text":"常识刷题 5 题 · 正确率 60%","pct":60,"count":5},"id":"mu6srwb8137em","done":false,"createdAt":1789726208084}],"note":""}},"taskTimer":{"task":"","startTs":0,"accumulated":0,"running":false,"planId":null,"targetMs":0,"laps":[],"subject":""},"customQuestions":{},"currentAffairs":[],"hotspotsEdits":{},"pdfBooks":[],"hotspotsImports":[{"title":"更多资讯请下载学习强国客户端","body":"“学习强国”学习平台","date":"2026-09-18","source":"article.xuexi.cn","region":"全国","url":"https://article.xuexi.cn/articles/index.html?art_id=1046131923011603031&source=share&study_style_id=feeds_default&to_audit_timestamp=2026-09-18+08%3A30%3A38&reco_id=103b8323832ec0a88662000x&study_share_enable=1&study_comment_disable=0&share_to=copylink&ptype=0&item_id=1046131923011603031","imgs":[],"id":"imp_mu6u0i7h7qr4"}],"eb":{},"attachments":{},"accuracy":[{"date":"2026-09-18","subject":"常识","pct":